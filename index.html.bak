<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title>Sistema Veteranos 5º BE Cmb Bld - Batalhão Juarez Távora</title>
  
  <!-- Configurações PWA: Aplicativo para Celular & Computador -->
  <link rel="manifest" href="manifest.json">
  <meta name="theme-color" content="#0a110b">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Veteranos 5º BE">
  <link rel="apple-touch-icon" href="icon-192.png">
  <link rel="icon" type="image/png" sizes="192x192" href="icon-192.png">
  <link rel="icon" type="image/png" sizes="512x512" href="icon-512.png">
  <link rel="icon" type="image/png" href="logo_veteranos.png">
  <script src="pwa.js" defer></script>

  <!-- Tailwind CSS & FontAwesome -->
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Inter', sans-serif;
      background-color: #0a110b;
      color: #e2e8f0;
      min-height: 100vh;
    }
    .military-font {
      font-family: 'Rajdhani', sans-serif;
      letter-spacing: 0.5px;
    }
    .tactical-card {
      background-color: #111d13;
      border: 1px solid #233b26;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
    }
    .tactical-border-glow:hover {
      border-color: #d4af37;
      box-shadow: 0 0 15px rgba(212, 175, 55, 0.25);
    }
    .gold-gradient {
      background: linear-gradient(135deg, #fff2a3 0%, #d4af37 50%, #997300 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .custom-scroll::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    .custom-scroll::-webkit-scrollbar-track {
      background: #0d170f;
    }
    .custom-scroll::-webkit-scrollbar-thumb {
      background: #2a472d;
      border-radius: 4px;
    }
    .custom-scroll::-webkit-scrollbar-thumb:hover {
      background: #d4af37;
    }
    .badge-oficial {
      background: linear-gradient(135deg, #451a03 0%, #78350f 100%);
      border: 1px solid #b45309;
      color: #fef3c7;
    }
    .badge-sgt {
      background: linear-gradient(135deg, #0f2537 0%, #1e3a5f 100%);
      border: 1px solid #3b82f6;
      color: #dbeafe;
    }
    .badge-praca {
      background: linear-gradient(135deg, #162a1a 0%, #203b25 100%);
      border: 1px solid #22c55e;
      color: #dcfce7;
    }
  </style>
</head>
<body class="flex flex-col min-h-screen">

  <!-- BARRA SUPERIOR MILITAR -->
  <header class="bg-[#0e190f] border-b border-[#254228] sticky top-0 z-30 shadow-xl">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2.5 flex flex-wrap items-center justify-between gap-3 sm:gap-4">
      
      <!-- Lado Esquerdo Superior: Logo Loja Evolução Militar + Identificação 5º BE -->
      <div class="flex items-center space-x-3 sm:space-x-4">
        
        <!-- Logo Loja Evolução Militar com Link Externo -->
        <a href="https://www.evolucaomilitar.com.br" target="_blank" rel="noopener noreferrer"
           title="Loja Oficial Evolução Militar • Acesse: www.evolucaomilitar.com.br"
           class="group inline-flex flex-col items-center justify-center bg-[#060c07] hover:bg-black border border-[#2b4c2f] hover:border-amber-400/80 rounded-lg px-1.5 py-0.5 sm:px-2 sm:py-1 transition-all shadow-sm flex-shrink-0 text-center">
          <video src="logo_evolucao_militar.mp4" poster="logo_evolucao_militar.jpg" autoplay loop muted playsinline class="h-11 sm:h-14 w-auto object-contain transition-transform group-hover:scale-105 rounded pointer-events-none">
            <img src="logo_evolucao_militar.jpg" alt="Loja Evolução Militar" class="h-11 sm:h-14 w-auto object-contain">
          </video>
          <span class="text-[9px] sm:text-[10px] font-black uppercase military-font text-amber-400 group-hover:text-amber-300 tracking-wider leading-none mt-0.5 flex items-center">
            ACESSE A LOJA <i class="fa-solid fa-arrow-up-right-from-square ml-1 text-[7px] text-amber-500"></i>
          </span>
        </a>

        <!-- Divisor Tático Vertical -->
        <div class="h-10 sm:h-12 w-px bg-[#254228] hidden sm:block"></div>

        <!-- Logo e Identificação 5º BE -->
        <div class="flex items-center space-x-3 sm:space-x-3.5">
          <div class="h-14 sm:h-16 w-auto flex-shrink-0 drop-shadow-[0_2px_12px_rgba(212,175,55,0.4)] cursor-pointer hover:scale-105 transition-transform" onclick="trocarAbaPrincipal('integrantes')">
            <img src="logo_veteranos.png" alt="Veteranos 5º BE Cmb Bld" class="h-full w-auto object-contain">
          </div>
          <div>
            <div class="flex items-center space-x-2">
              <span class="px-2 py-0.5 bg-amber-950/60 border border-amber-600/50 rounded text-[10px] font-bold text-amber-400 military-font tracking-widest uppercase">
                BATALHÃO JUAREZ TÁVORA
              </span>
            </div>
            <h1 class="military-font leading-tight mt-0.5">
              <span class="text-xl sm:text-2xl font-black gold-gradient uppercase tracking-wider block">
                VETERANOS
              </span>
              <span class="text-[10px] sm:text-xs text-emerald-400 font-bold uppercase tracking-wider military-font block">
                DO 5º BATALHÃO DE ENGENHARIA DE COMBATE BLINDADO
              </span>
            </h1>
          </div>
        </div>

      </div>

      <!-- Navegação Pública (Padrão: Apenas Inscrição & Mural da Cia) -->
      <!-- NavegaÃ§Ã£o PÃºblica (PadrÃ£o: InscriÃ§Ã£o, Reservar Feijoada & Ãrea Admin) -->
      <!-- NavegaÃ§Ã£o PÃºblica (PadrÃ£o: InscriÃ§Ã£o, Reservar Feijoada & Ãrea Admin) -->
      <nav id="navPublico" class="flex flex-wrap items-center gap-2">
        <button onclick="trocarAbaPrincipal('inscricao')" id="nav-btn-inscricao-pub"
                class="px-3.5 py-2 rounded-lg text-xs sm:text-sm font-bold military-font uppercase transition-all bg-emerald-700 hover:bg-emerald-600 text-white shadow flex items-center">
          <i class="fa-solid fa-id-card mr-2 text-amber-400"></i> InscriÃ§Ã£o de Veterano
        </button>
        <a href="eventos.html"
           class="px-3.5 py-2 rounded-lg text-xs sm:text-sm font-bold military-font uppercase transition-all bg-[#122315] hover:bg-[#1b3620] text-amber-300 border border-amber-500/50 flex items-center shadow">
          <i class="fa-solid fa-utensils mr-2 text-amber-400"></i> Reservar Feijoada dos Veteranos
        </a>
        <button onclick="abrirModalAdmin()"
                title="Acesso Exclusivo da Diretoria e Administradores com Senha"
                class="px-3.5 py-2 rounded-lg text-xs sm:text-sm font-extrabold military-font uppercase transition-all bg-amber-600/30 hover:bg-amber-600/50 text-amber-300 border-2 border-amber-500 hover:border-amber-400 flex items-center shadow-lg transform active:scale-95">
          <i class="fa-solid fa-lock mr-2 text-amber-400"></i> Ãrea Admin
        </button>
      </nav>

      <!-- Navegação Administrativa (Liberada para o Administrador) -->
      <nav id="navAdmin" class="hidden flex items-center space-x-1 sm:space-x-2 bg-[#09110a] p-1.5 rounded-lg border border-[#1f3722]">
        <button id="nav-btn-integrantes" onclick="trocarAbaPrincipal('integrantes')"
                class="px-3 py-2 rounded-md text-xs font-bold military-font uppercase transition-all bg-emerald-700 text-white shadow">
          <i class="fa-solid fa-users-viewfinder mr-1"></i> Integrantes
        </button>
        <button id="nav-btn-eventos" onclick="trocarAbaPrincipal('eventos')"
                class="px-3 py-2 rounded-md text-xs font-bold military-font uppercase transition-all text-slate-300 hover:text-white hover:bg-[#1a2f1d]">
          <i class="fa-solid fa-utensils mr-1 text-amber-400"></i> Relatório da Feijoada
        </button>
        <button id="nav-btn-mensagens" onclick="trocarAbaPrincipal('mensagens')"
                class="px-3 py-2 rounded-md text-xs font-bold military-font uppercase transition-all text-slate-300 hover:text-white hover:bg-[#1a2f1d]">
          <i class="fa-brands fa-whatsapp mr-1 text-green-400"></i> Mensagens
        </button>
        <button id="nav-btn-link" onclick="trocarAbaPrincipal('link')"
                class="px-3 py-2 rounded-md text-xs font-bold military-font uppercase transition-all text-slate-300 hover:text-white hover:bg-[#1a2f1d]">
          <i class="fa-solid fa-link mr-1 text-amber-400"></i> Links & Reencontro
        </button>
        <button id="nav-btn-exportar" onclick="trocarAbaPrincipal('exportar')"
                class="px-3 py-2 rounded-md text-xs font-bold military-font uppercase transition-all text-slate-300 hover:text-white hover:bg-[#1a2f1d]">
          <i class="fa-solid fa-file-arrow-down mr-1 text-blue-400"></i> Exportar Cia
        </button>
        <button id="nav-btn-inscricao" onclick="trocarAbaPrincipal('inscricao')"
                class="px-3 py-2 rounded-md text-xs font-bold military-font uppercase transition-all text-slate-300 hover:text-white hover:bg-[#1a2f1d]">
          <i class="fa-solid fa-user-plus mr-1 text-purple-400"></i> Inscrição (Mural)
        </button>
      </nav>

      <!-- Botão Instalar App (PWA para Celular & Computador) -->
      <div class="flex items-center space-x-2">
        <button onclick="acionarInstalacaoApp()" 
                title="Instalar Aplicativo no seu Celular ou Computador"
                class="btn-instalar-app px-3.5 py-2 bg-gradient-to-r from-emerald-600 via-emerald-500 to-green-600 hover:from-emerald-500 hover:to-green-500 text-slate-950 font-extrabold rounded-lg text-xs military-font uppercase flex items-center shadow-lg transition-all transform active:scale-95">
          <i class="fa-solid fa-mobile-screen-button mr-1.5 text-sm"></i>
          <span>Instalar App</span>
        </button>
      </div>

    </div>
  </header>

  <!-- CONTEÚDO PRINCIPAL -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">

    <!-- SEÇÃO PÚBLICA PADRÃO: INSCRIÇÃO & MURAL DA COMPANHIA -->
    <section id="aba-inscricao" class="space-y-6">
      
      <!-- Banner Tático de Boas-Vindas -->
      <div class="tactical-card rounded-2xl p-6 sm:p-8 border-l-4 border-l-amber-500 relative overflow-hidden">
        <div class="flex flex-col md:flex-row items-center gap-6">
          <div class="h-28 sm:h-36 w-auto flex-shrink-0 drop-shadow-[0_4px_24px_rgba(212,175,55,0.4)]">
            <img src="logo_veteranos.png" alt="Veteranos 5º BE Cmb Bld" class="h-full w-auto object-contain filter drop-shadow hover:scale-105 transition-transform duration-300">
          </div>
          <div class="flex-1 text-center md:text-left">
            <div class="inline-flex items-center space-x-2 px-3 py-1 bg-amber-950/60 border border-amber-600/50 rounded-full text-xs font-bold text-amber-400 military-font tracking-widest uppercase mb-2">
              <i class="fa-solid fa-id-card"></i> Inscrição Oficial & Reencontro
            </div>
            <h2 class="military-font leading-tight">
              <span class="text-2xl sm:text-4xl font-black gold-gradient uppercase tracking-wider block">
                VETERANOS
              </span>
              <span class="text-sm sm:text-base text-emerald-400 font-extrabold uppercase tracking-wide military-font block mt-0.5">
                DO 5º BATALHÃO DE ENGENHARIA DE COMBATE BLINDADO
              </span>
            </h2>
            <p class="text-xs text-amber-300 font-bold uppercase tracking-wider military-font mt-1">
              Batalhão Juarez Távora
            </p>
            <p class="text-xs sm:text-sm text-slate-300 mt-2 leading-relaxed">
              Faça sua inscrição ou atualização de cadastro no formulário abaixo. 
              <strong class="text-amber-300 font-semibold">A partir do momento em que você concluir seu cadastro, a relação de soldados da sua Companhia será liberada na mesma hora</strong> com o nome e o ano em que serviram!
            </p>
            <p class="text-[11px] text-slate-400 mt-1">
              <i class="fa-solid fa-shield-halved text-emerald-400 mr-1"></i> Por segurança, os telefones de contato ficam restritos e só o Administrador pode liberar.
            </p>
          </div>
        </div>
      </div>

      <!-- FORMULÁRIO DE INSCRIÇÃO -->
      <div class="tactical-card rounded-xl p-6 sm:p-8 border border-[#264429] relative overflow-hidden">
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-emerald-600 via-amber-400 to-emerald-600"></div>

        <div class="mb-6 pb-4 border-b border-[#243c27]">
          <h3 class="text-xl font-bold military-font text-white flex items-center">
            <i class="fa-solid fa-pen-to-square text-amber-400 mr-2"></i>
            Ficha de Inscrição / Atualização de Cadastro
          </h3>
          <p class="text-xs text-slate-400 mt-1">
            Preencha seus dados para entrar no efetivo oficial e desbloquear os soldados da sua Companhia.
          </p>
        </div>

        <!-- PAINEL DE STATUS: VETERANO JÁ IDENTIFICADO / CADASTRADO -->
        <div id="painelVeteranoCadastradoPub" class="hidden mb-6 p-4 sm:p-5 bg-gradient-to-r from-[#132717] via-[#1a3821] to-[#132717] rounded-xl border-2 border-emerald-500 shadow-xl">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div class="flex items-center space-x-3.5">
              <div class="w-12 h-12 rounded-full bg-emerald-500/20 border-2 border-emerald-400 text-emerald-300 flex items-center justify-center text-xl shrink-0 shadow-md">
                <i class="fa-solid fa-id-card-clip"></i>
              </div>
              <div>
                <div class="flex flex-wrap items-center gap-2">
                  <span class="px-2 py-0.5 bg-amber-500 text-slate-950 font-black rounded text-[10px] uppercase military-font tracking-wider">CADASTRO ATIVO</span>
                  <span class="px-2 py-0.5 bg-emerald-950 text-emerald-300 border border-emerald-600/50 rounded text-[10px] font-bold font-mono flex items-center">
                    <i class="fa-solid fa-lock-open text-amber-400 mr-1"></i> LISTA SEMPRE LIBERADA NESTE DISPOSITIVO
                  </span>
                </div>
                <h3 id="txtBoasVindasVeteranoPub" class="text-base sm:text-lg font-black text-white military-font mt-1">
                  Olá, Veterano!
                </h3>
                <p id="txtSubBoasVindasPub" class="text-xs text-slate-300 font-medium">
                  Companhia: <strong class="text-amber-300" id="txtCiaVeteranoCadastradoPub">--</strong> • Turma: <strong class="text-amber-300" id="txtAnoVeteranoCadastradoPub">--</strong>
                </p>
              </div>
            </div>
            <div class="flex flex-wrap items-center gap-2">
              <button type="button" onclick="rolarParaListaCompanhiaPub()" 
                      class="px-3.5 py-2 bg-gradient-to-r from-emerald-600 to-green-600 hover:from-emerald-500 hover:to-green-500 text-slate-950 font-black rounded-lg text-xs military-font uppercase flex items-center shadow-md">
                <i class="fa-solid fa-users mr-1.5"></i> Ver Caserna / Soldados
              </button>
              <button type="button" onclick="alternarFormularioAtualizacaoPub()" 
                      class="px-3 py-2 bg-[#0c160e] hover:bg-[#152718] text-amber-300 border border-amber-500/40 font-bold rounded-lg text-xs military-font uppercase flex items-center transition-all">
                <i class="fa-solid fa-pen-to-square mr-1.5 text-amber-400"></i> <span id="txtBtnToggleFormPub">Atualizar Meus Dados</span>
              </button>
            </div>
          </div>
          <div class="mt-3 pt-2.5 border-t border-emerald-900/60 flex flex-col sm:flex-row sm:items-center justify-between gap-1 text-[11px] text-slate-400">
            <span><i class="fa-solid fa-circle-check text-emerald-400 mr-1"></i> A lista da sua Companhia permanece desbloqueada permanentemente neste dispositivo.</span>
            <button type="button" onclick="desvincularCadastroDispositivoPub()" class="text-slate-400 hover:text-red-400 underline text-left sm:text-right transition-colors" title="Limpar cadastro salvo apenas deste navegador">
              Trocar de Militar
            </button>
          </div>
        </div>

        <form id="formInscricaoPublica" onsubmit="salvarInscricaoPublica(event)" class="space-y-4">
          
          <!-- Alerta de Identificação Automática ao Digitar Nome -->
          <div id="avisoAutoPreenchimentoPub" class="hidden p-3 bg-emerald-950/80 border border-emerald-500/60 rounded-lg text-emerald-200 text-xs flex flex-col sm:flex-row sm:items-center justify-between gap-2 shadow">
            <div class="flex items-center space-x-2">
              <i class="fa-solid fa-circle-check text-amber-400 text-base shrink-0"></i>
              <span id="txtAvisoAutoPreenchimentoPub">
                <strong>Cadastro localizado no efetivo!</strong> Informações preenchidas automaticamente.
              </span>
            </div>
            <span class="text-[10px] font-mono px-2 py-0.5 bg-amber-500/20 text-amber-300 border border-amber-500/40 rounded font-bold uppercase shrink-0">DADOS CARREGADOS</span>
          </div>

          <!-- Nome Completo & Nome de Guerra -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="sm:col-span-2">
              <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">
                Nome Completo <span class="text-red-400">*</span>
              </label>
              <input type="text" id="pubNomeCompleto" required placeholder="Ex: João da Silva Silveira"
                     oninput="autoPreencherCadastroPublico(this)"
                     class="w-full px-3 py-2.5 rounded-lg bg-[#0c160e] border border-[#2b472f] text-slate-100 text-sm focus:outline-none focus:border-amber-400">
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">
                Nome de Guerra <span class="text-red-400">*</span>
              </label>
              <input type="text" id="pubNomeGuerra" required placeholder="Ex: SILVA"
                     oninput="autoPreencherCadastroPublico(this)"
                     class="w-full px-3 py-2.5 rounded-lg bg-[#0c160e] border border-[#2b472f] text-slate-100 text-sm uppercase focus:outline-none focus:border-amber-400">
            </div>
          </div>

          <!-- Posto/Graduação, Companhia & Ano que Serviu -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
              <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">
                Posto / Graduação <span class="text-red-400">*</span>
              </label>
              <select id="pubGraduacao" required class="w-full px-3 py-2.5 rounded-lg bg-[#0c160e] border border-[#2b472f] text-slate-100 text-sm focus:outline-none focus:border-amber-400">
                <option value="Sd" selected>Soldado (Sd)</option>
                <option value="Cb">Cabo (Cb)</option>
                <option value="3º Sgt">3º Sargento</option>
                <option value="2º Sgt">2º Sargento</option>
                <option value="1º Sgt">1º Sargento</option>
                <option value="Sgt">Sargento (Sgt)</option>
                <option value="Sub Ten">Subtenente</option>
                <option value="Asp">Aspirante</option>
                <option value="Ten">Tenente (Ten)</option>
                <option value="Cap">Capitão (Cap)</option>
                <option value="Maj">Major (Maj)</option>
                <option value="Ten Cel">Tenente-Coronel</option>
                <option value="Cel">Coronel (Cel)</option>
                <option value="Gen">General (Gen)</option>
              </select>
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">
                Companhia em que Serviu <span class="text-red-400">*</span>
              </label>
              <select id="pubCompanhia" required class="w-full px-3 py-2.5 rounded-lg bg-[#0c160e] border border-[#2b472f] text-amber-300 font-bold text-sm focus:outline-none focus:border-amber-400">
                <option value="1º Cia Eng Cmb Bld">1ª Cia Eng Cmb Bld — 🦁 Leão</option>
                <option value="2º Cia Eng Cmb Bld">2ª Cia Eng Cmb Bld — 🐆 Onça</option>
                <option value="Cia Cmdo e Ap - (CCAp)">Cia Cmdo e Apoio (CCAp) — 🐾 Pantera</option>
                <option value="Cia Eng Pnt (CEP)">Cia Eng Pontes (CEP) — 🦅 Águia</option>
                <option value="Estado Maior Geral e Especial">Estado-Maior Geral e Especial</option>
                <option value="NPOR">NPOR</option>
              </select>
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">
                Ano que Serviu (Incorporação) <span class="text-red-400">*</span>
              </label>
              <input type="number" id="pubAno" min="1940" max="2030" placeholder="Ex: 1985" required
                     class="w-full px-3 py-2.5 rounded-lg bg-[#0c160e] border border-[#2b472f] text-slate-100 text-sm font-mono focus:outline-none focus:border-amber-400">
            </div>
          </div>

          <!-- WhatsApp, Cidade e Estado -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
              <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">
                WhatsApp / Celular <span class="text-red-400">*</span>
              </label>
              <input type="tel" id="pubWhatsApp" required placeholder="(42) 99999-9999" oninput="mascaraTelefonePublico(this)"
                     class="w-full px-3 py-2.5 rounded-lg bg-[#0c160e] border border-[#2b472f] text-emerald-400 font-mono text-sm focus:outline-none focus:border-amber-400">
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">
                Cidade Onde Mora <span class="text-red-400">*</span>
              </label>
              <input type="text" id="pubCidade" required placeholder="Ex: Porto União"
                     class="w-full px-3 py-2.5 rounded-lg bg-[#0c160e] border border-[#2b472f] text-slate-100 text-sm focus:outline-none focus:border-amber-400">
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">
                Estado (UF) <span class="text-red-400">*</span>
              </label>
              <select id="pubEstado" required class="w-full px-3 py-2.5 rounded-lg bg-[#0c160e] border border-[#2b472f] text-slate-100 text-sm focus:outline-none focus:border-amber-400">
                <option value="Santa Catarina" selected>Santa Catarina (SC)</option>
                <option value="Paraná">Paraná (PR)</option>
                <option value="Rio Grande do Sul">Rio Grande do Sul (RS)</option>
                <option value="São Paulo">São Paulo (SP)</option>
                <option value="Distrito Federal">Distrito Federal (DF)</option>
                <option value="Rio de Janeiro">Rio de Janeiro (RJ)</option>
                <option value="Minas Gerais">Minas Gerais (MG)</option>
                <option value="Mato Grosso do Sul">Mato Grosso do Sul (MS)</option>
                <option value="Mato Grosso">Mato Grosso (MT)</option>
                <option value="Outro">Outro Estado</option>
              </select>
            </div>
          </div>

          <!-- Bairro e Rua (Opcionais) -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
              <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">
                Bairro (Opcional)
              </label>
              <input type="text" id="pubBairro" placeholder="Ex: Centro"
                     class="w-full px-3 py-2.5 rounded-lg bg-[#0c160e] border border-[#2b472f] text-slate-100 text-sm focus:outline-none focus:border-amber-400">
            </div>
            <div class="sm:col-span-2">
              <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">
                Rua e Número (Opcional)
              </label>
              <input type="text" id="pubRua" placeholder="Ex: Av. Coronel Amazonas, 120"
                     class="w-full px-3 py-2.5 rounded-lg bg-[#0c160e] border border-[#2b472f] text-slate-100 text-sm focus:outline-none focus:border-amber-400">
            </div>
          </div>

          <!-- Botão de Finalização -->
          <div class="pt-2">
            <button type="submit" 
                    class="w-full py-4 px-4 bg-gradient-to-r from-emerald-600 via-emerald-500 to-green-600 hover:from-emerald-500 hover:to-green-500 text-slate-950 font-extrabold rounded-xl military-font tracking-wider text-base uppercase shadow-lg shadow-emerald-950/60 flex items-center justify-center transition-all transform active:scale-95">
              <i class="fa-solid fa-unlock-keyhole mr-2 text-lg"></i>
              Concluir Inscrição e Liberar Lista da Companhia
            </button>
          </div>

        </form>

        <!-- Mensagem de Confirmação Pós-Inscrição -->
        <div id="boxSucessoInscricao" class="hidden mt-6 p-5 bg-emerald-950/80 border border-emerald-500 rounded-xl text-center space-y-3">
          <div class="w-12 h-12 bg-emerald-500/20 text-emerald-400 rounded-full flex items-center justify-center mx-auto text-2xl">
            <i class="fa-solid fa-shield-check"></i>
          </div>
          <h4 id="tituloSucessoInscricaoPub" class="text-xl font-bold text-emerald-300 military-font uppercase">
            Inscrição Confirmada com Sucesso!
          </h4>
          <p id="descSucessoInscricaoPub" class="text-xs text-slate-300 max-w-md mx-auto">
            Seu cadastro foi registrado no efetivo geral e a lista de soldados da sua Companhia foi <strong class="text-amber-400">desbloqueada logo abaixo</strong> para você conferir!
          </p>
          <div class="pt-2 flex flex-col sm:flex-row gap-3 justify-center">
            <a id="btnWhatsConfirmacaoPub" href="#" target="_blank"
               class="px-5 py-2.5 bg-green-500 hover:bg-green-400 text-slate-950 font-bold rounded-lg text-xs military-font uppercase flex items-center justify-center shadow">
              <i class="fa-brands fa-whatsapp text-base mr-2"></i> Enviar Confirmação para Rodolfo (42 99903-3839)
            </a>
          </div>
        </div>

      </div>

      <!-- ÁREA DA LISTA DA COMPANHIA: BLOQUEADA OU LIBERADA -->
      <div id="areaListaCompanhiaPublica">
        
        <!-- ESTADO 1: BLOQUEADO (Antes da Inscrição) -->
        <div id="muralBloqueadoCard" class="tactical-card rounded-2xl p-8 sm:p-12 text-center border-2 border-dashed border-[#294a2e] space-y-4">
          <div class="w-16 h-16 bg-amber-500/10 text-amber-400 border border-amber-500/30 rounded-full flex items-center justify-center mx-auto text-3xl">
            <i class="fa-solid fa-lock"></i>
          </div>
          <h3 class="text-2xl font-extrabold military-font text-white uppercase">
            Lista de Soldados da Companhia Protegida
          </h3>
          <p class="text-xs sm:text-sm text-slate-400 max-w-lg mx-auto leading-relaxed">
            A relação com os nomes e os anos em que serviram os soldados de cada Companhia <strong class="text-amber-300">permanece liberada permanentemente neste dispositivo a partir do momento em que você faz sua inscrição ou atualização de cadastro acima</strong>.
          </p>
          <div class="p-3 bg-[#0a120c] rounded-lg border border-[#1d3420] inline-block text-xs text-slate-400 font-mono">
            <i class="fa-solid fa-shield-halved text-emerald-400 mr-1.5"></i> Telefones de contato são estritamente confidenciais e só o Administrador pode liberar.
          </div>

          <!-- Atalho Rápido para quem já se cadastrou antes -->
          <div class="mt-6 pt-5 border-t border-[#1e3422] max-w-md mx-auto text-left bg-[#08100a] p-4 rounded-xl border border-[#1e3823]">
            <div class="flex items-center space-x-2 text-xs font-bold text-amber-300 uppercase military-font mb-1.5">
              <i class="fa-solid fa-key text-amber-400"></i>
              <span>Já se cadastrou antes? Libere sua Companhia aqui:</span>
            </div>
            <p class="text-[11px] text-slate-400 mb-2.5 leading-relaxed">
              Se você já realizou seu cadastro anteriormente, digite seu <strong class="text-slate-200">Nome</strong> ou <strong class="text-slate-200">Nome de Guerra</strong> para liberar a lista da sua Companhia imediatamente:
            </p>
            <div class="flex gap-2">
              <input type="text" id="inputBuscarCadastroExistentePub" placeholder="Ex: SILVA ou seu Nome..."
                     class="flex-1 px-3 py-2 rounded-lg bg-[#050b06] border border-[#264429] text-xs text-amber-300 font-bold focus:outline-none focus:border-amber-400"
                     onkeydown="if(event.key === 'Enter') recuperarCadastroVeteranoPublico()">
              <button type="button" onclick="recuperarCadastroVeteranoPublico()"
                      class="px-4 py-2 bg-gradient-to-r from-amber-500 to-yellow-500 hover:from-amber-400 hover:to-yellow-400 text-slate-950 font-black rounded-lg text-xs military-font uppercase flex items-center shadow-md">
                <i class="fa-solid fa-unlock mr-1.5"></i> Liberar
              </button>
            </div>
            <div id="msgRecuperarStatusPub" class="mt-2 text-[11px] hidden"></div>
          </div>
        </div>

        <!-- ESTADO 2: LIBERADO (Apenas após Inscrição ou para Admin) -->
        <div id="muralLiberadoCard" class="hidden tactical-card rounded-2xl p-6 sm:p-8 border border-emerald-600/50 space-y-4">
          
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-[#233f27]">
            <div>
              <div class="inline-flex items-center space-x-1.5 px-3 py-1 bg-emerald-950 border border-emerald-500 rounded-full text-xs font-bold text-emerald-300 military-font uppercase mb-1">
                <i class="fa-solid fa-lock-open text-amber-400 mr-1"></i> Acesso Liberado para Você
              </div>
              <h3 class="text-2xl font-extrabold military-font gold-gradient uppercase" id="tituloCiaLiberada">
                1ª Cia Eng Cmb Bld
              </h3>
              <p class="text-xs text-slate-400 mt-0.5">
                Relação de militares cadastrados com <strong class="text-slate-200">Nome</strong> e <strong class="text-slate-200">Ano que serviu</strong>.
              </p>
            </div>

            <div class="flex items-center space-x-2">
              <span id="badgeContagemCiaLiberada" class="px-3.5 py-1.5 bg-[#0a120c] border border-[#233f27] rounded-lg text-emerald-400 font-mono font-bold text-xs sm:text-sm">
                -- Soldados
              </span>
            </div>
          </div>

          <!-- Barra de Abas das Companhias com os Desenhos dos Animais Mascotes -->
          <div class="p-3 bg-[#0a120c] rounded-xl border border-[#1e3422] space-y-2">
            <div class="flex items-center justify-between text-[11px] text-slate-400 font-semibold uppercase military-font">
              <span class="flex items-center"><i class="fa-solid fa-paw text-amber-400 mr-1.5"></i> Ver Integrantes por Companhia:</span>
              <span class="text-amber-400 font-bold">Mascotes das Companhias</span>
            </div>
            <div class="flex flex-wrap gap-2" id="botoesCiasMuralPub">
              <!-- Gerado via JavaScript com os 4 animais -->
            </div>
          </div>

          <!-- Bloco Tático: Puxar Integrantes pelo Ano em que Serviu -->
          <div class="p-4 bg-gradient-to-r from-[#122315] via-[#0b140d] to-[#122315] rounded-xl border-2 border-emerald-600/70 shadow-lg space-y-3">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
              <div class="flex items-center space-x-2.5">
                <div class="w-9 h-9 rounded-lg bg-amber-500/20 border border-amber-500/40 text-amber-400 flex items-center justify-center text-sm font-bold shadow-sm">
                  <i class="fa-solid fa-calendar-check"></i>
                </div>
                <div>
                  <h4 class="text-sm font-bold text-slate-100 military-font uppercase tracking-wide flex items-center">
                    Puxar Integrantes do Ano que Serviu
                    <span class="ml-2 px-2 py-0.5 bg-amber-500/20 text-amber-300 border border-amber-500/40 rounded text-[10px] font-bold">Turma de Caserna</span>
                  </h4>
                  <p class="text-[11px] text-slate-300">
                    Coloque o ano em que você serviu para puxar os integrantes da sua época:
                  </p>
                </div>
              </div>
              <button type="button" onclick="limparFiltroAnoMural()" id="btnVerTodosAnosMural"
                      class="px-3 py-1.5 bg-[#182c1c] hover:bg-[#233f28] text-slate-200 border border-[#2d5632] rounded-lg text-xs military-font font-bold uppercase transition-all flex items-center self-start sm:self-auto shadow-sm">
                <i class="fa-solid fa-users mr-1.5 text-amber-400"></i> Ver Todos os Anos
              </button>
            </div>

            <!-- Controles: Input de Ano + Botão Puxar + Busca de Nome -->
            <div class="grid grid-cols-1 sm:grid-cols-12 gap-2.5 pt-1">
              <div class="sm:col-span-5 flex gap-2">
                <div class="relative flex-1">
                  <i class="fa-solid fa-calendar-days absolute left-3 top-2.5 text-amber-400 text-xs"></i>
                  <input type="number" id="filtroMuralPubAno" oninput="filtrarMuralPublico()"
                         placeholder="Ex: 1984" min="1940" max="2030"
                         class="w-full pl-9 pr-3 py-2 rounded-lg bg-[#070e08] border-2 border-emerald-500/80 text-amber-300 text-sm font-mono font-bold focus:outline-none focus:border-amber-400 placeholder:text-slate-500">
                </div>
                <button type="button" onclick="filtrarMuralPublico()"
                        class="px-4 py-2 bg-gradient-to-r from-emerald-600 to-green-600 hover:from-emerald-500 hover:to-green-500 text-slate-950 font-extrabold rounded-lg text-xs military-font uppercase flex items-center shadow-md">
                  <i class="fa-solid fa-filter mr-1.5"></i> Puxar
                </button>
              </div>

              <div class="sm:col-span-7 relative">
                <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-slate-500 text-xs"></i>
                <input type="text" id="filtroMuralPubBusca" oninput="filtrarMuralPublico()"
                       placeholder="Ou busque por Nome / Nome de Guerra..."
                       class="w-full pl-9 pr-3 py-2 rounded-lg bg-[#070e08] border border-[#264429] text-xs text-slate-200 focus:outline-none focus:border-amber-400">
              </div>
            </div>

            <!-- Faixa de Status: Mostra exatamente o que está puxado -->
            <div id="faixaStatusMuralAno" class="flex flex-wrap items-center justify-between gap-2 px-3 py-1.5 bg-[#060c07] rounded-lg border border-[#1b3420] text-xs text-slate-300">
              <div id="txtStatusAnoMural" class="flex items-center space-x-1.5 font-medium">
                <i class="fa-solid fa-circle-info text-amber-400 text-[11px]"></i>
                <span>Exibindo todos os soldados da Companhia. Digite o ano acima para puxar sua turma.</span>
              </div>
              <div id="qtdAnoPuxadoMural" class="font-mono text-emerald-400 font-bold text-[11px]">
                --
              </div>
            </div>
          </div>

          <!-- Grid de Soldados da Companhia -->
          <div id="gridSoldadosCiaLiberada" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 max-h-[500px] overflow-y-auto custom-scroll pr-1">
            <!-- Preenchido via JS com Nome e Ano que serviu -->
          </div>

        </div>

      </div>

    </section>

    <!-- SEÇÃO 1: INTEGRANTES & COMPANHIAS (ADMINISTRATIVA) -->
    <section id="aba-integrantes" class="hidden space-y-6">

      <!-- BARRA DE CONTROLE EXCLUSIVA DO ADMINISTRADOR -->
      <div class="tactical-card rounded-xl p-4 bg-gradient-to-r from-[#172d1c] via-[#102014] to-[#0a150c] border border-[#2d5632] flex flex-wrap items-center justify-between gap-3 text-xs">
        <div class="flex items-center space-x-2.5">
          <span class="w-3 h-3 rounded-full bg-emerald-500 animate-pulse"></span>
          <div>
            <span class="font-bold military-font uppercase text-white tracking-wider text-sm block">
              Painel Geral de Administração Militar
            </span>
            <span class="text-[11px] text-emerald-400 font-mono">Painel de Acesso Restrito</span>
          </div>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <div class="flex items-center space-x-2 bg-[#081009] px-3 py-1.5 rounded-lg border border-[#244228]">
            <span class="text-slate-300 font-semibold text-[11px]">Telefones no Mural Público:</span>
            <button onclick="toggleLiberacaoTelefonesAdmin()" id="btnToggleTelefonesAdmin"
                    class="px-2.5 py-0.5 bg-amber-950 text-amber-300 border border-amber-600/50 rounded font-bold military-font uppercase transition-all flex items-center">
              <i class="fa-solid fa-lock mr-1 text-amber-400"></i> Protegidos (Padrão)
            </button>
          </div>
          <button onclick="baixarDadosJsAtualizado()"
                  class="px-3 py-1.5 bg-amber-600 hover:bg-amber-500 text-slate-950 font-bold rounded text-xs military-font uppercase flex items-center shadow">
            <i class="fa-solid fa-floppy-disk mr-1"></i> Baixar dados.js
          </button>
        </div>
      </div>

      <!-- Cards de Estatísticas Rápidas -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4">
        <div class="tactical-card rounded-xl p-4 border-l-4 border-l-emerald-500">
          <div class="flex items-center justify-between text-slate-400 text-xs font-semibold uppercase military-font">
            <span>Total Cadastrados</span>
            <i class="fa-solid fa-id-card text-emerald-400 text-base"></i>
          </div>
          <div id="statTotal" class="text-2xl sm:text-3xl font-extrabold military-font text-white mt-1">658</div>
          <div class="text-[11px] text-emerald-400 mt-0.5"><i class="fa-solid fa-check-double mr-1"></i> 100% com telefone</div>
        </div>

        <div class="tactical-card rounded-xl p-4 border-l-4 border-l-amber-500">
          <div class="flex items-center justify-between text-slate-400 text-xs font-semibold uppercase military-font">
            <span>Com E-mail</span>
            <i class="fa-solid fa-envelope text-amber-400 text-base"></i>
          </div>
          <div class="text-2xl sm:text-3xl font-extrabold military-font text-white mt-1">600</div>
          <div class="text-[11px] text-amber-400 mt-0.5">91.2% da tropa</div>
        </div>

        <div class="tactical-card rounded-xl p-4 border-l-4 border-l-blue-500">
          <div class="flex items-center justify-between text-slate-400 text-xs font-semibold uppercase military-font">
            <span>Com CPF</span>
            <i class="fa-solid fa-address-card text-blue-400 text-base"></i>
          </div>
          <div class="text-2xl sm:text-3xl font-extrabold military-font text-white mt-1">499</div>
          <div class="text-[11px] text-blue-400 mt-0.5">75.8% cadastrado</div>
        </div>

        <div class="tactical-card rounded-xl p-4 border-l-4 border-l-purple-500">
          <div class="flex items-center justify-between text-slate-400 text-xs font-semibold uppercase military-font">
            <span>Novos Cadastros</span>
            <i class="fa-solid fa-user-plus text-purple-400 text-base"></i>
          </div>
          <div id="statNovos" class="text-2xl sm:text-3xl font-extrabold military-font text-purple-300 mt-1">0</div>
          <div class="text-[11px] text-purple-400 mt-0.5">Via link online</div>
        </div>
      </div>

      <!-- Filtros por Companhia (Sub-Abas Militares) -->
      <div class="tactical-card rounded-xl p-4">
        <div class="text-xs font-bold text-slate-300 uppercase military-font tracking-wider mb-2 flex items-center justify-between">
          <span><i class="fa-solid fa-flag text-amber-400 mr-1.5"></i> Filtrar por Companhia / Subunidade:</span>
          <span id="labelContagemFiltrada" class="text-emerald-400 font-extrabold">658 Integrantes</span>
        </div>
        
        <div class="flex flex-wrap gap-2" id="botoesCompanhia">
          <!-- Gerados dinamicamente no JS -->
        </div>
      </div>

      <!-- Barra de Pesquisa e Filtros Secundários -->
      <div class="tactical-card rounded-xl p-4 flex flex-col md:flex-row gap-3 items-center justify-between">
        
        <!-- Campo de Busca Universal -->
        <div class="relative w-full md:w-96">
          <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-3.5 text-slate-400 text-sm"></i>
          <input type="text" id="campoBusca" oninput="aplicarFiltros()"
                 placeholder="Buscar por Nome, Nome de Guerra, Cidade, CPF, ID..."
                 class="w-full pl-10 pr-4 py-2 bg-[#0c160e] border border-[#2b472f] rounded-lg text-sm text-slate-100 placeholder-slate-500 focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400 transition-all">
        </div>

        <!-- Filtros Rápidos (Graduação e Estado) -->
        <div class="flex flex-wrap items-center gap-2 w-full md:w-auto">
          <select id="filtroGraduacao" onchange="aplicarFiltros()"
                  class="px-3 py-2 bg-[#0c160e] border border-[#2b472f] rounded-lg text-xs font-medium text-slate-200 focus:outline-none focus:border-amber-400">
            <option value="">Todas as Graduações</option>
            <option value="Sd">Soldados (Sd)</option>
            <option value="Cb">Cabos (Cb)</option>
            <option value="Sgt">Sargentos (Sgt)</option>
            <option value="Sub Ten">Subtenentes (Sub Ten)</option>
            <option value="Ten">Tenentes (Ten)</option>
            <option value="Cap">Capitães (Cap)</option>
            <option value="Maj">Majores (Maj)</option>
            <option value="Ten Cel">Tenentes-Coronéis (Ten Cel)</option>
            <option value="Cel">Coronéis (Cel)</option>
            <option value="Gen">Generais (Gen)</option>
          </select>

          <select id="filtroEstado" onchange="aplicarFiltros()"
                  class="px-3 py-2 bg-[#0c160e] border border-[#2b472f] rounded-lg text-xs font-medium text-slate-200 focus:outline-none focus:border-amber-400">
            <option value="">Todos os Estados (UF)</option>
            <option value="Santa Catarina">Santa Catarina (SC)</option>
            <option value="Paraná">Paraná (PR)</option>
            <option value="São Paulo">São Paulo (SP)</option>
            <option value="Distrito Federal">Distrito Federal (DF)</option>
            <option value="Rio de Janeiro">Rio de Janeiro (RJ)</option>
            <option value="Rio Grande do Sul">Rio Grande do Sul (RS)</option>
            <option value="Minas Gerais">Minas Gerais (MG)</option>
            <option value="Outros">Outros Estados</option>
          </select>

          <button onclick="limparFiltros()" title="Limpar Filtros"
                  class="px-3 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg text-xs font-bold transition-all">
            <i class="fa-solid fa-rotate-left mr-1"></i> Limpar
          </button>
        </div>

      </div>

      <!-- Tabela / Grid dos Integrantes -->
      <div class="tactical-card rounded-xl overflow-hidden border border-[#233b26]">
        
        <!-- Ações na Barra da Tabela com OPÇÕES DE EXPORTAÇÃO (COMPLETA E SIMPLIFICADA) -->
        <div class="px-4 py-3 bg-[#0c150e] border-b border-[#203623] flex flex-wrap items-center justify-between gap-3 text-xs">
          
          <div class="flex items-center space-x-3">
            <label class="flex items-center space-x-2 cursor-pointer select-none">
              <input type="checkbox" id="checkSelecionarTodos" onchange="toggleSelecionarTodos(this)"
                     class="w-4 h-4 rounded text-emerald-600 bg-slate-800 border-slate-600 focus:ring-0">
              <span class="font-bold text-slate-300 uppercase military-font">Selecionar Todos</span>
            </label>
            <span id="contagemSelecionados" class="text-amber-400 font-bold hidden">
              (0 selecionados)
            </span>
          </div>

          <!-- BOTÕES DE EXPORTAÇÃO DA COMPANHIA SELECIONADA -->
          <div class="flex flex-wrap items-center gap-1.5 sm:gap-2">
            
            <!-- Botão Planilha Completa -->
            <button onclick="exportarCompanhiaAtualCSV()"
                    title="Exporta planilha Excel completa da Companhia ativa"
                    class="px-2.5 py-1.5 bg-emerald-800 hover:bg-emerald-700 text-white rounded font-bold military-font uppercase transition-all flex items-center shadow">
              <i class="fa-solid fa-file-excel mr-1 text-emerald-300"></i> Planilha (.CSV)
            </button>

            <!-- Botão Contatos Celular VCF -->
            <button onclick="exportarCompanhiaAtualVCF()"
                    title="Exporta contatos para celular da Companhia ativa"
                    class="px-2.5 py-1.5 bg-green-700 hover:bg-green-600 text-white rounded font-bold military-font uppercase transition-all flex items-center shadow">
              <i class="fa-solid fa-address-book mr-1 text-green-300"></i> Contatos (.VCF)
            </button>

            <!-- NOVO: Exportar Apenas Nomes -->
            <button onclick="exportarApenasNomesAtual()"
                    title="Exporta lista contendo exclusivamente os nomes"
                    class="px-2.5 py-1.5 bg-[#182a1a] hover:bg-[#223d26] text-amber-300 border border-[#2d5632] rounded font-bold military-font uppercase transition-all flex items-center shadow">
              <i class="fa-solid fa-user mr-1 text-amber-400"></i> Apenas Nomes
            </button>

            <!-- NOVO: Exportar Apenas Telefones -->
            <button onclick="exportarApenasTelefonesAtual()"
                    title="Exporta lista contendo exclusivamente os telefones (1 por linha)"
                    class="px-2.5 py-1.5 bg-[#182a1a] hover:bg-[#223d26] text-emerald-300 border border-[#2d5632] rounded font-bold military-font uppercase transition-all flex items-center shadow">
              <i class="fa-solid fa-phone mr-1 text-emerald-400"></i> Apenas Telefones
            </button>

            <!-- NOVO: Nome + Telefone -->
            <button onclick="exportarNomeETelefoneAtual()"
                    title="Exporta lista simples com Nome e Telefone"
                    class="px-2.5 py-1.5 bg-[#182a1a] hover:bg-[#223d26] text-blue-300 border border-[#2d5632] rounded font-bold military-font uppercase transition-all flex items-center shadow">
              <i class="fa-solid fa-address-card mr-1 text-blue-400"></i> Nome + Tel
            </button>

            <!-- Botão Mensagem WhatsApp -->
            <button onclick="abrirMensagensComSelecionados()"
                    class="px-3 py-1.5 bg-amber-600 hover:bg-amber-500 text-slate-950 rounded font-extrabold military-font uppercase transition-all flex items-center shadow">
              <i class="fa-brands fa-whatsapp mr-1 text-sm"></i> Mensagem WhatsApp
            </button>
          </div>

        </div>

        <!-- Tabela -->
        <div class="overflow-x-auto custom-scroll max-h-[620px]">
          <table class="w-full text-left text-xs border-collapse">
            <thead class="bg-[#142316] text-amber-400 font-extrabold uppercase military-font tracking-wider sticky top-0 z-10 border-b border-[#28442b]">
              <tr>
                <th class="p-3 w-10 text-center">#</th>
                <th class="p-3 w-12 text-center">ID</th>
                <th class="p-3 w-28">Posto / Grad</th>
                <th class="p-3">Nome Completo</th>
                <th class="p-3 w-28">Guerra</th>
                <th class="p-3">Companhia</th>
                <th class="p-3 w-16 text-center">Ano</th>
                <th class="p-3">Telefone / WhatsApp</th>
                <th class="p-3">Cidade / UF</th>
                <th class="p-3 w-24 text-center">Ações</th>
              </tr>
            </thead>
            <tbody id="tabelaIntegrantes" class="divide-y divide-[#1b2f1d] text-slate-300">
              <!-- Preenchido via JavaScript -->
            </tbody>
          </table>
        </div>

        <div id="semResultados" class="hidden p-8 text-center text-slate-400">
          <i class="fa-solid fa-user-slash text-3xl text-amber-500/50 mb-2"></i>
          <p class="font-bold military-font text-base text-slate-300 uppercase">Nenhum integrante encontrado</p>
          <p class="text-xs">Tente ajustar seus termos de pesquisa ou remover os filtros aplicados.</p>
        </div>

      </div>


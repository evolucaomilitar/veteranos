    // Modal de Importação do WhatsApp
    function abrirModalImportarWhats() {
      document.getElementById('txtMsgWhatsImportar').value = '';
      document.getElementById('modalImportarWhats').classList.remove('hidden');
    }

    function fecharModalImportarWhats() {
      document.getElementById('modalImportarWhats').classList.add('hidden');
    }

    function carregarExemploWhatsImportar() {
      const exemplo = `*CADASTRO DE VETERANO - 5º BE CMB BLD*
👤 *Nome:* Carlos Alberto Silveira (SILVA)
🎖️ *Graduação:* Sd
🏢 *Companhia:* 1º Cia Eng Cmb Bld
📅 *Ano Inc:* 1988
📱 *WhatsApp:* (42) 99888-7766
📍 *Cidade:* Porto União - SC
🏠 *Endereço:* Rua Marechal Deodoro, 450, Centro`;
      document.getElementById('txtMsgWhatsImportar').value = exemplo;
    }

    function processarTextoWhatsCadastro() {
      const texto = document.getElementById('txtMsgWhatsImportar').value;
      if (!texto.trim()) {
        return alert("Por favor, cole a mensagem recebida no WhatsApp.");
      }

      function extrair(padrao) {
        const m = texto.match(padrao);
        return m ? m[1].trim() : '';
      }

      let nomeCompleto = extrair(/(?:Nome|Nome Completo)\s*:\*?\s*([^\n\r()]+)/i);
      let guerra = extrair(/\(([^)]+)\)/);
      if (!guerra) guerra = extrair(/(?:Guerra|Nome de Guerra)\s*:\*?\s*([^\n\r]+)/i);
      
      let grad = extrair(/(?:Graduação|Posto|Grad)\s*:\*?\s*([^\n\r]+)/i) || 'Sd';
      let cia = extrair(/(?:Companhia|Cia|Subunidade)\s*:\*?\s*([^\n\r]+)/i);
      let ano = extrair(/(?:Ano|Ano Inc|Ano de Incorporação)\s*:\*?\s*(\d{4})/i) || '';
      let tel = extrair(/(?:WhatsApp|Celular|Tel|Telefone)\s*:\*?\s*([^\n\r]+)/i);
      let cidadeUf = extrair(/(?:Cidade)\s*:\*?\s*([^\n\r]+)/i);
      let endereco = extrair(/(?:Endereço|Rua)\s*:\*?\s*([^\n\r]+)/i);

      if (!nomeCompleto) {
        return alert("Não foi possível identificar o campo 'Nome:' no texto. Por favor, verifique.");
      }

      let cidade = cidadeUf || 'Não informada';
      let uf = 'Santa Catarina';
      if (cidadeUf && cidadeUf.includes('-')) {
        const p = cidadeUf.split('-');
        cidade = p[0].trim();
        uf = p[1].trim();
      }

      // Mapeamento canônico da Companhia
      let ciaFinal = "1º Cia Eng Cmb Bld";
      if (cia) {
        const ciaMin = cia.toLowerCase();
        if (ciaMin.includes('2')) ciaFinal = "2º Cia Eng Cmb Bld";
        else if (ciaMin.includes('1')) ciaFinal = "1º Cia Eng Cmb Bld";
        else if (ciaMin.includes('pont') || ciaMin.includes('cep')) ciaFinal = "Cia Eng Pnt (CEP)";
        else if (ciaMin.includes('cmdo') || ciaMin.includes('ccap')) ciaFinal = "Cia Cmdo e Ap - (CCAp)";
        else if (ciaMin.includes('maior')) ciaFinal = "Estado Maior Geral e Especial";
        else if (ciaMin.includes('npor')) ciaFinal = "NPOR";
        else ciaFinal = cia;
      }

      const dialNumber = (tel || '').replace(/\D/g, '');
      const telDial = dialNumber.length <= 11 ? '55' + dialNumber : dialNumber;

      const dadosWhats = {
        nome: nomeCompleto,
        guerra: (guerra || nomeCompleto.split(' ')[0]).toUpperCase(),
        grad: grad,
        cia: ciaFinal,
        ano: ano,
        tel: tel || '(00) 00000-0000',
        telDial: telDial,
        email: extrair(/(?:E-mail|Email)\s*:\*?\s*([^\n\r\s]+)/i) || '',
        cpf: extrair(/(?:CPF)\s*:\*?\s*([^\n\r\s]+)/i) || '',
        cidade: cidade,
        uf: uf,
        rua: endereco,
        bairro: '',
        endereco: endereco ? `${endereco} - ${cidade} - ${uf}` : `${cidade} - ${uf}`
      };

      // 1. Salva no localStorage (verifica se já existe)
      let listaNovos = [];
      try {
        const stored = localStorage.getItem('novos_veteranos_5be');
        if (stored) listaNovos = JSON.parse(stored);
      } catch(e) { listaNovos = []; }

      const match = encontrarMilitarExistente(integrantedAtuais, dadosWhats);
      const isAtualizacao = Boolean(match);
      let registroFinal;

      if (isAtualizacao) {
        // Apenas atualiza as informações do militar existente mantendo o ID original
        registroFinal = Object.assign({}, match.militar, dadosWhats, {
          id: match.militar.id,
          dataAtualizacao: new Date().toLocaleDateString('pt-BR'),
          isAtualizado: true,
          isNovo: true
        });

        let idxNovo = listaNovos.findIndex(n => n.id === registroFinal.id);
        if (idxNovo === -1) {
          const mNovo = encontrarMilitarExistente(listaNovos, registroFinal);
          if (mNovo) idxNovo = mNovo.index;
        }

        if (idxNovo !== -1) {
          listaNovos[idxNovo] = registroFinal;
        } else {
          listaNovos.unshift(registroFinal);
        }
      } else {
        registroFinal = Object.assign({}, dadosWhats, {
          id: Date.now(),
          dataCadastro: new Date().toLocaleDateString('pt-BR'),
          isNovo: true
        });
        listaNovos.unshift(registroFinal);
      }

      localStorage.setItem('novos_veteranos_5be', JSON.stringify(listaNovos));

      // 2. Transmite Broadcast
      try {
        if (syncChannel) syncChannel.postMessage({ 
          tipo: isAtualizacao ? 'ATUALIZACAO_CADASTRO' : 'NOVO_CADASTRO', 
          registro: registroFinal 
        });
      } catch(e) {}

      // 3. Atualiza Geral
      recarregarEfetivoComNovos(registroFinal);
      fecharModalImportarWhats();
              if (isAtualizacao) {
          alert(`âš ï¸ AVISO: O cadastro de ${registroFinal.nome} JÃ EXISTE no sistema!\n\nAs suas informações foram atualizadas com sucesso no Efetivo Geral.`);
        }
        mostrarNotificacaoTatica(isAtualizacao
        ? `✅ Informações do Veterano ${registroFinal.nome} atualizadas com sucesso!`
        : `✅ Veterano ${registroFinal.nome} (${registroFinal.cia}) incorporado com sucesso ao Efetivo Geral!`);
    }

    // Exporta banco dados.js atualizado
    function baixarDadosJsAtualizado() {
      const jsContent = "window.VETERANOS_DATA = " + JSON.stringify(integrantedAtuais, null, 2) + ";\n";
      triggerDownload(jsContent, "dados.js", "application/javascript;charset=utf-8;");
      alert("✅ Arquivo 'dados.js' gerado com sucesso contendo todo o efetivo atualizado (" + integrantedAtuais.length + " militares)!\n\nPara tornar permanente a inclusão no repositório, basta salvar o arquivo baixado na pasta do sistema substituindo o 'dados.js' anterior.");
    }

    // Notificação Tática Flutuante (Toast)
    function mostrarNotificacaoTatica(msg) {
      let toast = document.getElementById('notificacaoTatica');
      if (!toast) {
        toast = document.createElement('div');
        toast.id = 'notificacaoTatica';
        toast.className = 'fixed bottom-5 right-5 z-50 bg-[#122416] border-2 border-emerald-500 text-emerald-300 px-5 py-3.5 rounded-xl shadow-2xl military-font font-bold text-xs sm:text-sm flex items-center space-x-3 transition-all duration-300 transform';
        document.body.appendChild(toast);
      }
      toast.innerHTML = `<i class="fa-solid fa-bell text-amber-400 text-base"></i> <span>${msg}</span>`;
      toast.classList.remove('hidden', 'opacity-0', 'translate-y-4');
      toast.classList.add('opacity-100', 'translate-y-0');
      
      clearTimeout(toast._timeout);
      toast._timeout = setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-4');
        setTimeout(() => toast.classList.add('hidden'), 300);
      }, 4000);
    }

    function renderizarNovosCadastros(novos) {
      const tbody = document.getElementById('tabelaNovosCadastros');
      tbody.innerHTML = '';

      if (!novos || novos.length === 0) {
        tbody.innerHTML = `<tr><td colspan="9" class="p-4 text-center text-slate-500">Nenhum novo cadastro recebido ainda. Envie o link para os veteranos!</td></tr>`;
        return;
      }

      novos.forEach(n => {
        const tr = document.createElement('tr');
        tr.className = "hover:bg-[#152518]";
        const dialNumber = (n.tel || '').replace(/\D/g, '');

        tr.innerHTML = `
          <td class="p-2.5 font-mono text-slate-400">${n.dataCadastro || '-'}</td>
          <td class="p-2.5 font-bold text-slate-200">${n.nome}</td>
          <td class="p-2.5 text-amber-400 font-bold">${n.guerra}</td>
          <td class="p-2.5 font-semibold text-emerald-400">${n.grad}</td>
          <td class="p-2.5 text-slate-300">
            ${(() => {
              const mascCia = obterMascoteCia(n.cia);
              return mascCia && mascCia.svg 
                ? `<div class="inline-flex items-center space-x-1.5"><img src="${mascCia.svg}" alt="${mascCia.nome}" class="w-4 h-4 object-contain filter drop-shadow"><span>${n.cia}</span><span class="text-[9px] px-1 py-0.2 rounded font-black ${mascCia.bgTag}">${mascCia.badge}</span></div>`
                : (n.cia || '-');
            })()}
          </td>
          <td class="p-2.5 text-center font-mono">${n.ano}</td>
          <td class="p-2.5 font-mono text-emerald-400">${n.tel}</td>
          <td class="p-2.5 text-slate-300">${n.cidade}/${n.uf}</td>
          <td class="p-2.5 text-center">
            <a href="https://api.whatsapp.com/send?phone=55${dialNumber}" target="_blank"
               class="px-2 py-1 bg-green-600 hover:bg-green-500 text-slate-950 font-bold rounded text-xs">
              <i class="fa-brands fa-whatsapp"></i>
            </a>
          </td>
        `;
        tbody.appendChild(tr);
      });
    }

    function exportarNovosCadastrosCSV() {
      let novos = [];
      try {
        const stored = localStorage.getItem('novos_veteranos_5be');
        if (stored) novos = JSON.parse(stored);
      } catch (e) {}

      if (novos.length === 0) {
        alert("Não há novos cadastros para exportar.");
        return;
      }

      let csv = "Data;Nome Completo;Nome Guerra;Graduação;Companhia;Ano;WhatsApp;E-mail;CPF;Cidade;UF;Endereço\n";
      novos.forEach(n => {
        csv += `"${n.dataCadastro}";"${n.nome}";"${n.guerra}";"${n.grad}";"${n.cia}";"${n.ano}";"${n.tel}";"${n.email}";"${n.cpf}";"${n.cidade}";"${n.uf}";"${n.rua || ''}"\n`;
      });

      triggerDownload("\uFEFF" + csv, `novos_cadastros_5be_${new Date().toISOString().slice(0,10)}.csv`, 'text/csv;charset=utf-8;');
    }

    function limparNovosCadastros() {
      if (confirm("Deseja realmente limpar a lista de novos cadastros salvos neste navegador?")) {
        localStorage.removeItem('novos_veteranos_5be');
        document.getElementById('statNovos').innerText = '0';
        renderizarNovosCadastros([]);
        montarBotoesCompanhias();
      }
    }

    // Modal de Ficha Cadastral
    function abrirModalFicha(item) {
      document.getElementById('modalID').innerText = item.id;
      document.getElementById('modalNomeCompleto').innerText = item.nome;
      document.getElementById('modalNomeGuerra').innerText = item.guerra || 'Não informado';
      document.getElementById('modalGraduacao').innerText = item.grad || 'Não informado';
      document.getElementById('modalAno').innerText = item.ano || 'Não informado';
      document.getElementById('modalCompanhia').innerText = item.cia || 'Não informado';
      document.getElementById('modalTelefone').innerText = item.tel || 'Não informado';
      document.getElementById('modalEmail').innerText = item.email || 'Não informado';
      document.getElementById('modalCPF').innerText = item.cpf || 'Não informado';
      document.getElementById('modalNascimento').innerText = item.nasc || 'Não informado';
      document.getElementById('modalEndereco').innerText = item.endereco || 'Não informado';

      const dialNumber = item.telDial || (item.tel || '').replace(/\D/g, '');
      const btnWhats = document.getElementById('modalBtnWhatsApp');
      btnWhats.href = `https://api.whatsapp.com/send?phone=${dialNumber}&text=${encodeURIComponent('Olá ' + (item.guerra || item.nome) + ', saudações da Comissão dos Veteranos do 5º BE Cmb Bld!')}`;

      document.getElementById('modalFicha').classList.remove('hidden');
    }

    function fecharModalFicha() {
      document.getElementById('modalFicha').classList.add('hidden');
    }
  
    // ==========================================
    // GESTÃO DE EVENTOS, ALMOÇO & 7 DE SETEMBRO
    // ==========================================
    const CHAVE_STORAGE_EVENTOS = 'reservas_eventos_5be';

    function obterStatusAlmocoMilitar(militar) {
      if (!militar) return null;
      let reservas = [];
      try {
        const s = localStorage.getItem('reservas_eventos_5be');
        if (s) reservas = JSON.parse(s);
      } catch(e) { reservas = []; }

      if (!reservas.length) return null;

      const telMilitar = (militar.tel || '').replace(/\D/g, '');
      if (telMilitar && telMilitar.length >= 8) {
        const porTel = reservas.find(r => {
          const t = (r.tel || '').replace(/\D/g, '');
          return t && (t === telMilitar || t.endsWith(telMilitar) || telMilitar.endsWith(t));
        });
        if (porTel) return porTel;
      }

      const norm = (s) => (s || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').trim();
      const nomeMilitar = norm(militar.nome);
      if (nomeMilitar.length >= 4) {
        const porNome = reservas.find(r => norm(r.nome) === nomeMilitar);
        if (porNome) return porNome;
      }

      const guerraMilitar = norm(militar.guerra);
      if (guerraMilitar.length >= 3 && militar.ano) {
        const porGuerra = reservas.find(r => 
          norm(r.guerra) === guerraMilitar && 
          r.ano && r.ano.toString() === militar.ano.toString()
        );
        if (porGuerra) return porGuerra;
      }

      return null;
    }


    function carregarRelatorioEventos() {
      const reservas = obterReservasEventos();
      atualizarKpisEventos(reservas);
      atualizarGraficoPizzaEventos(reservas);
      filtrarTabelaEventos();
    }

    function atualizarKpisEventos(reservas) {
      let totalAlmocos = 0;
      let totalFamilias = 0;
      let arrecadacaoTotal = 0;
      let arrecadacaoPaga = 0;
      let arrecadacaoPendente = 0;
      let almocosPagos = 0;
      let almocosPendentes = 0;
      let totalEntradas = 0;
      let totalPagosQtd = 0;

      reservas.forEach(r => {
        if (r.vaiAlmoco) {
          const qtd = parseInt(r.qtdAlmocos) || 1;
          const val = parseFloat(r.valorTotal) || (qtd * 50);
          totalAlmocos += qtd;
          totalFamilias++;
          arrecadacaoTotal += val;

          if (r.statusPagamento === "PAGO") {
            arrecadacaoPaga += val;
            almocosPagos += qtd;
            totalPagosQtd++;
            if (r.entradaRealizada) totalEntradas++;
          } else {
            arrecadacaoPendente += val;
            almocosPendentes += qtd;
          }
        }
      });

      const elKpiAlmocos = document.getElementById("kpiTotalAlmocos");
      const elKpiFamilias = document.getElementById("kpiTotalFamilias");
      const elKpiArrecadacao = document.getElementById("kpiTotalArrecadacao");
      const elKpiPagos = document.getElementById("kpiQtdPagos");
      const elKpiPendentes = document.getElementById("kpiQtdPendentes");
      const elKpiEntradas = document.getElementById("kpiTotalEntradas");
      const elKpiEntradasSub = document.getElementById("kpiEntradasSubtext");

      if (elKpiAlmocos) elKpiAlmocos.textContent = `${totalAlmocos} refeições`;
      if (elKpiFamilias) elKpiFamilias.textContent = `${totalFamilias} famílias`;
      if (elKpiArrecadacao) elKpiArrecadacao.textContent = `R$ ${arrecadacaoTotal.toLocaleString("pt-BR", {minimumFractionDigits: 2})}`;
      if (elKpiPagos) elKpiPagos.textContent = `${almocosPagos} alm. (R$ ${arrecadacaoPaga.toLocaleString("pt-BR")})`;
      if (elKpiPendentes) elKpiPendentes.textContent = `${almocosPendentes} alm. (R$ ${arrecadacaoPendente.toLocaleString("pt-BR")})`;
      if (elKpiEntradas) elKpiEntradas.textContent = `${totalEntradas} / ${totalPagosQtd}`;
      if (elKpiEntradasSub) {
        const pct = totalPagosQtd > 0 ? ((totalEntradas / totalPagosQtd) * 100).toFixed(0) : 0;
        elKpiEntradasSub.textContent = `${totalEntradas} presentes (${pct}%) • ${totalPagosQtd - totalEntradas} a entrar`;
      }
    }

    function filtrarTabelaEventos() {
      const reservas = obterReservasEventos();
      const tipoEvento = document.getElementById('filtroEventoAdmin')?.value || 'TODOS';
      const statusPag = document.getElementById('filtroStatusPagamentoAdmin')?.value || 'TODOS';
      const ciaFiltro = document.getElementById('filtroCiaEventoAdmin')?.value || 'TODAS';
      const termo = (document.getElementById('buscaEventoAdmin')?.value || '').toLowerCase().trim();

      const filtrados = reservas.filter(r => {
        if (tipoEvento === 'ALMOCO' && !r.vaiAlmoco) return false;

        if (statusPag === 'PAGO' && r.statusPagamento !== 'PAGO') return false;
        if (statusPag === 'PENDENTE' && r.statusPagamento === 'PAGO') return false;
        if (statusPag === "ENTRADA_PENDENTE" && (r.statusPagamento !== "PAGO" || r.entradaRealizada)) return false;
        if (statusPag === "ENTRADA_CONCLUIDA" && (r.statusPagamento !== "PAGO" || !r.entradaRealizada)) return false;

        if (ciaFiltro !== 'TODAS' && (!r.cia || !r.cia.includes(ciaFiltro))) return false;

        if (termo) {
          const matchNome = (r.nome || '').toLowerCase().includes(termo);
          const matchGuerra = (r.guerra || '').toLowerCase().includes(termo);
          const matchTel = (r.tel || '').replace(/\D/g, '').includes(termo.replace(/\D/g, ''));
          const matchAcomp = (r.acompanhantes || '').toLowerCase().includes(termo);
          if (!matchNome && !matchGuerra && !matchTel && !matchAcomp) return false;
        }

        return true;
      });

      renderizarTabelaEventos(filtrados);

      const lblFiltrada = document.getElementById('lblQtdFiltradaEventos');
      const lblAlmocosFiltrados = document.getElementById('lblQtdAlmocosFiltrados');
      if (lblFiltrada) lblFiltrada.textContent = filtrados.length;
      if (lblAlmocosFiltrados) {
        const somaAlm = filtrados.reduce((acc, cur) => acc + (cur.vaiAlmoco ? (parseInt(cur.qtdAlmocos) || 1) : 0), 0);
        lblAlmocosFiltrados.textContent = somaAlm;
      }
    }

    function renderizarTabelaEventos(lista) {
      const tbody = document.getElementById('tbodyRelatorioEventos');
      const semResultados = document.getElementById('semReservasEventos');
      if (!tbody) return;

      tbody.innerHTML = '';
      if (lista.length === 0) {
        if (semResultados) semResultados.classList.remove('hidden');
        return;
      }
      if (semResultados) semResultados.classList.add('hidden');

      lista.forEach(r => {
        const tr = document.createElement('tr');
        tr.className = "hover:bg-[#122216]/60 transition-colors border-b border-[#16291a]";

        // Data formatada
        let dataStr = "--";
        try {
          if (r.dataHora) {
            const d = new Date(r.dataHora);
            dataStr = `${d.toLocaleDateString('pt-BR')} <span class="text-[10px] text-slate-500 font-mono block">${d.toLocaleTimeString('pt-BR', {hour: '2-digit', minute: '2-digit'})}</span>`;
          }
        } catch(e) {}

        // WhatsApp link
        const telLimpo = (r.tel || '').replace(/\D/g, '');
        const whatsLink = telLimpo.length >= 10 
          ? `https://api.whatsapp.com/send?phone=55${telLimpo}`
          : '#';

        // Badge Almoço
        let badgeAlmoco = '<span class="text-slate-500 text-[11px]">Não participará</span>';
        if (r.vaiAlmoco) {
          const qtd = r.qtdAlmocos || 1;
          const totalVal = (r.valorTotal || (qtd * 50)).toFixed(2).replace('.', ',');
          badgeAlmoco = `
            <div class="inline-block text-left">
              <span class="inline-flex items-center px-2 py-0.5 rounded bg-amber-950/80 text-amber-300 font-bold border border-amber-600/50 text-[11px]">
                <i class="fa-solid fa-utensils mr-1"></i> ${qtd} almoço(s) • R$ ${totalVal}
              </span>
              ${r.acompanhantes ? `<span class="block text-[10px] text-slate-400 mt-0.5 max-w-[200px] truncate" title="${r.acompanhantes}">👥 ${r.acompanhantes}</span>` : ''}
            </div>
          `;
        }

        // Controle de Entrada na Portaria
        let cellPortaria = `<span class="text-slate-500 text-[11px]">-</span>`;
        if (r.vaiAlmoco) {
          if (r.statusPagamento !== "PAGO") {
            cellPortaria = `<span class="text-[11px] text-amber-500/80 font-mono"><i class="fa-solid fa-lock text-[10px] mr-1"></i> Aguardando Pagto</span>`;
          } else if (r.entradaRealizada) {
            cellPortaria = `
              <div class="inline-flex items-center space-x-1.5 px-2.5 py-1 rounded-lg bg-blue-950/90 text-blue-300 border border-blue-500/60 text-xs font-mono font-bold shadow">
                <i class="fa-solid fa-check-double text-blue-400"></i>
                <span>ENTRADA FINALIZADA (${r.horaEntrada || "OK"})</span>
                <button onclick="desfazerEntradaEvento(${r.id})" title="Desfazer Entrada (Reabrir na Portaria)" class="text-slate-400 hover:text-amber-400 ml-1 text-xs">
                  <i class="fa-solid fa-rotate-left"></i>
                </button>
              </div>
            `;
          } else {
            cellPortaria = `
              <button onclick="confirmarEntradaEvento(${r.id})" title="Confirmar Entrada e Finalizar Acesso"
                      class="px-3 py-1.5 bg-gradient-to-r from-emerald-600 to-green-600 hover:from-emerald-500 hover:to-green-500 text-slate-950 font-black rounded-lg text-xs uppercase military-font shadow flex items-center justify-center mx-auto transition-transform active:scale-95">
                <i class="fa-solid fa-door-open mr-1.5"></i> Confirmar Entrada
              </button>
            `;
          }
        }

        // Status Pagamento
        let badgeStatus = '';
        if (r.vaiAlmoco) {
          if (r.statusPagamento === 'PAGO') {
            badgeStatus = `
              <button onclick="alternarStatusPagamentoReserva(${r.id})" title="Clique para alterar status"
                      class="px-2.5 py-1 rounded-full text-[11px] font-extrabold bg-emerald-950 text-emerald-300 border border-emerald-500 hover:bg-emerald-900 transition-all shadow inline-flex items-center">
                <i class="fa-solid fa-circle-check mr-1 text-emerald-400"></i> PAGO / CONFIRMADO
              </button>
            `;
          } else {
            badgeStatus = `
              <button onclick="alternarStatusPagamentoReserva(${r.id})" title="Clique para marcar como PAGO"
                      class="px-2.5 py-1 rounded-full text-[11px] font-extrabold bg-amber-950 text-amber-300 border border-amber-500 hover:bg-amber-900 transition-all shadow inline-flex items-center">
                <i class="fa-solid fa-clock mr-1 text-amber-400"></i> PENDENTE (Aguardando PIX)
              </button>
            `;
          }
        } else {
        }

        tr.innerHTML = `
          <td class="py-3 px-3 align-middle text-slate-300">${dataStr}</td>
          <td class="py-3 px-3 align-middle">
            <div class="font-bold text-slate-100 flex items-center flex-wrap gap-1">
              <span class="text-amber-400 font-mono text-[11px] font-bold">${r.grad || 'Sd'}</span>
              <span class="text-white text-xs sm:text-sm">${r.nome}</span>
              ${r.guerra ? `<span class="px-1.5 py-0.5 bg-[#1b3420] text-emerald-300 text-[10px] font-mono rounded font-bold">(${r.guerra})</span>` : ''}
            </div>
            <div class="text-[11px] flex items-center flex-wrap gap-1.5 mt-1">
              <span class="px-2 py-0.5 bg-[#122316] border border-[#234229] rounded text-emerald-300 font-bold military-font text-[11px] flex items-center">
                <i class="fa-solid fa-shield-halved text-amber-400 text-[10px] mr-1"></i>${r.cia || '5º BE'}
              </span>
              <span class="px-2 py-0.5 bg-amber-950/80 border border-amber-600/40 rounded text-amber-300 font-mono font-bold text-[11px] flex items-center">
                <i class="fa-solid fa-calendar-day text-[10px] mr-1"></i>Ano: ${r.ano || r.turma || '--'}
              </span>
            </div>
          </td>
          <td class="py-3 px-3 align-middle">
            ${telLimpo ? `
              <a href="${whatsLink}" target="_blank" class="inline-flex items-center text-emerald-400 hover:text-emerald-300 font-mono font-semibold text-xs">
                <i class="fa-brands fa-whatsapp mr-1 text-sm text-green-400"></i> ${r.tel}
              </a>
            ` : '<span class="text-slate-500 text-[11px]">Não informado</span>'}
          </td>
          <td class="py-3 px-3 align-middle text-center">${badgeAlmoco}</td>
          <td class="py-3 px-3 align-middle text-center">${badgeStatus}</td>
          <td class="py-3 px-3 align-middle text-center">${cellPortaria}</td>
          <td class="py-3 px-3 align-middle text-right">
            <div class="flex items-center justify-end space-x-1.5">
              <button onclick="enviarConfirmacaoWhatsReserva(${r.id})" title="Enviar Comprovante / Recibo no WhatsApp"
                      class="p-1.5 bg-green-950/70 hover:bg-green-800 text-green-300 rounded border border-green-700/50 transition-all text-xs">
                <i class="fa-brands fa-whatsapp"></i>
              </button>
              <button onclick="excluirReservaEvento(${r.id})" title="Excluir Reserva"
                      class="p-1.5 bg-red-950/70 hover:bg-red-800 text-red-300 rounded border border-red-700/50 transition-all text-xs">
                <i class="fa-solid fa-trash-can"></i>
              </button>
            </div>
          </td>
        `;

        tbody.appendChild(tr);
      });
    }

    function alternarStatusPagamentoReserva(id) {
      const reservas = obterReservasEventos();
      const r = reservas.find(item => item.id == id);
      if (!r) return;

      const novoStatus = (r.statusPagamento === "PAGO") ? "PENDENTE" : "PAGO";
      r.statusPagamento = novoStatus;
      if (novoStatus === "PENDENTE") {
        r.entradaRealizada = false;
        delete r.horaEntrada;
        delete r.dataHoraEntrada;
      }

      salvarReservasEventos(reservas);
      carregarRelatorioEventos();
      atualizarVisibilidadeReservasAlmoco();
      renderizarMuralPublico();
      renderizarTabela(integrantedAtuais);

      try {
        const canal = new BroadcastChannel("veteranos_5be_sync");
        canal.postMessage({ tipo: "STATUS_PAGAMENTO_ALTERADO", id, status: novoStatus });
      } catch(e) {}

      if (novoStatus === "PAGO") {
        mostrarNotificacaoTatica(`✅ Pagamento de ${r.nome} (${r.qtdAlmocos || 1} almoço(s)) CONFIRMADO! Cadastro sinalizado em VERDE.`);
      } else {
        mostrarNotificacaoTatica(`⏳ Pagamento de ${r.nome} marcado como PENDENTE.`);
      }
    }

    function confirmarEntradaEvento(id) {
      const reservas = obterReservasEventos();
      const r = reservas.find(item => item.id == id);
      if (!r) return;

      if (r.statusPagamento !== "PAGO") {
        alert("⚠️ ATENÇÃO: O pagamento deste militar ainda não foi confirmado como PAGO!\\n\\nConfirme o pagamento antes de autorizar a entrada.");
        return;
      }

      const agora = new Date();
      const horaStr = agora.toLocaleTimeString("pt-BR", { hour: "2-digit", minute: "2-digit" });
      r.entradaRealizada = true;
      r.horaEntrada = horaStr;
      r.dataHoraEntrada = agora.toISOString();

      salvarReservasEventos(reservas);
      carregarRelatorioEventos();
      renderizarMuralPublico();
      renderizarTabela(integrantedAtuais);

      try {
        const canal = new BroadcastChannel("veteranos_5be_sync");
        canal.postMessage({ tipo: "ENTRADA_EVENTO_ATUALIZADA", id, entradaRealizada: true, horaEntrada: horaStr });
      } catch(e) {}

      mostrarNotificacaoTatica(`🚪 Entrada de ${r.nome} (${r.qtdAlmocos || 1} almoço(s)) FINALIZADA às ${horaStr}! Acesso concluído.`);
    }

    function desfazerEntradaEvento(id) {
      const reservas = obterReservasEventos();
      const r = reservas.find(item => item.id == id);
      if (!r) return;

      if (!confirm(`Deseja desfazer o registro de entrada de ${r.nome}? O militar voltará a constar como aguardando entrada.`)) return;

      r.entradaRealizada = false;
      delete r.horaEntrada;
      delete r.dataHoraEntrada;

      salvarReservasEventos(reservas);
      carregarRelatorioEventos();
      renderizarMuralPublico();
      renderizarTabela(integrantedAtuais);

      try {
        const canal = new BroadcastChannel("veteranos_5be_sync");
        canal.postMessage({ tipo: "ENTRADA_EVENTO_ATUALIZADA", id, entradaRealizada: false });
      } catch(e) {}

      mostrarNotificacaoTatica(`↩️ Entrada de ${r.nome} reaberta na portaria.`);
    }

    function excluirReservaEvento(id) {
      const reservas = obterReservasEventos();
      const idx = reservas.findIndex(r => r.id == id);
      if (idx === -1) return;

      if (!confirm(`Deseja realmente remover a reserva de ${reservas[idx].nome}?`)) return;

      reservas.splice(idx, 1);
      salvarReservasEventos(reservas);
      carregarRelatorioEventos();
      atualizarVisibilidadeReservasAlmoco();
      mostrarNotificacaoTatica("Reserva excluída com sucesso.");
    }

    function enviarConfirmacaoWhatsReserva(id) {
      const reservas = obterReservasEventos();
      const r = reservas.find(item => item.id == id);
      if (!r) return;

      const tel = (r.tel || '').replace(/\D/g, '');
      const statusTxt = r.statusPagamento === 'PAGO' ? '✅ PAGAMENTO CONFIRMADO' : 'â³ PAGAMENTO PENDENTE';
      const msg = 
`*COMISSÃO DOS VETERANOS DO 5º BE CMB BLD*
_Comprovante de Reserva Oficial_

Olá *${r.grad || 'Veterano'} ${r.nome}* (${r.cia || '5º BE'})!

Confirmamos a sua reserva nos eventos dos Veteranos:
`🍲 *Tradicional Feijoada dos Veteranos:* ${r.qtdAlmocos || 1} refeição(ões) (R$ ${(r.valorTotal || ((r.qtdAlmocos || 1)*50)).toFixed(2).replace('.',',')})\n${r.acompanhantes ? `👥 *Acompanhantes:* ${r.acompanhantes}\n` : '}`
*Situação:* ${statusTxt}
${r.statusPagamento !== 'PAGO' ? '\nChave PIX: veteranos5be@gmail.com\n_Por favor envie o comprovante após a transferência._\n' : ''}
Qualquer dúvida, estamos à disposição. Brasil Acima de Tudo! 🇧🇷`;

      const url = tel.length >= 10 
        ? `https://api.whatsapp.com/send?phone=55${tel}&text=${encodeURIComponent(msg)}`
        : `https://api.whatsapp.com/send?text=${encodeURIComponent(msg)}`;
      window.open(url, '_blank');
    }

    function exportarRelatorioAlmocoCSV() {
      const reservas = obterReservasEventos();
      let csv = "\uFEFFData;Posto/Grad;Nome Completo;Nome Guerra;Companhia;Turma;Telefone;Qtd Almocos;Valor Total (R$);Acompanhantes;Forma Pagamento;Status Pagamento;Observacoes\n";

      reservas.forEach(r => {
        const d = r.dataHora ? new Date(r.dataHora).toLocaleString('pt-BR') : '';
        const linha = [
          `"${d}"`,
          `"${r.grad || ''}"`,
          `"${r.nome || ''}"`,
          `"${r.guerra || ''}"`,
          `"${r.cia || ''}"`,
          `"${r.turma || ''}"`,
          `"${r.tel || ''}"`,
          r.qtdAlmocos || 1,
          r.valorTotal ? r.valorTotal.toFixed(2) : '50.00',
          `"${(r.acompanhantes || '').replace(/"/g, '""')}"`,
          `"${r.formaPagamento || ''}"`,
          `"${r.statusPagamento || 'PENDENTE'}"`,
          `"${(r.obs || '').replace(/"/g, '""')}"`
        ];
        csv += linha.join(';') + "\n";
      });

      triggerDownload(csv, "relatorio_almoco_e_eventos_5be.csv", "text/csv;charset=utf-8;");
      mostrarNotificacaoTatica("Planilha CSV do Almoço e Eventos baixada com sucesso!");
    }

    function imprimirListaPortaria() {
      const reservas = obterReservasEventos();
      const apenasAlmoco = reservas.filter(r => r.vaiAlmoco);

      // Ordena por nome
      apenasAlmoco.sort((a,b) => (a.nome || '').localeCompare(b.nome || ''));

      let totalPessoas = apenasAlmoco.reduce((acc, c) => acc + (parseInt(c.qtdAlmocos) || 1), 0);
      let totalValor = apenasAlmoco.reduce((acc, c) => acc + (parseFloat(c.valorTotal) || 50), 0);

      let janela = window.open('', '_blank');
      let html = `
        <!DOCTYPE html>
        <html>
        <head>
          <meta charset="UTF-8">
          <title>Lista de Recepção e Portaria - Almoço dos Veteranos 5º BE</title>
          <style>
            body { font-family: Arial, sans-serif; margin: 20px; color: #111; }
            h1 { font-size: 18px; margin: 0; text-transform: uppercase; }
            h2 { font-size: 13px; margin: 3px 0 15px 0; color: #444; }
            table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 11px; }
            th, td { border: 1px solid #333; padding: 6px; text-align: left; }
            th { background-color: #eee; font-weight: bold; text-transform: uppercase; }
            .badge-pago { color: #047857; font-weight: bold; }
            .badge-pendente { color: #b45309; font-weight: bold; }
            .resumo-box { margin-bottom: 15px; padding: 10px; background: #f9f9f9; border: 1px solid #ccc; font-size: 12px; }
            @media print {
              button { display: none; }
              body { margin: 10mm; }
            }
          </style>
        </head>
        <body>
          <div style="display:flex; justify-content:space-between; align-items:center;">
            <div>
              <h1>Comissão dos Veteranos do 5º BE Cmb Bld</h1>
              <h2>Lista Oficial de Recepção & Portaria - Almoço de Confraternização (Feijoada)</h2>
            </div>
            <button onclick="window.print()" style="padding: 8px 16px; font-weight:bold; cursor:pointer;">🖨️ Imprimir Lista</button>
          </div>
          
          <div class="resumo-box">
            <strong>Total de Famílias / Titulares:</strong> ${apenasAlmoco.length} &nbsp;|&nbsp;
            <strong>Total de Almoços / Refeições:</strong> ${totalPessoas} &nbsp;|&nbsp;
            <strong>Previsão de Arrecadação:</strong> R$ ${totalValor.toLocaleString('pt-BR', {minimumFractionDigits: 2})}
          </div>

          <table>
            <thead>
              <tr>
                <th style="width:30px; text-align:center;">Nº</th>
                <th>Veterano (Grad / Guerra / Nome)</th>
                <th>Companhia / Ano</th>
                <th style="text-align:center; width:50px;">Qtd Alm.</th>
                <th>Acompanhantes / Família</th>
                <th style="text-align:center; width:90px;">Pagamento</th>
                <th style="width:130px;">Assinatura / Visto</th>
              </tr>
            </thead>
            <tbody>
              ${apenasAlmoco.map((r, i) => `
                <tr>
                  <td style="text-align:center;">${i + 1}</td>
                  <td><strong>${r.grad || 'Sd'} ${r.guerra ? r.guerra + ' - ' : ''}</strong>${r.nome}</td>
                  <td>${r.cia || ''} ${r.turma ? '(' + r.turma + ')' : ''}</td>
                  <td style="text-align:center; font-weight:bold; font-size:12px;">${r.qtdAlmocos || 1}</td>
                  <td style="font-size:10px;">${r.acompanhantes || '-'}</td>
                  <td style="text-align:center;">
                    <span class="${r.statusPagamento === 'PAGO' ? 'badge-pago' : 'badge-pendente'}">
                      ${r.statusPagamento === 'PAGO' ? 'PAGO ✅' : 'PENDENTE â³'}
                    </span>
                  </td>
                  <td></td>
                </tr>
              `).join('')}
            </tbody>
          </table>
        </body>
        </html>
      `;
      janela.document.write(html);
      janela.document.close();
    }

    function limparFiltrosEventos() {
      const elE = document.getElementById('filtroEventoAdmin');
      const elP = document.getElementById('filtroStatusPagamentoAdmin');
      const elC = document.getElementById('filtroCiaEventoAdmin');
      const elB = document.getElementById('buscaEventoAdmin');
      if (elE) elE.value = 'TODOS';
      if (elP) elP.value = 'TODOS';
      if (elC) elC.value = 'TODAS';
      if (elB) elB.value = '';
      filtrarTabelaEventos();
    }

    // Modal Reserva Manual
    function abrirModalReservaManual() {
      document.getElementById('modalReservaManual').classList.remove('hidden');
      atualizarTotalManualAlmoco();
    }
    function fecharModalReservaManual() {
      document.getElementById('modalReservaManual').classList.add('hidden');
    }
    function toggleManualAlmoco() {
      const chk = document.getElementById('manualVaiAlmoco');
      const bloco = document.getElementById('blocoManualAlmoco');
      if (chk.checked) bloco.classList.remove('hidden');
      else bloco.classList.add('hidden');
    }
    function toggleManualDesfile() { /* desfile desativado */ }
    function atualizarTotalManualAlmoco() {
      const qtd = parseInt(document.getElementById('manualQtdAlmocos').value) || 1;
      const total = qtd * 50;
      document.getElementById('manualValorTotal').value = `R$ ${total.toFixed(2).replace('.', ',')}`;
    }
    function salvarReservaManual(event) {
      event.preventDefault();

      const qtd = parseInt(document.getElementById('manualQtdAlmocos').value) || 1;
      const nova = {
        id: Date.now(),
        dataHora: new Date().toISOString(),
        nome: document.getElementById('manualNome').value.trim(),
        guerra: document.getElementById('manualGuerra').value.trim().toUpperCase(),
        grad: document.getElementById('manualGrad').value,
        cia: document.getElementById('manualCia').value,
        tel: document.getElementById('manualTel').value.trim(),
        ano: (document.getElementById('manualAno')?.value || '').trim(),
        turma: (document.getElementById('manualAno')?.value || '').trim(),
        vaiAlmoco: true,
        qtdAlmocos: qtd,
        valorUnitario: 50,
        valorTotal: qtd * 50,
        acompanhantes: document.getElementById('manualAcompanhantes').value.trim(),
        formaPagamento: document.getElementById('manualFormaPagamento').value,
        statusPagamento: document.getElementById('manualStatusPagamento').value,
        vaiDesfile: false,
        modalidadeDesfile: '',
        obs: document.getElementById('manualObs').value.trim()
      };

      const lista = obterReservasEventos();
      lista.unshift(nova);
      salvarReservasEventos(lista);
      fecharModalReservaManual();
      carregarRelatorioEventos();
      atualizarVisibilidadeReservasAlmoco();
      mostrarNotificacaoTatica(`Reserva manual de ${nova.nome} cadastrada com sucesso!`);
    }

    // Ações dos Links Oficiais (Aba Links)
    function copiarLinkEventos() {
      const campo = document.getElementById('campoLinkEventos');
      campo.select();
      navigator.clipboard.writeText(campo.value).then(() => {
        mostrarNotificacaoTatica("Link do Portal de Eventos copiado!");
      });
    }

    function copiarConviteEventos() {
      const texto = document.getElementById('textoConviteEventos').value;
      navigator.clipboard.writeText(texto).then(() => {
        mostrarNotificacaoTatica("Mensagem de convite de Eventos copiada!");
      });
    }

    function compartilharEventosWhatsApp() {
      const texto = document.getElementById('textoConviteEventos').value;
      window.open(`https://api.whatsapp.com/send?text=${encodeURIComponent(texto)}`, '_blank');
    }
  
    // ==========================================
    // DEFINIÃ‡Ã•ES E LÃ“GICA DO GRÃFICO EM PIZZA
    // ==========================================
    const DEFINICAO_CIAS_GRAFICO = [
      { id: "1_CIA", match: "1ª Cia", label: "1ª Cia Eng Cmb Bld", cor: "#f59e0b", animal: "Leão 🦁", icone: "animal_leao.svg" },
      { id: "2_CIA", match: "2ª Cia", label: "2ª Cia Eng Cmb Bld", cor: "#10b981", animal: "Onça ðŸ†", icone: "animal_onca.svg" },
      { id: "CEP", match: "CEP", label: "Cia Eng Pontes (CEP)", cor: "#06b6d4", animal: "Ãguia 🦅", icone: "animal_aguia.svg" },
      { id: "CCAP", match: "CCAp", label: "Cia Cmdo e Ap (CCAp)", cor: "#a855f7", animal: "Pantera ðŸ¾", icone: "animal_pantera.svg" },
      { id: "EM", match: "Estado-Maior", label: "Estado-Maior", cor: "#f97316", animal: "Comando 🎖️", icone: "" },
      { id: "NPOR", match: "NPOR", label: "NPOR", cor: "#64748b", animal: "Oficiais 🎓", icone: "" }
    ];

    let escopoGraficoAtual = 'FEIJOADA';

    function mudarEscopoGrafico(escopo) {
      atualizarGraficoPizzaEventos(obterReservasEventos());
    }

    function atualizarGraficoPizzaEventos(reservas) {
      // Filtra pelo escopo do gráfico
      const filtrados = (reservas || []).filter(r => {
        if (escopoGraficoAtual === 'ALMOCO') return r.vaiAlmoco;
        return r.vaiAlmoco !== false;
      });

      // Total de participantes no escopo
      const totalParticipantes = filtrados.length;

      // Agrupa por Companhia
      const dadosCias = DEFINICAO_CIAS_GRAFICO.map(def => {
        const membros = filtrados.filter(r => {
          const c = (r.cia || '').toLowerCase();
          const m = def.match.toLowerCase();
          return c.includes(m);
        });
        const qtd = membros.length;
        const refeicoes = membros.reduce((acc, cur) => acc + (cur.vaiAlmoco ? (parseInt(cur.qtdAlmocos) || 1) : 0), 0);
        const pct = totalParticipantes > 0 ? ((qtd / totalParticipantes) * 100).toFixed(1) : "0.0";
        return {
          ...def,
          qtd,
          refeicoes,
          pct: parseFloat(pct)
        };
      });

      // Renderiza SVG do Gráfico de Pizza
      renderizarGraficoPizzaSVG(dadosCias, totalParticipantes);

      // Renderiza a Legenda Detalhada
      renderizarLegendaGraficoPizza(dadosCias, totalParticipantes);

      const lblResumo = document.getElementById('lblResumoTotalGrafico');
      if (lblResumo) {
        lblResumo.textContent = `Total no escopo: ${totalParticipantes} veterano(s)`;
      }
    }

    function renderizarGraficoPizzaSVG(dadosCias, total) {
      const svg = document.getElementById('svgGraficoPizza');
      if (!svg) return;

      const cx = 140;
      const cy = 140;
      const r = 115;

      if (!total || total === 0) {
        svg.innerHTML = `
          <circle cx="${cx}" cy="${cy}" r="${r}" fill="#0d1810" stroke="#1f3622" stroke-width="2" />
          <text x="${cx}" y="${cy}" text-anchor="middle" dominant-baseline="middle" fill="#64748b" font-size="12" font-weight="bold" font-family="Rajdhani">
            NENHUM PARTICIPANTE
          </text>
        `;
        return;
      }

      const ciasComDados = dadosCias.filter(c => c.qtd > 0);

      // Caso especial: apenas 1 Cia com 100%
      if (ciasComDados.length === 1) {
        const c = ciasComDados[0];
        svg.innerHTML = `
          <circle cx="${cx}" cy="${cy}" r="${r}" fill="${c.cor}" stroke="#0a120b" stroke-width="3" class="cursor-pointer hover:opacity-90" onclick="filtrarCiaPeloGrafico('${c.label}')">
            <title>${c.label} (${c.animal}): 100% (${c.qtd} veteranos)</title>
          </circle>
          <text x="${cx}" y="${cy - 8}" text-anchor="middle" dominant-baseline="middle" fill="#ffffff" font-size="22" font-weight="900" font-family="Rajdhani" style="text-shadow: 0 2px 4px rgba(0,0,0,0.8); pointer-events:none;">
            100%
          </text>
          <text x="${cx}" y="${cy + 16}" text-anchor="middle" dominant-baseline="middle" fill="#ffffff" font-size="11" font-weight="bold" font-family="Rajdhani" style="text-shadow: 0 1px 3px rgba(0,0,0,0.8); pointer-events:none;">
            ${c.label}
          </text>
        `;
        return;
      }

      let startAngle = 0;
      let svgElements = '';

      dadosCias.forEach(c => {
        if (c.qtd <= 0) return;

        const sliceAngle = (c.qtd / total) * 360;
        const endAngle = startAngle + sliceAngle;
        const pctStr = c.pct.toFixed(1) + '%';

        // Trigonometria de coordenadas
        const rad = (deg) => (deg - 90) * Math.PI / 180.0;
        const x1 = cx + r * Math.cos(rad(startAngle));
        const y1 = cy + r * Math.sin(rad(startAngle));
        const x2 = cx + r * Math.cos(rad(endAngle));
        const y2 = cy + r * Math.sin(rad(endAngle));
        const largeArc = sliceAngle > 180 ? 1 : 0;

        const pathD = `M ${cx} ${cy} L ${x1.toFixed(2)} ${y1.toFixed(2)} A ${r} ${r} 0 ${largeArc} 1 ${x2.toFixed(2)} ${y2.toFixed(2)} Z`;

        // Posição do rótulo de porcentagem
        const midAngle = startAngle + (sliceAngle / 2);
        const labelR = r * 0.68;
        const lx = cx + labelR * Math.cos(rad(midAngle));
        const ly = cy + labelR * Math.sin(rad(midAngle));

        svgElements += `
          <g class="pie-slice cursor-pointer transition-transform duration-200 hover:scale-[1.02] origin-center" onclick="filtrarCiaPeloGrafico('${c.label}')">
            <path d="${pathD}" fill="${c.cor}" stroke="#070d08" stroke-width="2.5">
              <title>${c.label} (${c.animal}): ${pctStr} (${c.qtd} veteranos / ${c.refeicoes} almoços)</title>
            </path>
            ${sliceAngle >= 16 ? `
              <text x="${lx.toFixed(2)}" y="${ly.toFixed(2)}" text-anchor="middle" dominant-baseline="middle" 
                    fill="#ffffff" font-size="${sliceAngle > 35 ? '12' : '10'}" font-weight="900" 
                    font-family="Rajdhani" style="text-shadow: 0 1px 4px rgba(0,0,0,0.9); pointer-events:none;">
                ${pctStr}
              </text>
            ` : ''}
          </g>
        `;

        startAngle = endAngle;
      });

      svg.innerHTML = svgElements;
    }

    function renderizarLegendaGraficoPizza(dadosCias, total) {
      const container = document.getElementById('legendaGraficoPizza');
      if (!container) return;

      let html = '';
      dadosCias.forEach(c => {
        const pctStr = c.pct.toFixed(1) + '%';
        html += `
          <div class="p-2.5 bg-[#09110a] hover:bg-[#122315] rounded-xl border border-[#1b3420] hover:border-amber-500/50 transition-all cursor-pointer flex flex-col sm:flex-row sm:items-center justify-between gap-2 shadow-sm"
               onclick="filtrarCiaPeloGrafico('${c.label}')" title="Clique para filtrar apenas ${c.label}">
            <div class="flex items-center space-x-2.5 min-w-[210px]">
              <span class="w-3.5 h-3.5 rounded-full flex-shrink-0 shadow-sm" style="background-color: ${c.cor}"></span>
              <div>
                <span class="text-xs font-bold text-slate-100 uppercase military-font block leading-tight">${c.label}</span>
                <span class="text-[10px] text-slate-400 font-semibold">${c.animal}</span>
              </div>
            </div>
            
            <div class="flex items-center justify-between sm:justify-end space-x-4 sm:space-x-6 flex-1 text-xs font-mono">
              <div class="text-slate-300">
                <span class="text-white font-bold">${c.qtd}</span> <span class="text-[10px] text-slate-400">vet.</span>
              </div>
              <div class="text-amber-400">
                <span class="text-amber-300 font-bold">${c.refeicoes}</span> <span class="text-[10px] text-slate-400">alm.</span>
              </div>
              <div class="w-20 text-right">
                <span class="px-2 py-0.5 rounded text-xs font-black military-font tracking-wider shadow inline-block" 
                      style="background-color: ${c.cor}22; color: ${c.cor}; border: 1px solid ${c.cor}55;">
                  ${pctStr}
                </span>
              </div>
            </div>
          </div>
        `;
      });

      container.innerHTML = html;
    }

    function filtrarCiaPeloGrafico(cia) {
      const sel = document.getElementById('filtroCiaEventoAdmin');
      if (sel) {
        if (cia.includes('1ª Cia')) sel.value = '1ª Cia';
        else if (cia.includes('2ª Cia')) sel.value = '2ª Cia';
        else if (cia.includes('CEP') || cia.includes('Pontes')) sel.value = 'CEP';
        else if (cia.includes('CCAp') || cia.includes('Cmdo')) sel.value = 'CCAp';
        else if (cia.includes('Estado-Maior')) sel.value = 'EM';
        else if (cia.includes('NPOR')) sel.value = 'NPOR';
        else sel.value = 'TODAS';
        filtrarTabelaEventos();
        mostrarNotificacaoTatica(`Filtro aplicado: ${cia}`);
        const tbl = document.getElementById('tbodyRelatorioEventos');
        if (tbl) tbl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    }

    // ==========================================
    // EXPORTAÃ‡ÃƒO DA LISTA: NOMES, CIA E ANO
    // ==========================================
    let modoVisualizacaoExpAtual = 'tabela';

    function abrirModalExportarNomesCiaAno() {
      document.getElementById('modalExportarNomesCiaAno').classList.remove('hidden');
      atualizarPreviewListaNomesCiaAno();
    }

    function fecharModalExportarNomesCiaAno() {
      document.getElementById('modalExportarNomesCiaAno').classList.add('hidden');
    }

    function alternarModoVisualizacaoExp(modo) {
      modoVisualizacaoExpAtual = modo;
      const boxTabela = document.getElementById('boxExpTabela');
      const boxTexto = document.getElementById('boxExpTexto');
      const btnTab = document.getElementById('btnModoTabelaExp');
      const btnTxt = document.getElementById('btnModoTextoExp');

      if (modo === 'tabela') {
        boxTabela.classList.remove('hidden');
        boxTexto.classList.add('hidden');
        btnTab.className = "px-2.5 py-1 rounded bg-emerald-700 text-white text-[11px] font-bold";
        btnTxt.className = "px-2.5 py-1 rounded bg-[#162719] text-slate-300 text-[11px] font-bold";
      } else {
        boxTabela.classList.add('hidden');
        boxTexto.classList.remove('hidden');
        btnTxt.className = "px-2.5 py-1 rounded bg-emerald-700 text-white text-[11px] font-bold";
        btnTab.className = "px-2.5 py-1 rounded bg-[#162719] text-slate-300 text-[11px] font-bold";
      }
    }

    function obterListaFiltradaNomesCiaAno() {
      const reservas = obterReservasEventos();
      const fPag = document.getElementById('modalExpFiltroEvento')?.value || 'TODOS';
      const fCia = document.getElementById('modalExpFiltroCia')?.value || 'TODAS';
      const fBusca = (document.getElementById('modalExpBusca')?.value || '').toLowerCase().trim();

      return reservas.filter(r => {
        if (fPag === 'PAGO' && r.statusPagamento !== 'PAGO') return false;
        if (fPag === 'PENDENTE' && r.statusPagamento === 'PAGO') return false;

        if (fCia !== 'TODAS' && (!r.cia || !r.cia.includes(fCia))) return false;

        if (fBusca) {
          const matchNome = (r.nome || '').toLowerCase().includes(fBusca);
          const matchGuerra = (r.guerra || '').toLowerCase().includes(fBusca);
          const matchAno = (r.ano || r.turma || '').toString().includes(fBusca);
          if (!matchNome && !matchGuerra && !matchAno) return false;
        }

        return true;
      });
    }

    function atualizarPreviewListaNomesCiaAno() {
      const lista = obterListaFiltradaNomesCiaAno();

      // Atualiza contadores
      const totalAlmocos = lista.reduce((acc, cur) => acc + (cur.vaiAlmoco ? (parseInt(cur.qtdAlmocos) || 1) : 0), 0);
      const elCont = document.getElementById('modalExpContagem');
      const elAlm = document.getElementById('modalExpAlmocosSpan');
      if (elCont) elCont.textContent = `${lista.length} veteranos`;
      if (elAlm) elAlm.textContent = `(${totalAlmocos} almoços)`;

      // Preenche Tabela
      const tbody = document.getElementById('tbodyModalExpNomesCiaAno');
      if (tbody) {
        tbody.innerHTML = '';
        if (lista.length === 0) {
          tbody.innerHTML = `<tr><td colspan="6" class="p-4 text-center text-slate-500">Nenhum veterano encontrado com os filtros atuais.</td></tr>`;
        } else {
          lista.forEach((r, idx) => {
            const tr = document.createElement('tr');
            tr.className = "hover:bg-[#122216]/60 transition-colors border-b border-[#16291a]";

            let eventosBadge = [];
            if (r.vaiAlmoco) eventosBadge.push(`<span class="px-1.5 py-0.5 bg-amber-950/80 text-amber-300 border border-amber-600/40 rounded text-[10px] font-bold">ðŸ½ï¸ ${r.qtdAlmocos || 1} alm.</span>`);

            tr.innerHTML = `
              <td class="py-2.5 px-3 text-center text-slate-400 font-mono">${idx + 1}</td>
              <td class="py-2.5 px-3 font-bold text-white">
                ${r.nome}
                ${r.guerra ? `<span class="ml-1 text-emerald-400 font-mono text-[11px]">(${r.guerra})</span>` : ''}
              </td>
              <td class="py-2.5 px-3 font-mono text-amber-400">${r.grad || 'Sd'}</td>
              <td class="py-2.5 px-3 font-semibold text-slate-200">${r.cia || '5º BE'}</td>
              <td class="py-2.5 px-3 text-center">
                <span class="px-2 py-0.5 bg-amber-950/70 border border-amber-500/40 rounded text-amber-300 font-mono font-bold text-xs">
                  ${r.ano || r.turma || '--'}
                </span>
              </td>
              <td class="py-2.5 px-3 text-center space-x-1">${eventosBadge.join(' ')}</td>
            `;
            tbody.appendChild(tr);
          });
        }
      }

      // Preenche Texto Formatado
      const txtArea = document.getElementById('txtAreaListaFormatada');
      if (txtArea) {
        let txt = `*LISTA OFICIAL DE PARTICIPANTES - EVENTOS 5º BE*\n` +
                  `_Comissão dos Veteranos - Batalhão Juarez Távora_\n` +
                  `Total: ${lista.length} militares | Total de Almoços: ${totalAlmocos}\n\n`;

        lista.forEach((r, i) => {
          const num = (i + 1).toString().padStart(2, '0');
          const anoStr = r.ano || r.turma || 'S/A';
          let evs = [];
          if (r.vaiAlmoco) evs.push(`Almoço: ${r.qtdAlmocos || 1}`);
          txt += `${num}. ${r.grad || 'Sd'} ${r.guerra ? r.guerra + ' - ' : ''}${r.nome} | ${r.cia || '5º BE'} | Ano: ${anoStr} [${evs.join(' | ')}]\n`;
        });

        txtArea.value = txt;
      }
    }

    function copiarListaNomesCiaAno() {
      const txtArea = document.getElementById('txtAreaListaFormatada');
      if (!txtArea || !txtArea.value) return;

      navigator.clipboard.writeText(txtArea.value).then(() => {
        mostrarNotificacaoTatica("📋 Lista de Nome, Cia e Ano copiada com sucesso!");
      });
    }

    function baixarListaNomesCiaAnoCSV() {
      const lista = obterListaFiltradaNomesCiaAno();
      let csv = "\uFEFFNº;Nome Completo;Nome de Guerra;Posto/Grad;Companhia;Ano de Incorporação;Qtd Refeicoes;Status Pagamento\n";

      lista.forEach((r, idx) => {
        const linha = [
          idx + 1,
          `"${r.nome || ''}"`,
          `"${r.guerra || ''}"`,
          `"${r.grad || ''}"`,
          `"${r.cia || ''}"`,
          `"${r.ano || r.turma || ''}"`,
          r.qtdAlmocos || 1,
          `"${r.statusPagamento || 'PENDENTE'}"`
        ];
        csv += linha.join(';') + "\n";
      });

      triggerDownload(csv, "lista_participantes_nome_cia_ano_5be.csv", "text/csv;charset=utf-8;");
      mostrarNotificacaoTatica("Planilha CSV (Nome, Cia, Ano) baixada com sucesso!");
    }

    function baixarListaNomesCiaAnoTXT() {
      const txtArea = document.getElementById('txtAreaListaFormatada');
      if (!txtArea || !txtArea.value) return;

      triggerDownload(txtArea.value, "lista_participantes_nome_cia_ano_5be.txt", "text/plain;charset=utf-8;");
      mostrarNotificacaoTatica("Arquivo TXT (Nome, Cia, Ano) baixado com sucesso!");
    }

    function imprimirListaNomesCiaAno() {
      const lista = obterListaFiltradaNomesCiaAno();
      const totalAlmocos = lista.reduce((acc, cur) => acc + (cur.vaiAlmoco ? (parseInt(cur.qtdAlmocos) || 1) : 0), 0);

      let janela = window.open('', '_blank');
      let html = `
        <!DOCTYPE html>
        <html>
        <head>
          <meta charset="UTF-8">
          <title>Lista de Participantes (Nome, Cia e Ano) - Veteranos 5º BE</title>
          <style>
            body { font-family: Arial, sans-serif; margin: 20px; color: #111; }
            h1 { font-size: 18px; margin: 0; text-transform: uppercase; }
            h2 { font-size: 13px; margin: 3px 0 15px 0; color: #444; }
            table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 11px; }
            th, td { border: 1px solid #333; padding: 6px; text-align: left; }
            th { background-color: #eee; font-weight: bold; text-transform: uppercase; }
            .resumo-box { margin-bottom: 15px; padding: 10px; background: #f9f9f9; border: 1px solid #ccc; font-size: 12px; }
            @media print {
              button { display: none; }
              body { margin: 10mm; }
            }
          </style>
        </head>
        <body>
          <div style="display:flex; justify-content:space-between; align-items:center;">
            <div>
              <h1>Comissão dos Veteranos do 5º BE Cmb Bld</h1>
              <h2>Lista Oficial de Participantes â€” Nome, Companhia & Ano</h2>
            </div>
            <button onclick="window.print()" style="padding: 8px 16px; font-weight:bold; cursor:pointer;">🖨️ Imprimir Lista</button>
          </div>
          
          <div class="resumo-box">
            <strong>Total de Militares:</strong> ${lista.length} &nbsp;|&nbsp;
            <strong>Total de Almoços / Refeições:</strong> ${totalAlmocos}
          </div>

          <table>
            <thead>
              <tr>
                <th style="width:30px; text-align:center;">Nº</th>
                <th>Nome Completo do Militar</th>
                <th style="width:70px;">Posto/Grad</th>
                <th style="width:80px;">Guerra</th>
                <th>Companhia</th>
                <th style="text-align:center; width:65px;">Ano / Turma</th>
                <th style="width:140px;">Refeições (Feijoada)</th>
              </tr>
            </thead>
            <tbody>
              ${lista.map((r, i) => `
                <tr>
                  <td style="text-align:center;">${i + 1}</td>
                  <td><strong>${r.nome}</strong></td>
                  <td>${r.grad || 'Sd'}</td>
                  <td>${r.guerra || '-'}</td>
                  <td>${r.cia || '5º BE'}</td>
                  <td style="text-align:center; font-weight:bold;">${r.ano || r.turma || '--'}</td>
                  <td style="font-size:10px;">
                    ${r.vaiAlmoco ? 'ðŸ½ï¸ Almoço (' + (r.qtdAlmocos || 1) + ') ' : ''}
                  </td>
                </tr>
              `).join('')}
            </tbody>
          </table>
        </body>
        </html>
      `;
      janela.document.write(html);
      janela.document.close();
    }
    // ==========================================
    // CONTROLE DE LIBERAÇÃO DE RESERVAS DE ALMOÇO
    // ==========================================
    function isReservasAlmocoLiberadas() {
      return localStorage.getItem('reservas_almoco_liberadas') === 'true';
    }

    function alternarLiberacaoReservasAlmoco() {
      const atual = isReservasAlmocoLiberadas();
      const novo = !atual;
      localStorage.setItem('reservas_almoco_liberadas', novo ? 'true' : 'false');

      try {
        const canal = new BroadcastChannel('veteranos_5be_sync');
        canal.postMessage({ tipo: 'STATUS_RESERVAS_ALMOCO_ALTERADO', liberado: novo });
      } catch(e) {}

      atualizarVisibilidadeReservasAlmoco();

      if (novo) {
        mostrarNotificacaoTatica("🔓 Reservas de Almoço LIBERADAS! O link agora aparece na página inicial e no cadastro.");
      } else {
        mostrarNotificacaoTatica("🔒 Reservas de Almoço BLOQUEADAS! O link foi ocultado da página inicial e do cadastro.");
      }
    }

    function atualizarVisibilidadeReservasAlmoco() {
      const liberado = isReservasAlmocoLiberadas();

      // 1. Link público na barra de navegação da página inicial
      const linkPub = document.getElementById('linkReservarAlmocoPub');
      if (linkPub) {
        if (liberado) {
          linkPub.classList.remove('hidden');
        } else {
          linkPub.classList.add('hidden');
        }
      }

      // 2. Banner de controle na Aba Relatório da Feijoada
      const boxControle = document.getElementById('boxControleLiberacaoAlmoco');
      const iconControle = document.getElementById('iconStatusLiberacaoAlmoco');
      const tituloControle = document.getElementById('tituloStatusLiberacaoAlmoco');
      const subControle = document.getElementById('subtextoStatusLiberacaoAlmoco');
      const btnToggle = document.getElementById('btnToggleLiberacaoAlmoco');

      if (boxControle && btnToggle) {
        if (liberado) {
          boxControle.className = "mt-4 p-4 rounded-xl border border-emerald-500/50 bg-[#0c1c10] flex flex-col sm:flex-row items-center justify-between gap-3 shadow transition-all";
          if (iconControle) {
            iconControle.className = "w-10 h-10 rounded-xl bg-emerald-500/20 border border-emerald-500/60 text-emerald-400 flex items-center justify-center text-lg flex-shrink-0 shadow";
            iconControle.innerHTML = '<i class="fa-solid fa-unlock"></i>';
          }
          if (tituloControle) {
            tituloControle.className = "text-xs sm:text-sm font-black uppercase military-font text-emerald-300";
            tituloControle.textContent = "🔓 Reservas Liberadas ao Público (Visível na Página Inicial e no Cadastro)";
          }
          if (subControle) {
            subControle.textContent = "Os veteranos podem acessar livremente o formulário de reserva da Feijoada.";
          }
          btnToggle.className = "px-4 py-2.5 rounded-lg text-xs font-black military-font uppercase flex items-center shadow-lg transition-all bg-red-950 hover:bg-red-900 text-red-300 border border-red-700/60 flex-shrink-0";
          btnToggle.innerHTML = '<i class="fa-solid fa-lock mr-1.5"></i> Bloquear / Ocultar Reservas';
        } else {
          boxControle.className = "mt-4 p-4 rounded-xl border border-amber-500/50 bg-[#161208] flex flex-col sm:flex-row items-center justify-between gap-3 shadow transition-all";
          if (iconControle) {
            iconControle.className = "w-10 h-10 rounded-xl bg-amber-500/20 border border-amber-500/60 text-amber-400 flex items-center justify-center text-lg flex-shrink-0 shadow";
            iconControle.innerHTML = '<i class="fa-solid fa-lock"></i>';
          }
          if (tituloControle) {
            tituloControle.className = "text-xs sm:text-sm font-black uppercase military-font text-amber-300";
            tituloControle.textContent = "🔒 Reservas Bloqueadas (Oculto na Página Inicial e no Cadastro)";
          }
          if (subControle) {
            subControle.textContent = "O link está oculto do público. Libere para que apareça na página inicial e no cadastro.";
          }
          btnToggle.className = "px-4 py-2.5 rounded-lg text-xs font-black military-font uppercase flex items-center shadow-lg transition-all bg-emerald-700 hover:bg-emerald-600 text-white flex-shrink-0";
          btnToggle.innerHTML = '<i class="fa-solid fa-unlock mr-1.5"></i> Liberar Reservas para o Público';
        }
      }

      // 3. Card 2 na Aba Links
      const badgeCard = document.getElementById('badgeCardStatusAlmoco');
      const btnCardToggle = document.getElementById('btnCardToggleAlmoco');
      if (badgeCard && btnCardToggle) {
        if (liberado) {
          badgeCard.className = "px-2.5 py-1 rounded text-[10px] font-black military-font uppercase bg-emerald-950 text-emerald-300 border border-emerald-500/60";
          badgeCard.innerHTML = '<i class="fa-solid fa-unlock mr-1 text-emerald-400"></i> Liberado na Página Inicial e Cadastro';
          btnCardToggle.className = "px-3 py-1 rounded text-[10px] font-bold military-font uppercase bg-red-950/80 hover:bg-red-900 text-red-300 border border-red-700/50";
          btnCardToggle.innerHTML = '<i class="fa-solid fa-lock mr-1"></i> Bloquear Acesso Público';
        } else {
          badgeCard.className = "px-2.5 py-1 rounded text-[10px] font-black military-font uppercase bg-amber-950 text-amber-300 border border-amber-500/60";
          badgeCard.innerHTML = '<i class="fa-solid fa-lock mr-1 text-amber-400"></i> Oculto na Página Inicial e Cadastro';
          btnCardToggle.className = "px-3 py-1 rounded text-[10px] font-bold military-font uppercase bg-emerald-700 hover:bg-emerald-600 text-white";
          btnCardToggle.innerHTML = '<i class="fa-solid fa-unlock mr-1"></i> Liberar na Página Inicial';
        }
      }
    }

    // Ouvinte de sincronização entre abas
    try {
      const canalAlmoco = new BroadcastChannel('veteranos_5be_sync');
      canalAlmoco.addEventListener('message', (ev) => {
        if (ev.data && ev.data.tipo === 'STATUS_RESERVAS_ALMOCO_ALTERADO') {
          atualizarVisibilidadeReservasAlmoco();
        }
      });
    } catch(e) {}

    window.addEventListener('storage', (e) => {
      if (e.key === 'reservas_almoco_liberadas') {
        atualizarVisibilidadeReservasAlmoco();
      }
    });
  
  </script>
</body>
</html>

    <!-- SEÇÃO 4: EXPORTAÇÃO PERSONALIZADA POR COMPANHIA -->
    <section id="aba-exportar" class="hidden space-y-6">
      
      <div class="tactical-card rounded-xl p-6 border-l-4 border-l-blue-500">
        
        <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
          <div>
            <h2 class="text-2xl font-extrabold military-font gold-gradient uppercase flex items-center">
              <i class="fa-solid fa-download text-blue-400 mr-2.5"></i>
              Central de Exportação por Companhia
            </h2>
            <p class="text-xs text-slate-400 mt-1 max-w-2xl">
              Exporte os integrantes filtrados por subunidade militar em planilhas Excel (CSV), contatos para celular (VCF), Google Contatos, ou listas limpas apenas com Nomes ou Telefones.
            </p>
          </div>
          <span class="px-3 py-1 bg-blue-950/60 border border-blue-500/40 rounded text-xs font-bold text-blue-400 military-font">
            DOWNLOAD INSTANTÂNEO
          </span>
        </div>

        <!-- PAINEL INTERATIVO DE ESCOLHA DA COMPANHIA -->
        <div class="p-5 bg-[#0e1810] rounded-xl border border-[#254228] mb-6 space-y-4">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-center">
            
            <div class="md:col-span-2">
              <label class="block text-xs font-bold text-amber-400 uppercase military-font tracking-wider mb-1.5">
                <i class="fa-solid fa-building-flag mr-1"></i> Selecione a Companhia ou Escopo de Exportação:
              </label>
              <select id="seletorCiaExportar" onchange="atualizarInfoExportacao()"
                      class="w-full px-3.5 py-2.5 bg-[#080e0a] border border-[#2a482e] rounded-lg text-sm text-slate-100 font-semibold focus:outline-none focus:border-amber-400 transition-all">
                <option value="ATUAL" selected>⭐ Companhia Ativa no Painel (<span id="txtCiaAtivaSpan">Todas</span>)</option>
                <option value="1º Cia Eng Cmb Bld">1ª Cia Eng Cmb Bld — 🦁 Leão (146 integrantes)</option>
                <option value="2º Cia Eng Cmb Bld">2ª Cia Eng Cmb Bld — 🐆 Onça (162 integrantes)</option>
                <option value="Cia Cmdo e Ap - (CCAp)">Cia Cmdo e Apoio - CCAp — 🐾 Pantera (148 integrantes)</option>

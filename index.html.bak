    <!-- SEÇÃO NOVA: RELATÓRIO DE EVENTOS, ALMOÇO & 7 DE SETEMBRO -->
    <section id="aba-eventos" class="hidden space-y-6">
      
      <!-- Cabeçalho Tático do Relatório de Eventos -->
      <div class="tactical-card rounded-xl p-6 border-l-4 border-l-amber-500">
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
          <div>
            <div class="inline-flex items-center space-x-2 px-3 py-1 bg-amber-950/60 border border-amber-600/50 rounded-full text-xs font-bold text-amber-400 military-font tracking-widest uppercase mb-2">
              <i class="fa-solid fa-utensils"></i> Gestão de Inscrições & Finanças
            </div>
            <h2 class="text-2xl font-extrabold military-font gold-gradient uppercase flex items-center">
              <i class="fa-solid fa-clipboard-check text-amber-400 mr-2.5"></i>
              Relatório Oficial: Tradicional Feijoada dos Veteranos
            </h2>
            <p class="text-xs text-slate-400 mt-1 max-w-3xl leading-relaxed">
              Controle completo de reservas do reservas da Tradicional Feijoada dos Veteranos (número de refeições para o titular e familiares), confirmações de pagamento antecipado via PIX, e exportação da caserna.
            </p>
          </div>
          
          <div class="flex flex-wrap items-center gap-2 self-start lg:self-auto">
                        <button onclick="abrirModalExportarNomesCiaAno()"
                    class="px-3.5 py-2.5 bg-gradient-to-r from-amber-600 via-amber-500 to-yellow-500 hover:from-amber-500 hover:to-yellow-400 text-slate-950 font-extrabold rounded-lg text-xs military-font uppercase flex items-center shadow-lg transition-all transform active:scale-95">
              <i class="fa-solid fa-file-lines mr-1.5 font-bold"></i> Exportar Lista (Nome, Cia, Ano)
            </button>
            <button onclick="abrirModalReservaManual()"
                    class="px-3.5 py-2.5 bg-amber-600 hover:bg-amber-500 text-slate-950 font-bold rounded-lg text-xs military-font uppercase flex items-center shadow-lg transition-all transform active:scale-95">
              <i class="fa-solid fa-plus mr-1.5 font-bold"></i> + Reserva Manual
            </button>
            <button onclick="exportarRelatorioAlmocoCSV()"
                    class="px-3.5 py-2.5 bg-emerald-700 hover:bg-emerald-600 text-white font-bold rounded-lg text-xs military-font uppercase flex items-center shadow transition-all">
              <i class="fa-solid fa-file-excel mr-1.5"></i> Baixar CSV (Excel)
            </button>
            <button onclick="imprimirListaPortaria()"
                    class="px-3.5 py-2.5 bg-[#1b3420] hover:bg-[#254b2d] text-emerald-300 font-bold rounded-lg text-xs military-font uppercase flex items-center border border-[#2d5832] transition-all">
              <i class="fa-solid fa-print mr-1.5"></i> Imprimir Lista Recepção
            </button>
            <button onclick="carregarRelatorioEventos()" title="Recarregar Dados"
                    class="p-2.5 bg-[#0e1810] hover:bg-[#18291c] text-slate-300 hover:text-white rounded-lg text-xs border border-[#223b26] transition-all">
              <i class="fa-solid fa-arrows-rotate text-amber-400"></i>
            </button>
          </div>
        </div>

        <!-- Painel de Liberação das Reservas para o Público / Página Inicial -->
        <div id="boxControleLiberacaoAlmoco" class="mt-4 p-4 rounded-xl border border-amber-500/50 bg-[#161208] flex flex-col sm:flex-row items-center justify-between gap-3 shadow transition-all">
          <div class="flex items-center space-x-3">
            <div id="iconStatusLiberacaoAlmoco" class="w-10 h-10 rounded-xl bg-amber-500/20 border border-amber-500/60 text-amber-400 flex items-center justify-center text-lg flex-shrink-0 shadow">
              <i class="fa-solid fa-lock"></i>
            </div>
            <div>
              <span class="text-[10px] text-slate-400 font-bold uppercase military-font block">Controle das Reservas de Almoço:</span>
              <div id="tituloStatusLiberacaoAlmoco" class="text-xs sm:text-sm font-black uppercase military-font text-amber-300">
                🔒 Reservas Bloqueadas (Oculto na Página Inicial e no Cadastro)
              </div>
              <p id="subtextoStatusLiberacaoAlmoco" class="text-[11px] text-slate-400 mt-0.5">
                O link está oculto do público. Libere para que apareça na página inicial e no link de cadastro.
              </p>
            </div>
          </div>
          <button id="btnToggleLiberacaoAlmoco" onclick="alternarLiberacaoReservasAlmoco()"
                  class="px-4 py-2.5 rounded-lg text-xs font-black military-font uppercase flex items-center shadow-lg transition-all bg-emerald-700 hover:bg-emerald-600 text-white flex-shrink-0">
            <i class="fa-solid fa-unlock mr-1.5"></i> Liberar Reservas para o Público
          </button>
        </div>

        <!-- 5 Cards de Métricas e KPIs (Refeições, Famílias, Arrecadação, Pagamentos, Portaria) -->
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3.5 mt-6">
          
          <!-- Card 1: Total de Refeições / Almoços -->
          <div class="p-4 bg-[#0a140c] rounded-xl border border-amber-500/40 relative overflow-hidden">
            <div class="flex items-center justify-between mb-1">
              <span class="text-[10px] text-amber-400 font-bold uppercase military-font tracking-wider">Total de Refeições</span>
              <i class="fa-solid fa-utensils text-amber-400/80 text-sm"></i>
            </div>
            <div id="kpiTotalAlmocos" class="text-2xl sm:text-3xl font-black text-amber-300 military-font">0 refeições</div>
            <p class="text-[10px] text-slate-400 mt-0.5">Veteranos + Familiares</p>
          </div>

          <!-- Card 2: Famílias / Reservas Cadastradas -->
          <div class="p-4 bg-[#0a140c] rounded-xl border border-emerald-500/40 relative overflow-hidden">
            <div class="flex items-center justify-between mb-1">
              <span class="text-[10px] text-emerald-400 font-bold uppercase military-font tracking-wider">Famílias Reservadas</span>
              <i class="fa-solid fa-people-roof text-emerald-400/80 text-sm"></i>
            </div>
            <div id="kpiTotalFamilias" class="text-2xl sm:text-3xl font-black text-emerald-300 military-font">0 famílias</div>
            <p class="text-[10px] text-slate-400 mt-0.5">Cadastros individuais</p>
          </div>

          <!-- Card 3: Arrecadação Total Prevista -->
          <div class="p-4 bg-[#0a140c] rounded-xl border border-green-500/40 relative overflow-hidden">
            <div class="flex items-center justify-between mb-1">
              <span class="text-[10px] text-green-400 font-bold uppercase military-font tracking-wider">Arrecadação Total</span>
              <i class="fa-solid fa-brazilian-real-sign text-green-400/80 text-sm"></i>
            </div>
            <div id="kpiTotalArrecadacao" class="text-2xl sm:text-3xl font-black text-green-300 military-font">R$ 0,00</div>
            <p class="text-[10px] text-slate-400 mt-0.5">R$ 50,00 por pessoa</p>
          </div>

          <!-- Card 4: Pagamentos Confirmados vs Pendentes -->
          <div class="p-4 bg-[#0a140c] rounded-xl border border-[#233f27] relative overflow-hidden">
            <div class="flex items-center justify-between mb-1">
              <span class="text-[10px] text-slate-300 font-bold uppercase military-font tracking-wider">Situação Pagamentos</span>
              <i class="fa-solid fa-receipt text-slate-400 text-sm"></i>
            </div>
            <div class="space-y-1 mt-1 text-[11px] font-mono">
              <div class="flex justify-between items-center text-emerald-400 font-bold">
                <span><i class="fa-solid fa-circle-check text-[9px] mr-1"></i> Pagos:</span>
                <span id="kpiQtdPagos">0 (R$ 0)</span>
              </div>
              <div class="flex justify-between items-center text-amber-400 font-bold">
                <span><i class="fa-solid fa-clock text-[9px] mr-1"></i> Pendentes:</span>
                <span id="kpiQtdPendentes">0 (R$ 0)</span>
              </div>
            </div>
          </div>

          <!-- Card 5: Controle da Portaria / Entradas Realizadas -->
          <div class="p-4 bg-[#0a140c] rounded-xl border border-blue-500/40 relative overflow-hidden col-span-2 sm:col-span-1 shadow">
            <div class="flex items-center justify-between mb-1">
              <span class="text-[10px] text-blue-400 font-bold uppercase military-font tracking-wider">Entrada no Almoço</span>
              <i class="fa-solid fa-door-open text-blue-400/80 text-sm"></i>
            </div>
            <div id="kpiTotalEntradas" class="text-2xl sm:text-3xl font-black text-blue-300 military-font">0 / 0</div>
            <p id="kpiEntradasSubtext" class="text-[10px] text-slate-400 mt-0.5">0 presentes confirmados</p>
          </div>


        </div>

      </div>

            <!-- SEÃ‡ÃƒO DO GRÃFICO EM PIZZA: PORCENTAGEM DAS COMPANHIAS DOS PARTICIPANTES -->
      <div class="tactical-card rounded-xl p-5 sm:p-6 border-l-4 border-l-amber-500 space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-[#1f3722] pb-4">
          <div>
            <div class="inline-flex items-center space-x-1.5 text-amber-400 font-bold military-font uppercase text-[11px] tracking-wider mb-1">
              <i class="fa-solid fa-chart-pie"></i>
              <span>Estatística Visual dos Eventos</span>
            </div>
            <h3 class="text-lg sm:text-xl font-black military-font text-white uppercase flex items-center">
              <i class="fa-solid fa-chart-pie text-amber-400 mr-2"></i>
              Gráfico em Pizza: Porcentagem por Companhia (%)
            </h3>
            <p class="text-xs text-slate-400 mt-0.5">
              Distribuição proporcional dos inscritos na Tradicional Feijoada entre as Companhias do 5º BE.
            </p>
          </div>

          <!-- Filtro rápido de escopo do Gráfico -->
          <!-- Selo informativo do Gráfico -->
          <div class="flex items-center bg-[#070e08] px-3 py-1.5 rounded-lg border border-amber-500/50 self-start sm:self-auto text-xs font-bold military-font uppercase text-amber-300 shadow">
            <i class="fa-solid fa-utensils mr-1.5 text-amber-400"></i>
            Tradicional Feijoada dos Veteranos
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center pt-1">
          
          <!-- Coluna da Esquerda: Gráfico de Pizza SVG -->
          <div class="lg:col-span-5 flex flex-col items-center justify-center p-4 bg-[#08100a] rounded-xl border border-[#1d3521] relative min-h-[300px]">
            <div class="relative w-64 h-64 sm:w-72 sm:h-72 flex items-center justify-center">
              <svg id="svgGraficoPizza" viewBox="0 0 280 280" class="w-full h-full filter drop-shadow-[0_4px_18px_rgba(0,0,0,0.7)]">
                <!-- Fatias geradas dinamicamente via JS -->
              </svg>
            </div>
            
            <p class="text-[11px] text-slate-400 mt-3 text-center">
              💡 <span class="text-amber-400 font-semibold">Passe o mouse</span> na fatia para detalhes ou <span class="text-emerald-400 font-semibold">clique</span> para filtrar a tabela.
            </p>
          </div>

          <!-- Coluna da Direita: Tabela Legenda com Mascotes, Quantidade, Almoços e Porcentagens -->
          <div class="lg:col-span-7 space-y-2.5">
            <div class="flex items-center justify-between text-xs font-bold military-font text-slate-300 uppercase px-1 pb-1 border-b border-[#1b3420]">
              <span>Companhia / Mascote</span>
              <div class="flex items-center space-x-6">
                <span>Inscritos</span>
                <span>Refeições</span>
                <span class="w-16 text-right">Porcentagem</span>
              </div>
            </div>

            <div id="legendaGraficoPizza" class="space-y-2">
              <!-- Gerado dinamicamente via JS -->
            </div>

            <div class="pt-2 border-t border-[#1b3420] flex items-center justify-between text-xs text-slate-400 font-mono">
              <span id="lblResumoTotalGrafico">Total de participantes: 0 veteranos</span>
              <span class="text-amber-400 font-bold">100% do efetivo participante</span>
            </div>
          </div>

        </div>
      </div>
      <!-- Barra de Filtros e Busca Rápida -->
      <div class="tactical-card rounded-xl p-4 space-y-3">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
          
          <!-- Filtro por Evento -->
          <div>
            <label class="block text-[11px] font-semibold text-slate-300 uppercase mb-1">Tipo de Evento:</label>
            <select id="filtroEventoAdmin" onchange="filtrarTabelaEventos()"
                    class="w-full px-3 py-2 bg-[#09110a] border border-[#233f26] rounded-lg text-xs font-semibold text-amber-300">
              <option value="TODOS">Todos os Inscritos</option>
              <option value="ALMOCO">Inscritos na Feijoada</option>
            </select>
          </div>

          <!-- Filtro por Status do Pagamento -->
          <div>
            <label class="block text-[11px] font-semibold text-slate-300 uppercase mb-1">Status do Pagamento:</label>
            <select id="filtroStatusPagamentoAdmin" onchange="filtrarTabelaEventos()"
                    class="w-full px-3 py-2 bg-[#09110a] border border-[#233f26] rounded-lg text-xs font-semibold text-emerald-300">
              <option value="TODOS">Todos os Status (Pagos e Pendentes)</option>
              <option value="PAGO">🟢 Apenas Pagos / Confirmados (Lista do Almoço)</option>
              <option value="ENTRADA_PENDENTE">🚪 Pagos: Aguardando Entrada na Portaria</option>
              <option value="ENTRADA_CONCLUIDA">✅ Pagos: Entrada Finalizada na Portaria</option>
              <option value="PENDENTE">⏳ Apenas Pagamentos Pendentes</option>
            </select>
          </div>

          <!-- Filtro por Companhia -->
          <div>
            <label class="block text-[11px] font-semibold text-slate-300 uppercase mb-1">Subunidade / Cia:</label>
            <select id="filtroCiaEventoAdmin" onchange="filtrarTabelaEventos()"
                    class="w-full px-3 py-2 bg-[#09110a] border border-[#233f26] rounded-lg text-xs text-slate-200">
              <option value="TODAS">Todas as Companhias</option>
              <option value="1ª Cia">1ª Cia Eng Cmb Bld</option>
              <option value="2ª Cia">2ª Cia Eng Cmb Bld</option>
              <option value="CEP">Cia Eng Pontes (CEP)</option>
              <option value="CCAp">Cia Cmdo e Apoio (CCAp)</option>
              <option value="EM">Estado-Maior</option>
              <option value="NPOR">NPOR</option>
            </select>
          </div>

          <!-- Campo de Busca -->
          <div>
            <label class="block text-[11px] font-semibold text-slate-300 uppercase mb-1">Buscar por Nome / Telefone:</label>
            <div class="relative">
              <input type="text" id="buscaEventoAdmin" oninput="filtrarTabelaEventos()"
                     placeholder="Nome, guerra, telefone, familiar..."
                     class="w-full pl-8 pr-3 py-2 bg-[#09110a] border border-[#233f26] rounded-lg text-xs text-slate-100 placeholder-slate-500">
              <i class="fa-solid fa-search absolute left-2.5 top-2.5 text-slate-500 text-xs"></i>
            </div>
          </div>

        </div>

        <div class="flex items-center justify-between pt-2 border-t border-[#1b3420] text-xs">
          <span class="text-slate-400">
            Exibindo <strong id="lblQtdFiltradaEventos" class="text-amber-400">0</strong> reservas (<strong id="lblQtdAlmocosFiltrados" class="text-emerald-400">0</strong> almoços no filtro)
          </span>
          <button onclick="limparFiltrosEventos()" class="text-slate-400 hover:text-amber-400 text-[11px] font-bold uppercase military-font">
            <i class="fa-solid fa-filter-circle-xmark mr-1"></i> Limpar Filtros
          </button>
        </div>
      </div>

      <!-- Tabela Principal de Reservas e Pagamentos -->
      <div class="tactical-card rounded-xl overflow-hidden border border-[#1f3722]">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs border-collapse">
            <thead class="bg-[#09120a] border-b border-[#233f26] text-slate-300 font-bold military-font uppercase">
              <tr>
                <th class="py-3 px-3">Data / Hora</th>
                <th class="py-3 px-3">Veterano (Militar)</th>
                <th class="py-3 px-3">Contato WhatsApp</th>
                <th class="py-3 px-3 text-center">Feijoada & Família</th>
                <th class="py-3 px-3 text-center">Status Pagamento</th>
                <th class="py-3 px-3 text-center">Portaria (Entrada no Almoço)</th>
                <th class="py-3 px-3 text-right">Ações</th>
              </tr>
            </thead>
            <tbody id="tbodyRelatorioEventos" class="divide-y divide-[#16291a] text-slate-200 font-sans">
              <!-- Preenchido dinamicamente via JS -->
            </tbody>
          </table>
        </div>

        <div id="semReservasEventos" class="hidden p-8 text-center text-slate-400 space-y-2">
          <i class="fa-solid fa-calendar-xmark text-3xl text-amber-500/50"></i>
          <p class="font-bold military-font text-sm text-slate-300 uppercase">Nenhuma reserva encontrada</p>
          <p class="text-xs">Nenhum registro corresponde aos filtros selecionados ou nenhuma reserva foi realizada ainda.</p>
        </div>
      </div>

    </section>

    <!-- SEÇÃO 2: CENTRAL DE MENSAGENS WHATSAPP -->
    <section id="aba-mensagens" class="hidden space-y-6">
      
      <div class="tactical-card rounded-xl p-6 border-l-4 border-l-green-500">
        <div class="flex items-center justify-between mb-4">
          <div>
            <h2 class="text-2xl font-extrabold military-font gold-gradient uppercase">
              <i class="fa-brands fa-whatsapp text-green-400 mr-2"></i> Central de Disparo de Mensagens
            </h2>
            <p class="text-xs text-slate-400 mt-0.5">
              Envie comunicados oficiais, convites para encontros e recadastramento personalizados para cada veterano.
            </p>
          </div>
          <span class="px-3 py-1 bg-green-950/60 border border-green-500/40 rounded text-xs font-bold text-green-400 military-font">
            DISPARO VIA WHATSAPP WEB
          </span>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          
          <!-- Coluna 1 & 2: Compositor de Mensagem -->
          <div class="lg:col-span-2 space-y-4">
            
            <!-- Modelos Pré-Prontos -->
            <div>
              <label class="block text-xs font-bold text-slate-300 uppercase military-font mb-1.5">
                Modelos de Mensagem Sugeridos:
              </label>
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                <button onclick="carregarModelo('encontro')"
                        class="p-2 bg-[#172719] hover:bg-[#203723] border border-[#2b4b2e] rounded text-left text-xs text-slate-200 transition-all">
                  <span class="font-bold text-amber-400 block military-font uppercase">🍽️ Encontro Anual</span>
                  <span class="text-[10px] text-slate-400">Almoço e confraternização</span>
                </button>
                <button onclick="carregarModelo('cadastro')"
                        class="p-2 bg-[#172719] hover:bg-[#203723] border border-[#2b4b2e] rounded text-left text-xs text-slate-200 transition-all">
                  <span class="font-bold text-amber-400 block military-font uppercase">📝 Recadastramento</span>
                  <span class="text-[10px] text-slate-400">Atualização de dados</span>
                </button>
                <button onclick="carregarModelo('aviso')"
                        class="p-2 bg-[#172719] hover:bg-[#203723] border border-[#2b4b2e] rounded text-left text-xs text-slate-200 transition-all">
                  <span class="font-bold text-amber-400 block military-font uppercase">📢 Comunicado</span>
                  <span class="text-[10px] text-slate-400">Aviso geral da diretoria</span>
                </button>
                <button onclick="carregarModelo('festas')"
                        class="p-2 bg-[#172719] hover:bg-[#203723] border border-[#2b4b2e] rounded text-left text-xs text-slate-200 transition-all">
                  <span class="font-bold text-amber-400 block military-font uppercase">🎉 Boas Festas</span>
                  <span class="text-[10px] text-slate-400">Votos aos veteranos</span>
                </button>
              </div>
            </div>

            <!-- Editor de Texto da Mensagem -->
            <div>
              <div class="flex items-center justify-between mb-1.5">
                <label class="text-xs font-bold text-slate-300 uppercase military-font">
                  Texto da Mensagem:
                </label>
                <!-- Tags Variáveis -->
                <div class="flex items-center space-x-1.5 text-[11px]">
                  <span class="text-slate-400 text-xs">Variáveis:</span>
                  <button type="button" onclick="inserirTag('{posto}')" class="px-1.5 py-0.5 bg-[#1e3422] hover:bg-[#28482e] text-emerald-400 rounded font-mono font-bold">{posto}</button>
                  <button type="button" onclick="inserirTag('{nome}')" class="px-1.5 py-0.5 bg-[#1e3422] hover:bg-[#28482e] text-emerald-400 rounded font-mono font-bold">{nome}</button>
                  <button type="button" onclick="inserirTag('{guerra}')" class="px-1.5 py-0.5 bg-[#1e3422] hover:bg-[#28482e] text-emerald-400 rounded font-mono font-bold">{guerra}</button>
                  <button type="button" onclick="inserirTag('{companhia}')" class="px-1.5 py-0.5 bg-[#1e3422] hover:bg-[#28482e] text-emerald-400 rounded font-mono font-bold">{companhia}</button>
                </div>
              </div>

              <textarea id="textoMensagemWhatsApp" rows="7" oninput="atualizarPreviewMensagem()"
                        class="w-full p-3 bg-[#0a140c] border border-[#264429] rounded-lg text-sm text-slate-100 placeholder-slate-500 focus:outline-none focus:border-green-400 font-sans leading-relaxed custom-scroll"></textarea>
            </div>

            <!-- Filtro de Destinatários para Disparo -->
            <div class="flex flex-wrap items-center justify-between gap-3 p-3 bg-[#0c160e] rounded-lg border border-[#203623]">
              <div>
                <span class="text-xs text-slate-400 block">Destinatários do Disparo:</span>
                <span id="labelDestinatarios" class="text-sm font-bold text-amber-400 military-font uppercase">
                  Todas as Companhias (658 Integrantes)
                </span>
              </div>
              <div class="flex items-center space-x-2">
                <button onclick="copiarTelefonesDestinatarios()"
                        class="px-3 py-1.5 bg-[#1e3522] hover:bg-[#28482e] text-slate-200 rounded text-xs font-semibold">
                  <i class="fa-solid fa-copy mr-1 text-amber-400"></i> Copiar Telefones
                </button>
                <button onclick="copiarEmailsDestinatarios()"
                        class="px-3 py-1.5 bg-[#1e3522] hover:bg-[#28482e] text-slate-200 rounded text-xs font-semibold">
                  <i class="fa-solid fa-envelope mr-1 text-amber-400"></i> Copiar E-mails
                </button>
              </div>
            </div>

          </div>

          <!-- Coluna 3: Pré-visualização da Mensagem -->
          <div class="space-y-4">
            <label class="block text-xs font-bold text-slate-300 uppercase military-font">
              Pré-visualização no WhatsApp:
            </label>
            
            <div class="bg-[#0b141a] rounded-xl p-4 border border-[#1f2c34] text-slate-100 relative shadow-inner">
              <div class="flex items-center space-x-2 pb-2 mb-3 border-b border-[#1f2c34]">
                <div class="w-8 h-8 rounded-full bg-emerald-700 flex items-center justify-center font-bold text-xs text-white">
                  5BE
                </div>
                <div>
                  <div class="text-xs font-bold text-slate-200">Comissão dos Veteranos 5º BE</div>
                  <div class="text-[10px] text-emerald-400">Online</div>
                </div>
              </div>

              <!-- Bolha da Mensagem -->
              <div class="bg-[#005c4b] text-white p-3 rounded-lg rounded-tl-none text-xs leading-relaxed whitespace-pre-wrap font-sans" id="previewMsgContainer">
                <!-- Conteúdo do preview -->
              </div>
              <div class="text-[9px] text-right text-slate-400 mt-1">10:00 ✔️✔️</div>
            </div>

            <!-- Dica de Envio -->
            <div class="p-3 bg-amber-950/40 border border-amber-600/40 rounded-lg text-xs text-amber-300 leading-normal">
              <i class="fa-solid fa-circle-info mr-1 text-amber-400"></i>
              <strong>Como funciona o disparo:</strong>  
              O sistema abre o WhatsApp Web para cada veterano com o texto e o nome dele já prontos. Basta clicar em enviar!
            </div>
          </div>

        </div>

        <!-- Fila de Disparo Facilitador -->
        <div class="mt-8 pt-6 border-t border-[#233f26]">
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-bold military-font text-white uppercase flex items-center">
              <i class="fa-solid fa-list-check text-emerald-400 mr-2"></i> Fila de Envio Individual / Por Companhia
            </h3>
            <div class="text-xs text-slate-400">

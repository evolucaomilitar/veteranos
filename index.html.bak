    const MODELOS_MENSAGENS = {
      encontro: `Prezado {posto} {guerra} ({nome}), saudações blindadas!\n\nA Comissão dos Veteranos do 5º BE Cmb Bld convida você e sua família para o nosso tradicional Encontro e Almoço de Confraternização dos Veteranos.\n\n📅 Data: A confirmar\n📍 Local: Porto União - SC\n🏢 Subunidade: {companhia}\n\nContamos com sua presença para reviver as boas lembranças de caserna! Por favor, confirme seu número por aqui.\n\n_Comissão dos Veteranos do 5º BE Cmb Bld_`,
      cadastro: `Prezado Veterano {posto} {guerra}!\n\nEstamos atualizando os dados cadastrais da nossa gloriosa {companhia} (5º BE Cmb Bld - Batalhão Juarez Távora). Pedimos a gentileza de confirmar ou atualizar suas informações pelo link oficial:\n\n👉 Acesse o formulário: cadastro.html\n\nBrasil Acima de Tudo!`,
      aviso: `Atenção Veteranos do 5º BE Cmb Bld!\n\nComunicado Oficial da Comissão dos Veteranos para os integrantes da {companhia}:\n\nInformamos que as novidades e calendários do semestre já estão disponíveis. Favor manter seus contatos atualizados conosco.\n\nUm forte abraço aos veteranos!`,
      festas: `Prezado {posto} {guerra}!\n\nA Comissão dos Veteranos do 5º BE Cmb Bld deseja a você e à sua família um Feliz Natal e um Ano Novo repleto de saúde, vitórias e fraternidade!\n\nFoi uma honra servir ao seu lado na Engenharia Blindada. Selva! 🇧🇷`
    };

    function carregarModelo(chave) {
      if (MODELOS_MENSAGENS[chave]) {
        document.getElementById('textoMensagemWhatsApp').value = MODELOS_MENSAGENS[chave];
        atualizarPreviewMensagem();
      }
    }

    function inserirTag(tag) {
      const area = document.getElementById('textoMensagemWhatsApp');
      const start = area.selectionStart;
      const end = area.selectionEnd;
      const text = area.value;
      area.value = text.substring(0, start) + tag + text.substring(end);
      area.focus();
      area.selectionEnd = start + tag.length;
      atualizarPreviewMensagem();
    }

    function atualizarPreviewMensagem() {
      let texto = document.getElementById('textoMensagemWhatsApp').value;
      texto = texto
        .replace(/{posto}/g, 'Sgt')
        .replace(/{nome}/g, 'Aclair Machado Dias')
        .replace(/{guerra}/g, 'ACLAIR')
        .replace(/{companhia}/g, 'Cia Cmdo e Ap - (CCAp)');

      document.getElementById('previewMsgContainer').innerText = texto;
    }

    // Fila de Disparo
    function atualizarFilaDisparo(listaFiltrada) {
      let lista = listaFiltrada;
      if (!lista) {
        if (selecionadosIDs.size > 0) {
          lista = integrantedAtuais.filter(i => selecionadosIDs.has(i.id));
          document.getElementById('labelDestinatarios').innerText = `Apenas Contatos Selecionados (${lista.length} Integrantes)`;
        } else if (ciaAtiva !== 'TODAS' && ciaAtiva !== 'NOVOS') {
          lista = integrantedAtuais.filter(i => i.cia === ciaAtiva);
          document.getElementById('labelDestinatarios').innerText = `${ciaAtiva} (${lista.length} Integrantes)`;
        } else {
          lista = [...integrantedAtuais];
          document.getElementById('labelDestinatarios').innerText = `Todas as Companhias (${lista.length} Integrantes)`;
        }
      }

      const tbody = document.getElementById('filaDisparo');
      tbody.innerHTML = '';

      let enviadosCount = 0;

      lista.forEach(item => {
        const isEnviado = statusEnvios[item.id] || false;
        if (isEnviado) enviadosCount++;

        const dialNumber = item.telDial || (item.tel || '').replace(/\D/g, '');

        const tr = document.createElement('tr');
        tr.className = `border-b border-[#1b2f1d] ${isEnviado ? 'bg-emerald-950/20' : 'hover:bg-[#152518]'}`;

        tr.innerHTML = `
          <td class="p-2.5 text-center">
            ${isEnviado 
              ? '<span class="text-emerald-400 font-bold text-xs"><i class="fa-solid fa-circle-check"></i> Enviado</span>' 
              : '<span class="text-slate-500 font-bold text-xs"><i class="fa-regular fa-clock"></i> Pendente</span>'}
          </td>
          <td class="p-2.5 font-semibold text-slate-100">
            ${item.grad ? item.grad + ' ' : ''}${item.nome} <span class="text-amber-400 font-bold font-mono">(${item.guerra || ''})</span>
          </td>
          <td class="p-2.5 text-slate-300">${item.cia || '-'}</td>
          <td class="p-2.5 font-mono text-emerald-400">${item.tel || '-'}</td>
          <td class="p-2.5 text-center">
            <button onclick="dispararParaVeterano(${item.id}, '${dialNumber}', '${item.grad || ''}', '${item.nome.replace(/'/g, "\\'")}', '${item.guerra || ''}', '${item.cia || ''}', this)"
                    class="px-3 py-1.5 ${isEnviado ? 'bg-slate-700 text-slate-300' : 'bg-green-600 hover:bg-green-500 text-slate-950'} font-bold rounded text-xs military-font uppercase flex items-center justify-center mx-auto transition-all">
              <i class="fa-brands fa-whatsapp text-sm mr-1"></i> Abrir no WhatsApp
            </button>
          </td>
        `;
        tbody.appendChild(tr);
      });

      document.getElementById('progressoEnvio').innerText = `${enviadosCount} / ${lista.length}`;
    }

    function dispararParaVeterano(id, dialNumber, grad, nome, guerra, cia, btn) {
      let textoBase = document.getElementById('textoMensagemWhatsApp').value;
      const textoPersonalizado = textoBase
        .replace(/{posto}/g, grad)
        .replace(/{nome}/g, nome)
        .replace(/{guerra}/g, guerra || nome)
        .replace(/{companhia}/g, cia);

      const url = `https://api.whatsapp.com/send?phone=${dialNumber}&text=${encodeURIComponent(textoPersonalizado)}`;
      window.open(url, '_blank');

      statusEnvios[id] = true;
      btn.className = "px-3 py-1.5 bg-slate-700 text-slate-300 font-bold rounded text-xs military-font uppercase flex items-center justify-center mx-auto";
      atualizarFilaDisparo();
    }

    function copiarTelefonesDestinatarios() {
      const { lista } = obterListaParaExportacao();
      const tels = lista.map(i => i.tel).filter(t => t).join('\n');
      navigator.clipboard.writeText(tels).then(() => {
        alert(`✅ ${lista.length} telefones copiados para a área de transferência!`);
      });
    }

    function copiarEmailsDestinatarios() {
      const { lista } = obterListaParaExportacao();
      const emails = lista.map(i => i.email).filter(e => e && !e.includes('não informado')).join(', ');
      navigator.clipboard.writeText(emails).then(() => {
        alert(`✅ E-mails copiados com sucesso!`);
      });
    }


      <!-- MODAL: EXPORTAR LISTA DOS NOMES, CIA E ANO (EVENTOS) -->
  <div id="modalExportarNomesCiaAno" class="fixed inset-0 z-50 bg-black/85 backdrop-blur-md flex items-center justify-center p-3 sm:p-4 hidden">
    <div class="tactical-card max-w-4xl w-full rounded-2xl overflow-hidden border border-[#d4af37] shadow-[0_0_35px_rgba(212,175,55,0.35)] relative animate-fade-in max-h-[92vh] flex flex-col">
      
      <!-- Cabeçalho do Modal -->
      <div class="bg-gradient-to-r from-[#172b1a] via-[#102012] to-[#0f1b11] p-4 sm:p-5 border-b border-[#254228] flex items-center justify-between">
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 rounded-full bg-amber-950 border border-amber-500 flex items-center justify-center text-amber-400 text-lg font-bold">
            <i class="fa-solid fa-list-check"></i>
          </div>
          <div>
            <span class="text-[10px] text-amber-400 uppercase military-font font-bold tracking-widest block">Exportação Específica de Participantes</span>
            <h3 class="text-base sm:text-lg font-black text-white military-font uppercase leading-tight">Lista de Participantes: Nome, Companhia & Ano</h3>
          </div>
        </div>
        <button onclick="fecharModalExportarNomesCiaAno()" class="text-slate-400 hover:text-white text-xl p-1.5 rounded-lg hover:bg-[#1a2f1d]">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <!-- Barra de Filtros e Busca do Modal -->
      <div class="p-4 bg-[#0a140c] border-b border-[#1b3420] space-y-3">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <div>
            <label class="block text-[11px] font-semibold text-slate-300 uppercase mb-1">Filtrar Pagamento:</label>
            <select id="modalExpFiltroEvento" onchange="atualizarPreviewListaNomesCiaAno()"
                    class="w-full px-3 py-2 bg-[#060c07] border border-[#233f26] rounded-lg text-xs font-semibold text-amber-300">
              <option value="TODOS">Todos os Inscritos na Feijoada</option>
              <option value="PAGO">Apenas Pagos / Confirmados ✅</option>
              <option value="PENDENTE">⏳ Apenas Pagamentos Pendentes</option>
            </select>
          </div>
          <div>
            <label class="block text-[11px] font-semibold text-slate-300 uppercase mb-1">Filtrar por Companhia:</label>
            <select id="modalExpFiltroCia" onchange="atualizarPreviewListaNomesCiaAno()"
                    class="w-full px-3 py-2 bg-[#060c07] border border-[#233f26] rounded-lg text-xs text-slate-200">
              <option value="TODAS">Todas as Companhias</option>
              <option value="1ª Cia">1ª Cia Eng Cmb Bld (Leão 🦁)</option>
              <option value="2ª Cia">2ª Cia Eng Cmb Bld (Onça ðŸ†)</option>
              <option value="CEP">Cia Eng Pontes CEP (Ãguia 🦅)</option>
              <option value="CCAp">Cia Cmdo e Ap CCAp (Pantera ðŸ¾)</option>
              <option value="Estado-Maior">Estado-Maior (Comando 🎖️)</option>
              <option value="NPOR">NPOR (Oficiais 🎓)</option>
            </select>
          </div>
          <div>
            <label class="block text-[11px] font-semibold text-slate-300 uppercase mb-1">Buscar Nome, Guerra ou Ano:</label>
            <div class="relative">
              <input type="text" id="modalExpBusca" oninput="atualizarPreviewListaNomesCiaAno()"
                     placeholder="Digite o nome, guerra ou ano..."
                     class="w-full pl-8 pr-3 py-2 bg-[#060c07] border border-[#233f26] rounded-lg text-xs text-slate-100 placeholder-slate-500">
              <i class="fa-solid fa-search absolute left-2.5 top-2.5 text-slate-500 text-xs"></i>
            </div>
          </div>
        </div>

        <div class="flex items-center justify-between text-xs pt-1">
          <span class="text-slate-300 font-mono">
            Total selecionado: <strong id="modalExpContagem" class="text-amber-400 font-bold">0 veteranos</strong>
            <span id="modalExpAlmocosSpan" class="text-emerald-400 ml-2">(0 almoços)</span>
          </span>
          <div class="flex items-center space-x-1">
            <span class="text-[11px] text-slate-400">Modo de visualização:</span>
            <button id="btnModoTabelaExp" onclick="alternarModoVisualizacaoExp('tabela')"
                    class="px-2.5 py-1 rounded bg-emerald-700 text-white text-[11px] font-bold">Tabela</button>
            <button id="btnModoTextoExp" onclick="alternarModoVisualizacaoExp('texto')"
                    class="px-2.5 py-1 rounded bg-[#162719] text-slate-300 text-[11px] font-bold">Texto</button>
          </div>
        </div>
      </div>

      <!-- Ãrea de Visualização da Lista -->
      <div class="p-4 flex-1 overflow-y-auto custom-scroll space-y-3">
        
        <!-- Modo 1: Tabela Visual -->
        <div id="boxExpTabela" class="rounded-xl overflow-hidden border border-[#1f3722]">
          <div class="overflow-x-auto max-h-[360px]">
            <table class="w-full text-left text-xs border-collapse">
              <thead class="bg-[#09120a] border-b border-[#233f26] text-slate-300 font-bold military-font uppercase sticky top-0 z-10">
                <tr>
                  <th class="py-2.5 px-3 text-center w-12">Nº</th>
                  <th class="py-2.5 px-3">Nome Completo & Guerra</th>
                  <th class="py-2.5 px-3">Posto / Grad</th>
                  <th class="py-2.5 px-3">Companhia</th>
                  <th class="py-2.5 px-3 text-center">Ano (Turma)</th>
                  <th class="py-2.5 px-3 text-center">Refeições / Status</th>
                </tr>
              </thead>
              <tbody id="tbodyModalExpNomesCiaAno" class="divide-y divide-[#16291a] text-slate-200 font-sans">
                <!-- Preenchido dinamicamente -->
              </tbody>
            </table>
          </div>
        </div>

        <!-- Modo 2: Caixa de Texto Formatada (Pronta para Copiar) -->
        <div id="boxExpTexto" class="hidden">
          <textarea id="txtAreaListaFormatada" rows="12" readonly
                    class="w-full p-3 bg-[#060c07] border border-[#233f26] rounded-xl text-xs font-mono text-emerald-300 select-all custom-scroll"></textarea>
        </div>

      </div>

      <!-- Barra Inferior de Ações de Exportação -->
      <div class="p-4 bg-[#0a140c] border-t border-[#1b3420] flex flex-wrap items-center justify-between gap-2.5">
        <div class="text-[11px] text-slate-400">
          💡 Lista oficial contendo <strong>Nome, Companhia e Ano</strong> para exportação e impressão rápida.
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <button onclick="copiarListaNomesCiaAno()"
                  class="px-4 py-2.5 bg-gradient-to-r from-amber-600 to-amber-500 hover:from-amber-500 hover:to-amber-400 text-slate-950 font-black rounded-lg text-xs military-font uppercase flex items-center shadow transition-all">
            <i class="fa-solid fa-copy mr-1.5 text-sm"></i> Copiar Lista Formatada
          </button>
          <button onclick="baixarListaNomesCiaAnoCSV()"
                  class="px-4 py-2.5 bg-emerald-700 hover:bg-emerald-600 text-white font-bold rounded-lg text-xs military-font uppercase flex items-center shadow transition-all">
            <i class="fa-solid fa-file-excel mr-1.5"></i> Baixar .CSV
          </button>
          <button onclick="baixarListaNomesCiaAnoTXT()"
                  class="px-4 py-2.5 bg-[#172b1a] hover:bg-[#223d26] text-emerald-300 border border-[#2e5233] font-bold rounded-lg text-xs military-font uppercase flex items-center transition-all">
            <i class="fa-solid fa-file-lines mr-1.5"></i> Baixar .TXT
          </button>
          <button onclick="imprimirListaNomesCiaAno()"
                  class="px-4 py-2.5 bg-[#172b1a] hover:bg-[#223d26] text-slate-200 border border-[#2e5233] font-bold rounded-lg text-xs military-font uppercase flex items-center transition-all">
            <i class="fa-solid fa-print mr-1.5 text-amber-400"></i> Imprimir
          </button>
        </div>
      </div>

    </div>
  </div>
  <!-- MODAL: NOVA RESERVA MANUAL DE EVENTO (ADMIN) -->
  <div id="modalReservaManual" class="fixed inset-0 z-50 bg-black/85 backdrop-blur-md flex items-center justify-center p-4 hidden">
    <div class="tactical-card max-w-lg w-full rounded-2xl overflow-hidden border border-[#d4af37] shadow-[0_0_30px_rgba(212,175,55,0.3)] relative animate-fade-in max-h-[90vh] flex flex-col">
      <div class="bg-gradient-to-r from-[#172b1a] to-[#0f1b11] p-4 border-b border-[#254228] flex items-center justify-between">
        <div class="flex items-center space-x-3">
          <div class="w-9 h-9 rounded-full bg-amber-950 border border-amber-500 flex items-center justify-center text-amber-400 font-bold">
            <i class="fa-solid fa-calendar-plus"></i>
          </div>
          <div>
            <span class="text-[10px] text-amber-400 uppercase military-font font-bold tracking-widest block">Lançamento Direto</span>
            <h3 class="text-sm sm:text-base font-bold text-white military-font uppercase leading-tight">Cadastrar Reserva de Evento</h3>
          </div>
        </div>
        <button onclick="fecharModalReservaManual()" class="text-slate-400 hover:text-white text-xl p-1">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <form onsubmit="salvarReservaManual(event)" class="p-5 space-y-3.5 text-xs overflow-y-auto custom-scroll flex-1">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div class="sm:col-span-2">
            <label class="block text-[11px] font-semibold text-slate-300 uppercase mb-1">Nome Completo do Veterano <span class="text-red-400">*</span>:</label>
            <input type="text" id="manualNome" required placeholder="Ex: Valdir Pereira da Silva" class="w-full px-3 py-2 bg-[#09110a] border border-[#233f26] rounded-lg text-slate-100">
          </div>
          <div>
            <label class="block text-[11px] font-semibold text-slate-300 uppercase mb-1">Nome de Guerra:</label>
            <input type="text" id="manualGuerra" placeholder="Ex: SILVA" class="w-full px-3 py-2 bg-[#09110a] border border-[#233f26] rounded-lg text-slate-100">
          </div>
          <div>
            <label class="block text-[11px] font-semibold text-slate-300 uppercase mb-1">Graduação:</label>
            <select id="manualGrad" class="w-full px-3 py-2 bg-[#09110a] border border-[#233f26] rounded-lg text-slate-100">
              <option value="Sd">Soldado (Sd)</option>
              <option value="Cb">Cabo (Cb)</option>
              <option value="3º Sgt">3º Sargento</option>
              <option value="2º Sgt">2º Sargento</option>
              <option value="1º Sgt">1º Sargento</option>
              <option value="Subten">Subtenente</option>
              <option value="Oficial">Oficial / Aspirante</option>
            </select>
          </div>
          <div>
            <label class="block text-[11px] font-semibold text-slate-300 uppercase mb-1">Companhia:</label>
            <select id="manualCia" class="w-full px-3 py-2 bg-[#09110a] border border-[#233f26] rounded-lg text-slate-100">
              <option value="1ª Cia Eng Cmb Bld">1ª Cia Eng Cmb Bld</option>
              <option value="2ª Cia Eng Cmb Bld">2ª Cia Eng Cmb Bld</option>
              <option value="Cia Eng Pontes (CEP)">Cia Eng Pontes (CEP)</option>
              <option value="Cia Cmdo e Ap (CCAp)">Cia Cmdo e Apoio (CCAp)</option>
              <option value="Estado-Maior">Estado-Maior</option>
              <option value="NPOR">NPOR</option>
            </select>
          </div>
          <div>
            <label class="block text-[11px] font-semibold text-slate-300 uppercase mb-1">WhatsApp / Telefone <span class="text-red-400">*</span>:</label>
            <input type="text" id="manualTel" required placeholder="(42) 99999-0000" class="w-full px-3 py-2 bg-[#09110a] border border-[#233f26] rounded-lg text-slate-100">
          </div>
          <div>
            <label class="block text-[11px] font-semibold text-slate-300 uppercase mb-1">Ano de Incorporação / Turma <span class="text-red-400">*</span>:</label>
            <input type="number" id="manualAno" required min="1940" max="2030" placeholder="Ex: 1988" class="w-full px-3 py-2 bg-[#09110a] border border-[#233f26] rounded-lg text-amber-300 font-bold font-mono">
          </div>
        </div>

        <!-- Seção Almoço -->
        <div class="p-3 bg-[#0d1810] rounded-lg border border-[#203623] space-y-2.5">
          <label class="flex items-center space-x-2 cursor-pointer">
            <input type="checkbox" id="manualVaiAlmoco" checked onchange="toggleManualAlmoco()" class="w-4 h-4 text-emerald-600 rounded bg-[#09110a] border-[#2b4c2f]">
            <span class="font-bold text-amber-300 military-font uppercase text-xs">Participar do Almoço de Confraternização</span>
          </label>

          <div id="blocoManualAlmoco" class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 pt-1">
            <div>
              <label class="block text-[11px] font-semibold text-slate-300 uppercase mb-1">Quantidade de Almoços (Pessoas):</label>
              <input type="number" id="manualQtdAlmocos" min="1" max="20" value="1" onchange="atualizarTotalManualAlmoco()" class="w-full px-3 py-2 bg-[#09110a] border border-[#233f26] rounded-lg text-amber-300 font-bold">
            </div>
            <div>
              <label class="block text-[11px] font-semibold text-slate-300 uppercase mb-1">Valor Total (R$ 50/unid):</label>
              <input type="text" id="manualValorTotal" readonly value="R$ 50,00" class="w-full px-3 py-2 bg-[#060c07] border border-[#233f26] rounded-lg text-emerald-400 font-bold font-mono">
            </div>
            <div class="sm:col-span-2">
              <label class="block text-[11px] font-semibold text-slate-300 uppercase mb-1">Nomes dos Acompanhantes / Familiares:</label>
              <input type="text" id="manualAcompanhantes" placeholder="Ex: Esposa Maria e 2 filhos" class="w-full px-3 py-2 bg-[#09110a] border border-[#233f26] rounded-lg text-slate-200">
            </div>
            <div>
              <label class="block text-[11px] font-semibold text-slate-300 uppercase mb-1">Forma de Pagamento (Antecipado):</label>
              <select id="manualFormaPagamento" class="w-full px-3 py-2 bg-[#09110a] border border-[#233f26] rounded-lg text-slate-200">
                <option value="PIX_ANTECIPADO" selected>PIX Antecipado (Chave Oficial)</option>
              </select>
            </div>
            <div>
              <label class="block text-[11px] font-semibold text-slate-300 uppercase mb-1">Status Pagamento:</label>
              <select id="manualStatusPagamento" class="w-full px-3 py-2 bg-[#09110a] border border-[#233f26] rounded-lg font-bold text-amber-300">
                <option value="PENDENTE">â³ PENDENTE</option>
                <option value="PAGO">✅ PAGO / CONFIRMADO</option>
              </select>
            </div>
          </div>
        </div>


        <div>
          <label class="block text-[11px] font-semibold text-slate-300 uppercase mb-1">Observações:</label>
          <input type="text" id="manualObs" placeholder="Anotações internas..." class="w-full px-3 py-2 bg-[#09110a] border border-[#233f26] rounded-lg text-slate-200">
        </div>
        <div class="pt-2 flex justify-end space-x-2">
          <button type="button" onclick="fecharModalReservaManual()" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg text-xs font-bold military-font uppercase">
            Cancelar
          </button>
          <button type="submit" class="px-5 py-2 bg-emerald-600 hover:bg-emerald-500 text-slate-950 font-bold rounded-lg text-xs military-font uppercase shadow">
            Salvar Reserva
          </button>
        </div>
      </form>
    </div>
  </div>
  <!-- MODAL: LOGIN DO ADMINISTRADOR -->
  <div id="modalLoginAdmin" class="fixed inset-0 z-50 bg-black/85 backdrop-blur-md flex items-center justify-center p-4 hidden">
    <div class="tactical-card max-w-sm w-full rounded-2xl overflow-hidden border border-[#d4af37] shadow-[0_0_30px_rgba(212,175,55,0.3)] relative animate-fade-in">
      <div class="bg-gradient-to-r from-[#172b1a] to-[#0f1b11] p-5 border-b border-[#254228] flex items-center justify-between">
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 rounded-full bg-amber-950 border border-amber-500 flex items-center justify-center text-amber-400 text-lg font-bold">
            <i class="fa-solid fa-key"></i>
          </div>
          <div>
            <span class="text-[10px] text-amber-400 uppercase military-font font-bold tracking-widest block">Área Restrita</span>
            <h3 class="text-base font-bold text-white military-font uppercase leading-tight">Autenticação do Admin</h3>
          </div>
        </div>
        <button onclick="fecharModalAdmin()" class="text-slate-400 hover:text-white text-xl p-1">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <form onsubmit="autenticarAdmin(event)" class="p-6 space-y-4 text-xs">
        <p class="text-slate-300 leading-relaxed text-[11px]">
          Digite a senha de segurança da diretoria para liberar o acesso total ao efetivo geral, telefones, CPFs, mensagens e exportações.
        </p>

        <div>
          <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">
            Senha do Administrador:
          </label>
          <input type="password" id="inputSenhaAdmin" required placeholder="Digite a senha..."
                 class="w-full px-3 py-2.5 bg-[#0a120c] border border-[#2b4c2f] rounded-lg text-slate-100 text-sm font-mono tracking-widest text-center focus:outline-none focus:border-amber-400">
          <div id="erroSenhaAdmin" class="hidden text-red-400 font-bold text-[11px] mt-1.5 text-center">
            <i class="fa-solid fa-triangle-exclamation mr-1"></i> Senha incorreta! Tente novamente.
          </div>
        </div>

        <div class="pt-2">
          <button type="submit" 
                  class="w-full py-2.5 px-4 bg-gradient-to-r from-amber-600 to-amber-500 hover:from-amber-500 hover:to-amber-400 text-slate-950 font-extrabold rounded-lg text-xs military-font uppercase tracking-wider flex items-center justify-center shadow-lg transition-all">
            <i class="fa-solid fa-unlock mr-1.5"></i> Acessar Painel Completo
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- MODAL: IMPORTAR CADASTRO DO WHATSAPP -->
  <div id="modalImportarWhats" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4 hidden">
    <div class="tactical-card max-w-xl w-full rounded-2xl overflow-hidden border border-[#2d4d31] shadow-2xl relative animate-fade-in">
      <div class="bg-gradient-to-r from-[#172b1a] to-[#0f1b11] p-5 border-b border-[#254228] flex items-center justify-between">
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 rounded-full bg-green-950 border border-green-500 flex items-center justify-center text-green-400 text-lg font-bold">
            <i class="fa-brands fa-whatsapp"></i>
          </div>
          <div>
            <span class="text-[10px] text-amber-400 uppercase military-font font-bold tracking-widest block">Sincronização Rápida</span>
            <h3 class="text-lg font-bold text-white military-font uppercase leading-tight">Importar Cadastro do WhatsApp</h3>
          </div>
        </div>
        <button onclick="fecharModalImportarWhats()" class="text-slate-400 hover:text-white text-xl p-1">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <div class="p-6 space-y-4 text-xs">
        <p class="text-slate-300 leading-relaxed">
          Cole abaixo a mensagem enviada pelo veterano via WhatsApp. O sistema detectará automaticamente o <strong class="text-amber-400">Nome, Nome de Guerra, Graduação, Companhia, Ano, WhatsApp e Cidade</strong> e incorporará o militar imediatamente ao Efetivo Geral.
        </p>

        <div>
          <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">
            Texto da Mensagem do WhatsApp:
          </label>
          <textarea id="txtMsgWhatsImportar" rows="7" placeholder="*CADASTRO DE VETERANO - 5º BE CMB BLD*
👤 *Nome:* Carlos da Silva (SILVA)
🎖️ *Graduação:* Sd
🏢 *Companhia:* 1º Cia Eng Cmb Bld
📅 *Ano Inc:* 1988
📱 *WhatsApp:* (42) 99999-8888
📍 *Cidade:* Porto União - SC"
                    class="w-full p-3 bg-[#0a120c] border border-[#254428] rounded-xl text-xs text-slate-200 font-mono focus:outline-none focus:border-amber-400 custom-scroll"></textarea>
        </div>

        <div class="flex justify-between items-center text-[11px] text-slate-400">
          <button type="button" onclick="carregarExemploWhatsImportar()" class="text-amber-400 hover:underline">
            <i class="fa-solid fa-wand-magic-sparkles mr-1"></i> Preencher com exemplo
          </button>
          <span class="text-emerald-400 font-semibold"><i class="fa-solid fa-check mr-1"></i> Atualiza listas e estatísticas na hora</span>
        </div>
      </div>

      <div class="bg-[#0e1810] px-6 py-4 border-t border-[#1d3420] flex items-center justify-end space-x-3">
        <button onclick="fecharModalImportarWhats()" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg text-xs font-semibold">
          Cancelar
        </button>
        <button onclick="processarTextoWhatsCadastro()" class="px-5 py-2.5 bg-gradient-to-r from-emerald-600 to-green-600 hover:from-emerald-500 hover:to-green-500 text-slate-950 font-bold rounded-lg text-xs military-font uppercase flex items-center shadow-lg">
          <i class="fa-solid fa-user-plus mr-1.5"></i> Processar e Adicionar ao Geral
        </button>
      </div>
    </div>
  </div>

  <!-- MODAL: FICHA COMPLETA DO INTEGRANTE -->
  <div id="modalFicha" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4 hidden">
    <div class="tactical-card max-w-xl w-full rounded-2xl overflow-hidden border border-[#2d4d31] shadow-2xl relative animate-fade-in">
      
      <!-- Cabeçalho do Modal -->
      <div class="bg-gradient-to-r from-[#172b1a] to-[#0f1b11] p-5 border-b border-[#254228] flex items-center justify-between">
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 rounded-full bg-emerald-950 border border-emerald-500 flex items-center justify-center text-amber-400 text-lg font-bold">
            <i class="fa-solid fa-shield-halved"></i>
          </div>
          <div>
            <span class="text-[10px] text-amber-400 uppercase military-font font-bold tracking-widest block">Ficha Cadastral Militar</span>
            <h3 id="modalNomeCompleto" class="text-lg font-bold text-white military-font uppercase leading-tight">Nome do Integrante</h3>
          </div>
        </div>
        <button onclick="fecharModalFicha()" class="text-slate-400 hover:text-white text-xl p-1">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <!-- Corpo da Ficha -->
      <div class="p-6 space-y-4 max-h-[80vh] overflow-y-auto custom-scroll text-xs">
        
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 bg-[#0c160e] p-3 rounded-lg border border-[#1f3722]">
          <div>
            <span class="text-[10px] text-slate-400 uppercase font-semibold block">ID Registro</span>
            <span id="modalID" class="text-amber-400 font-bold military-font text-sm">--</span>
          </div>
          <div>
            <span class="text-[10px] text-slate-400 uppercase font-semibold block">Nome Guerra</span>
            <span id="modalNomeGuerra" class="text-white font-bold military-font text-sm">--</span>
          </div>
          <div>
            <span class="text-[10px] text-slate-400 uppercase font-semibold block">Posto / Grad</span>
            <span id="modalGraduacao" class="text-emerald-400 font-bold military-font text-sm">--</span>
          </div>
          <div>
            <span class="text-[10px] text-slate-400 uppercase font-semibold block">Ano Inc</span>
            <span id="modalAno" class="text-white font-bold military-font text-sm">--</span>
          </div>
        </div>

        <div class="space-y-2">
          <div class="flex items-start">
            <span class="w-28 text-slate-400 font-semibold uppercase text-[11px] flex-shrink-0"><i class="fa-solid fa-flag mr-1 text-amber-400"></i> Companhia:</span>
            <span id="modalCompanhia" class="text-slate-100 font-medium">--</span>
          </div>
          <div class="flex items-start">
            <span class="w-28 text-slate-400 font-semibold uppercase text-[11px] flex-shrink-0"><i class="fa-brands fa-whatsapp mr-1 text-green-400"></i> Telefone:</span>
            <span id="modalTelefone" class="text-emerald-400 font-bold">--</span>
          </div>
          <div class="flex items-start">
            <span class="w-28 text-slate-400 font-semibold uppercase text-[11px] flex-shrink-0"><i class="fa-solid fa-envelope mr-1 text-amber-400"></i> E-mail:</span>
            <span id="modalEmail" class="text-slate-100">--</span>
          </div>
          <div class="flex items-start">
            <span class="w-28 text-slate-400 font-semibold uppercase text-[11px] flex-shrink-0"><i class="fa-solid fa-id-card mr-1 text-blue-400"></i> CPF:</span>
            <span id="modalCPF" class="text-slate-100">--</span>
          </div>
          <div class="flex items-start">
            <span class="w-28 text-slate-400 font-semibold uppercase text-[11px] flex-shrink-0"><i class="fa-solid fa-cake-candles mr-1 text-pink-400"></i> Nascimento:</span>
            <span id="modalNascimento" class="text-slate-100">--</span>
          </div>
          <div class="flex items-start">
            <span class="w-28 text-slate-400 font-semibold uppercase text-[11px] flex-shrink-0"><i class="fa-solid fa-location-dot mr-1 text-red-400"></i> Endereço:</span>
            <span id="modalEndereco" class="text-slate-100 leading-normal">--</span>
          </div>
        </div>

      </div>

      <!-- Rodapé do Modal com Ações Rápidas -->
      <div class="bg-[#0e190f] p-4 border-t border-[#254228] flex justify-between items-center">
        <button onclick="fecharModalFicha()" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg text-xs font-semibold">
          Fechar
        </button>
        <a id="modalBtnWhatsApp" href="#" target="_blank"
           class="px-5 py-2.5 bg-green-600 hover:bg-green-500 text-slate-950 font-extrabold rounded-lg text-xs military-font uppercase flex items-center shadow-lg">
          <i class="fa-brands fa-whatsapp text-base mr-2"></i> Abrir no WhatsApp
        </a>
      </div>

    </div>
  </div>

  <!-- RODAPÉ DA APLICAÇÃO: Redes Sociais, Admin e Informações -->
  <footer class="bg-[#0b130c] border-t border-[#1c331f] py-6 text-center text-xs text-slate-500">
    <div class="max-w-7xl mx-auto px-4 flex flex-col md:flex-row items-center justify-between gap-4">
      <div class="text-center md:text-left">
        <p class="font-bold text-slate-300">5º Batalhão de Engenharia de Combate Blindado • Batalhão Juarez Távora</p>
        <p class="text-[11px] text-slate-500 mt-0.5">Veteranos do 5º BE • Porto União - SC</p>
      </div>
      
      <!-- Redes Sociais Oficiais & Área Admin -->
      <div class="flex flex-wrap items-center justify-center gap-3">
        <!-- Instagram Oficial -->
        <a href="https://www.instagram.com/veteranos5be" target="_blank" rel="noopener noreferrer"
           title="Instagram Oficial @veteranos5be"
           class="inline-flex items-center space-x-1.5 px-3 py-1.5 bg-gradient-to-r from-pink-950/70 via-purple-950/70 to-pink-950/70 hover:from-pink-900 hover:to-purple-900 border border-pink-500/50 hover:border-pink-400 text-pink-300 hover:text-white rounded-lg text-xs font-bold military-font uppercase transition-all shadow">
          <i class="fa-brands fa-instagram text-pink-400 text-sm"></i>
          <span>Instagram @veteranos5be</span>
        </a>

        <!-- Facebook Oficial -->
        <a href="https://www.facebook.com/veteranos5be" target="_blank" rel="noopener noreferrer"
           title="Facebook Oficial @veteranos5be"
           class="inline-flex items-center space-x-1.5 px-3 py-1.5 bg-blue-950/70 hover:bg-blue-900 border border-blue-500/50 hover:border-blue-400 text-blue-300 hover:text-white rounded-lg text-xs font-bold military-font uppercase transition-all shadow">
          <i class="fa-brands fa-facebook text-blue-400 text-sm"></i>
          <span>Facebook @veteranos5be</span>
        </a>

        <!-- Botão para visitantes acessarem Área Admin -->
        <button id="btnAbrirLoginAdmin" onclick="abrirModalAdmin()"
                title="Acesso restrito para administradores com senha"
                class="inline-flex items-center space-x-1.5 px-3.5 py-1.5 bg-amber-600/20 hover:bg-amber-600/40 text-amber-300 border border-amber-500/50 hover:border-amber-400 font-bold rounded-lg text-xs military-font uppercase shadow transition-all">
          <i class="fa-solid fa-lock text-amber-400"></i>
          <span>Área Admin</span>
        </button>

        <!-- Barra de Status do Admin quando logado -->
        <div id="barraAdminLogado" class="hidden flex items-center space-x-2">
          <span class="px-3 py-1.5 bg-emerald-950/80 border border-emerald-500/50 rounded-lg text-emerald-300 text-xs font-bold military-font uppercase flex items-center">
            <i class="fa-solid fa-shield-halved text-emerald-400 mr-1.5"></i> ADMIN ATIVO
          </span>
          <button onclick="abrirModalImportarWhats()"
                  title="Colar cadastro recebido no WhatsApp de um veterano"
                  class="px-2.5 py-1.5 bg-green-700 hover:bg-green-600 text-slate-950 font-bold rounded-lg text-xs military-font uppercase flex items-center shadow">
            <i class="fa-brands fa-whatsapp mr-1"></i> + Importar
          </button>
          <button onclick="fazerLogoutAdmin()"
                  title="Sair do modo administrador"
                  class="px-2.5 py-1.5 bg-red-950/80 hover:bg-red-900/80 text-red-300 border border-red-700/50 rounded-lg text-xs font-bold military-font uppercase flex items-center shadow transition-all">
            <i class="fa-solid fa-arrow-right-from-bracket mr-1"></i> Sair
          </button>
        </div>
      </div>

      <p class="military-font uppercase text-emerald-600 font-bold tracking-wider text-center md:text-right">AÇO • BLINDADO • ENGENHARIA</p>
    </div>
  </footer>

  <!-- CARREGA OS 658 INTEGRANTES -->
  <script src="dados.js"></script>

  <!-- LÃ“GICA DO SISTEMA -->
  <script>
    // Estado Global da Aplicação
    let integrantedAtuais = [];
    let ciaAtiva = "TODAS";
    let ciaAtivaMuralPub = '';
    let selecionadosIDs = new Set();
    let statusEnvios = {}; // id -> boolean

    // Companhias Reconhecidas com Mascotes / Animais
    const MASCOTES_CIAS = {
      "1º Cia Eng Cmb Bld": {
        nome: "Leão",
        label: "1ª Cia Eng Cmb Bld",
        badge: "LEÃO",
        svg: "animal_leao.svg",
        emoji: "🦁",
        cor: "#f59e0b",
        bgTag: "bg-amber-950/90 text-amber-300 border border-amber-500/60"
      },
      "2º Cia Eng Cmb Bld": {
        nome: "Onça",
        label: "2ª Cia Eng Cmb Bld",
        badge: "ONÇA",
        svg: "animal_onca.svg",
        emoji: "🐆",
        cor: "#eab308",
        bgTag: "bg-yellow-950/90 text-yellow-300 border border-yellow-500/60"
      },
      "Cia Cmdo e Ap - (CCAp)": {
        nome: "Pantera",
        label: "Cia Cmdo e Ap (CCAp)",
        badge: "PANTERA",
        svg: "animal_pantera.svg",
        emoji: "🐾",
        cor: "#10b981",
        bgTag: "bg-emerald-950/90 text-emerald-300 border border-emerald-500/60"
      },
      "Cia Eng Pnt (CEP)": {
        nome: "Águia",
        label: "Cia Pontes (CEP)",
        badge: "ÁGUIA",
        svg: "animal_aguia.svg",
        emoji: "🦅",
        cor: "#38bdf8",
        bgTag: "bg-sky-950/90 text-sky-300 border border-sky-500/60"
      },
      "Estado Maior Geral e Especial": {
        nome: "Estado-Maior",
        label: "Estado-Maior",
        badge: "EM",
        icone: "fa-solid fa-star",
        emoji: "⭐",
        cor: "#c084fc",
        bgTag: "bg-purple-950/90 text-purple-300 border border-purple-500/60"
      },
      "NPOR": {
        nome: "NPOR",
        label: "NPOR",
        badge: "NPOR",
        icone: "fa-solid fa-graduation-cap",
        emoji: "🎓",
        cor: "#f472b6",
        bgTag: "bg-pink-950/90 text-pink-300 border border-pink-500/60"
      }
    };

    function normalizarCia(cia) {
      if (!cia) return '';
      return cia.replace(/º/g, 'ª').trim().toLowerCase();
    }

    function obterMascoteCia(cia) {
      if (!cia) return null;
      const n = normalizarCia(cia);
      for (const [key, val] of Object.entries(MASCOTES_CIAS)) {
        if (normalizarCia(key) === n) return val;
      }
      return null;
    }

    // Companhias Reconhecidas
    const CIAS_ORDEM = [
      { id: "TODAS", label: "TODAS", icone: "fa-solid fa-layer-group" },
      { id: "1º Cia Eng Cmb Bld", label: "1ª Cia Eng Cmb Bld", animal: "Leão", svg: "animal_leao.svg" },
      { id: "2º Cia Eng Cmb Bld", label: "2ª Cia Eng Cmb Bld", animal: "Onça", svg: "animal_onca.svg" },
      { id: "Cia Cmdo e Ap - (CCAp)", label: "Cia Cmdo e Ap (CCAp)", animal: "Pantera", svg: "animal_pantera.svg" },
      { id: "Cia Eng Pnt (CEP)", label: "Cia Pontes (CEP)", animal: "Águia", svg: "animal_aguia.svg" },
      { id: "Estado Maior Geral e Especial", label: "Estado-Maior", icone: "fa-solid fa-star" },
      { id: "NPOR", label: "NPOR", icone: "fa-solid fa-graduation-cap" },
      { id: "NOVOS", label: "Novos Cadastros Online", icone: "fa-solid fa-user-plus" }
    ];

    // Sincronização em Tempo Real entre abas (BroadcastChannel e Storage)
    let syncChannel = null;
    try {
      syncChannel = new BroadcastChannel('veteranos_5be_sync');
      syncChannel.onmessage = (ev) => {
        if (ev.data && (ev.data.tipo === 'NOVO_CADASTRO' || ev.data.tipo === 'ATUALIZACAO_CADASTRO')) {
          recarregarEfetivoComNovos(ev.data.registro);
          if (ev.data.tipo === 'ATUALIZACAO_CADASTRO') {
            mostrarNotificacaoTatica(`🎖️ Dados de ${ev.data.registro.nome} foram atualizados no Efetivo Geral!`);
          } else {
            mostrarNotificacaoTatica(`🎖️ ${ev.data.registro.nome} (${ev.data.registro.cia}) foi incorporado ao Efetivo Geral!`);
          }
        }
      };
    } catch(e) {}

    window.addEventListener('storage', (e) => {
      if (e.key === 'novos_veteranos_5be') {
        recarregarEfetivoComNovos();
      }
    });

    // Autenticação Administrativa (Exclusivo da Diretoria)
    const SENHA_ADMIN_OFICIAL = "104832";

    function verificarAdminLogado() {
      return sessionStorage.getItem('admin_5be_logado') === 'true';
    }

    function abrirModalAdmin() {
      if (verificarAdminLogado()) {
        atualizarModoVisualizacao();
        trocarAbaPrincipal('integrantes');
        return;
      }
      const modal = document.getElementById('modalLoginAdmin');
      const input = document.getElementById('inputSenhaAdmin');
      const erro = document.getElementById('erroSenhaAdmin');
      if (erro) erro.classList.add('hidden');
      if (input) input.value = '';
      if (modal) {
        modal.classList.remove('hidden');
        modal.style.display = 'flex';
      }
      setTimeout(() => input && input.focus(), 100);
    }

    function fecharModalAdmin() {
      const modal = document.getElementById('modalLoginAdmin');
      if (modal) {
        modal.classList.add('hidden');
        modal.style.display = 'none';
      }
    }

    function autenticarAdmin(event) {
      event.preventDefault();
      const senha = document.getElementById('inputSenhaAdmin').value.trim();
      const erroEl = document.getElementById('erroSenhaAdmin');

      if (senha === SENHA_ADMIN_OFICIAL) {
        sessionStorage.setItem('admin_5be_logado', 'true');
        fecharModalAdmin();
        if (erroEl) erroEl.classList.add('hidden');
        atualizarModoVisualizacao();
        trocarAbaPrincipal('integrantes');
        mostrarNotificacaoTatica("🔑 Modo Administrador ativado! Acesso total liberado.");
      } else {
        if (erroEl) erroEl.classList.remove('hidden');
        document.getElementById('inputSenhaAdmin').select();
      }
    }

    function fazerLogoutAdmin() {
      sessionStorage.removeItem('admin_5be_logado');
      atualizarModoVisualizacao();
      trocarAbaPrincipal('inscricao');
      mostrarNotificacaoTatica("🔒 Sessão de Administrador encerrada.");
    }

    function verificarTelefonesLiberadosPublico() {
      return localStorage.getItem('liberar_telefones_veteranos') === 'true';
    }

    function toggleLiberacaoTelefonesAdmin() {
      const atual = verificarTelefonesLiberadosPublico();
      const novo = !atual;
      localStorage.setItem('liberar_telefones_veteranos', novo.toString());
      atualizarChaveTelefonesAdmin();
      renderizarMuralPublico();
      mostrarNotificacaoTatica(novo ? "🔓 Telefones LIBERADOS para consulta no mural público!" : "🔒 Telefones PROTEGIDOS (Apenas Admin pode ver)!");
    }

    function atualizarChaveTelefonesAdmin() {
      const btn = document.getElementById('btnToggleTelefonesAdmin');
      if (!btn) return;
      const liberados = verificarTelefonesLiberadosPublico();
      if (liberados) {
        btn.className = "px-2.5 py-0.5 bg-emerald-900 text-emerald-200 border border-emerald-500/60 rounded font-bold military-font uppercase transition-all flex items-center";
        btn.innerHTML = `<i class="fa-solid fa-lock-open mr-1 text-emerald-400"></i> Liberados no Mural`;
      } else {
        btn.className = "px-2.5 py-0.5 bg-amber-950 text-amber-300 border border-amber-600/50 rounded font-bold military-font uppercase transition-all flex items-center";
        btn.innerHTML = `<i class="fa-solid fa-lock mr-1 text-amber-400"></i> Protegidos (Padrão)`;
      }
    }

    // Inicialização ao carregar
    window.addEventListener('DOMContentLoaded', () => {
      atualizarVisibilidadeReservasAlmoco();
      recarregarEfetivoComNovos();
      carregarModelo('encontro');
      configurarLinkCadastro();
      atualizarModoVisualizacao();
      atualizarChaveTelefonesAdmin();
      aplicarEstadoPermanenteVeteranoPublico();

      if (window.location.hash === '#admin' || window.location.search.includes('admin=true')) {
        if (!verificarAdminLogado()) {
          setTimeout(() => abrirModalAdmin(), 250);
        } else {
          trocarAbaPrincipal('integrantes');
        }
      }
    });

    // Atualiza a interface entre Modo Público e Modo Admin
    function atualizarModoVisualizacao() {
      const isAdmin = verificarAdminLogado();
      const navPublico = document.getElementById('navPublico');
      const navAdmin = document.getElementById('navAdmin');
      const btnLogin = document.getElementById('btnAbrirLoginAdmin');
      const barraAdmin = document.getElementById('barraAdminLogado');

      if (isAdmin) {
        if (navPublico) navPublico.classList.add('hidden');
        if (navAdmin) navAdmin.classList.remove('hidden');
        if (btnLogin) btnLogin.classList.add('hidden');
        if (barraAdmin) barraAdmin.classList.remove('hidden');
      } else {
        if (navPublico) navPublico.classList.remove('hidden');
        if (navAdmin) navAdmin.classList.add('hidden');
        if (btnLogin) btnLogin.classList.remove('hidden');
        if (barraAdmin) barraAdmin.classList.add('hidden');
        trocarAbaPrincipal('inscricao');
      }

      renderizarMuralPublico();
    }

    function encontrarMilitarExistente(lista, dados) {
      if (!lista || !Array.isArray(lista) || !dados) return null;

      const norm = (txt) => {
        if (!txt) return '';
        return txt.toString().toLowerCase()
          .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
          .replace(/[^a-z0-9]/g, '');
      };

      const digitos = (tel) => {
        if (!tel) return '';
        const d = tel.toString().replace(/\D/g, '');
        return d.length >= 8 ? d.slice(-8) : d;
      };

      const idNovo = dados.id;
      const nomeNovo = norm(dados.nome);
      const guerraNovo = norm(dados.guerra);
      const anoNovo = dados.ano ? String(dados.ano).trim() : '';
      const cpfNovo = dados.cpf ? String(dados.cpf).replace(/\D/g, '') : '';
      const telNovo = digitos(dados.tel || dados.telDial);

      for (let i = 0; i < lista.length; i++) {
        const item = lista[i];

        // 0. Match direto pelo mesmo ID numérico
        if (idNovo && item.id && String(idNovo) === String(item.id)) {
          return { militar: item, index: i, motivo: 'ID' };
        }

        // 1. Match por CPF (mínimo 9 dígitos)
        const cpfItem = item.cpf ? String(item.cpf).replace(/\D/g, '') : '';
        if (cpfNovo && cpfItem && cpfNovo.length >= 9 && cpfNovo === cpfItem) {
          return { militar: item, index: i, motivo: 'CPF' };
        }

        // 2. Match por Nome Completo normalizado idêntico
        const nomeItem = norm(item.nome);
        if (nomeNovo && nomeItem && nomeNovo === nomeItem) {
          return { militar: item, index: i, motivo: 'Nome Completo' };
        }

        // 3. Match por Telefone (últimos 8 dígitos) + Primeiro Nome ou Nome de Guerra
        const telItem = digitos(item.tel || item.telDial);
        if (telNovo && telItem && telNovo.length >= 8 && telNovo === telItem) {
          const guerraItem = norm(item.guerra);
          const primNovo = (dados.nome || '').trim().split(' ')[0].toLowerCase();
          const primItem = (item.nome || '').trim().split(' ')[0].toLowerCase();
          if ((guerraNovo && guerraItem && guerraNovo === guerraItem) || (primNovo && primItem && primNovo === primItem)) {
            return { militar: item, index: i, motivo: 'Telefone e Nome' };
          }
        }

        // 4. Match por Nome de Guerra + Ano de Incorporação (quando guerra tem pelo menos 4 letras)
        const guerraItem = norm(item.guerra);
        const anoItem = item.ano ? String(item.ano).trim() : '';
        if (guerraNovo && guerraItem && guerraNovo.length >= 4 && guerraNovo === guerraItem) {
          if (anoNovo && anoItem && anoNovo === anoItem) {
            return { militar: item, index: i, motivo: 'Guerra e Ano' };
          }
        }
      }

      return null;
    }

    // Recarrega a base oficial + novos e atualiza todo o sistema
    function recarregarEfetivoComNovos(novoItem) {
      let base = [];
      if (window.VETERANOS_DATA && Array.isArray(window.VETERANOS_DATA)) {
        base = JSON.parse(JSON.stringify(window.VETERANOS_DATA));
      }

      let novos = [];
      try {
        const stored = localStorage.getItem('novos_veteranos_5be');
        if (stored) novos = JSON.parse(stored);
      } catch (e) { novos = []; }

      if (novoItem) {
        let idxNovo = novos.findIndex(n => n.id === novoItem.id);
        if (idxNovo === -1) {
          const mNovo = encontrarMilitarExistente(novos, novoItem);
          if (mNovo) idxNovo = mNovo.index;
        }

        if (idxNovo !== -1) {
          novos[idxNovo] = novoItem;
        } else {
          novos.unshift(novoItem);
        }
        try { localStorage.setItem('novos_veteranos_5be', JSON.stringify(novos)); } catch(e){}
      }

      // Unifica atualizações e novos: se o veterano já existe, apenas atualiza as informações sem duplicar
      novos.forEach(n => {
        let indexBase = base.findIndex(b => b.id === n.id);
        if (indexBase === -1) {
          const m = encontrarMilitarExistente(base, n);
          if (m) indexBase = m.index;
        }

        if (indexBase !== -1) {
          Object.assign(base[indexBase], n, { isAtualizado: true, isNovo: true });
        } else {
          n.isNovo = true;
          base.unshift(n);
        }
      });

      integrantedAtuais = base;

      const statTotal = document.getElementById('statTotal');
      if (statTotal) statTotal.innerText = integrantedAtuais.length;
      const statNovos = document.getElementById('statNovos');
      if (statNovos) statNovos.innerText = novos.length;

      montarBotoesCompanhias();
      aplicarFiltros();
      renderizarNovosCadastros(novos);
      atualizarInfoExportacao();
      renderizarMuralPublico();
    }

    // Troca de Abas Principais (Com controle de acesso restrito ao Admin)
    function trocarAbaPrincipal(abaId) {
      const isAdmin = verificarAdminLogado();

      // Se não for admin, bloqueia acesso a qualquer aba restrita
      if (!isAdmin && abaId !== 'inscricao') {
        abrirModalAdmin();
        return;
      }

      const abas = ['inscricao', 'integrantes', 'mensagens', 'link', 'exportar'];
      abas.forEach(a => {
        const el = document.getElementById(`aba-${a}`);
        const btnAdmin = document.getElementById(`nav-btn-${a}`);
        const isTarget = (a === abaId);

        if (el) {
          if (isTarget) el.classList.remove('hidden');
          else el.classList.add('hidden');
        }

        if (btnAdmin) {
          if (isTarget) {
            btnAdmin.className = "px-3 py-2 rounded-md text-xs font-bold military-font uppercase transition-all bg-emerald-700 text-white shadow";
          } else {
            btnAdmin.className = "px-3 py-2 rounded-md text-xs font-bold military-font uppercase transition-all text-slate-300 hover:text-white hover:bg-[#1a2f1d]";
          }
        }
      });

      if (abaId === 'mensagens') {
        atualizarFilaDisparo();
      } else if (abaId === 'exportar') {
        atualizarInfoExportacao();
      } else if (abaId === 'inscricao') {
        aplicarEstadoPermanenteVeteranoPublico();
        renderizarMuralPublico();
      }
    }

    // Funções da Inscrição Pública & Mural da Companhia Liberado
    function mascaraTelefonePublico(input) {
      let v = input.value.replace(/\D/g, '');
      if (v.length > 11) v = v.substring(0, 11);
      if (v.length > 6) {
        input.value = `(${v.substring(0, 2)}) ${v.substring(2, 7)}-${v.substring(7)}`;
      } else if (v.length > 2) {
        input.value = `(${v.substring(0, 2)}) ${v.substring(2)}`;
      } else {
        input.value = v;
      }
    }

    
    // Auto-preenche o formulário público ao digitar o nome se já constar no efetivo
    function autoPreencherCadastroPublico(elDisparador) {
      const elNome = document.getElementById('pubNomeCompleto');
      const elGuerra = document.getElementById('pubNomeGuerra');
      const nomeDigitado = elNome ? elNome.value.trim() : '';
      const guerraDigitada = elGuerra ? elGuerra.value.trim() : '';

      const query = (elDisparador && elDisparador.id === 'pubNomeGuerra') ? guerraDigitada : (nomeDigitado || guerraDigitada);
      if (query.length < 3) return;

      const norm = (t) => t ? t.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').trim() : '';
      const qNorm = norm(query);

      let todos = (typeof integrantesAtuais !== 'undefined' && Array.isArray(integrantesAtuais)) ? integrantesAtuais : [];
      if (todos.length === 0 && window.VETERANOS_DATA && Array.isArray(window.VETERANOS_DATA)) {
        todos = window.VETERANOS_DATA;
      }

      // 1. Nome completo exato
      let achado = todos.find(v => norm(v.nome) === qNorm);
      // 2. Começa com o nome (se 4+ chars)
      if (!achado && qNorm.length >= 4) {
        achado = todos.find(v => norm(v.nome).startsWith(qNorm));
      }
      // 3. Nome de guerra exato
      if (!achado) {
        achado = todos.find(v => v.guerra && norm(v.guerra) === qNorm);
      }

      if (achado) {
        if (elNome && (!elNome.value || qNorm.length >= 4)) elNome.value = achado.nome || elNome.value;
        if (elGuerra && achado.guerra) elGuerra.value = achado.guerra;
        if (achado.grad && document.getElementById('pubGraduacao')) document.getElementById('pubGraduacao').value = achado.grad;
        if (achado.cia && document.getElementById('pubCompanhia')) document.getElementById('pubCompanhia').value = achado.cia;
        if (achado.ano && document.getElementById('pubAno')) document.getElementById('pubAno').value = achado.ano;
        if (achado.tel && document.getElementById('pubWhatsApp')) document.getElementById('pubWhatsApp').value = achado.tel;
        if (achado.cidade && document.getElementById('pubCidade')) document.getElementById('pubCidade').value = achado.cidade;
        if (achado.uf && document.getElementById('pubEstado')) document.getElementById('pubEstado').value = achado.uf;
        if (achado.bairro && document.getElementById('pubBairro')) document.getElementById('pubBairro').value = achado.bairro;
        if (achado.rua && document.getElementById('pubRua')) document.getElementById('pubRua').value = achado.rua;

        const banner = document.getElementById('avisoAutoPreenchimentoPub');
        const txtBanner = document.getElementById('txtAvisoAutoPreenchimentoPub');
        if (banner && txtBanner) {
          txtBanner.innerHTML = `<strong>Cadastro localizado no efetivo!</strong> Dados de <strong>${achado.nome}</strong> (${achado.guerra || ''}) carregados automaticamente. Você pode atualizar qualquer dado antes de salvar.`;
          banner.classList.remove('hidden');
        }
      }
    }

    function salvarInscricaoPublica(event) {
      event.preventDefault();

      const dialNumber = document.getElementById('pubWhatsApp').value.replace(/\D/g, '');
      const telDial = dialNumber.length <= 11 ? '55' + dialNumber : dialNumber;

      const dadosForm = {
        nome: document.getElementById('pubNomeCompleto').value.trim(),
        guerra: document.getElementById('pubNomeGuerra').value.trim().toUpperCase(),
        grad: document.getElementById('pubGraduacao').value,
        cia: document.getElementById('pubCompanhia').value,
        ano: document.getElementById('pubAno').value.trim(),
        tel: document.getElementById('pubWhatsApp').value.trim(),
        telDial: telDial,
        cidade: document.getElementById('pubCidade').value.trim(),
        uf: document.getElementById('pubEstado').value,
        bairro: document.getElementById('pubBairro').value.trim(),
        rua: document.getElementById('pubRua').value.trim(),
        endereco: document.getElementById('pubRua').value.trim() ? `${document.getElementById('pubRua').value.trim()} - ${document.getElementById('pubCidade').value.trim()} - ${document.getElementById('pubEstado').value}` : `${document.getElementById('pubCidade').value.trim()} - ${document.getElementById('pubEstado').value}`
      };

      // 1. Salva no localStorage (lista de novos)
      let listaNovos = [];
      try {
        const stored = localStorage.getItem('novos_veteranos_5be');
        if (stored) listaNovos = JSON.parse(stored);
      } catch(e) { listaNovos = []; }

      // Verifica se o veterano já existe no efetivo geral
      const match = encontrarMilitarExistente(integrantedAtuais, dadosForm);
      const isAtualizacao = Boolean(match);
      let registroFinal;

      if (isAtualizacao) {
        // Apenas atualiza as informações do militar existente mantendo o ID original
        registroFinal = Object.assign({}, match.militar, dadosForm, {
          id: match.militar.id,
          dataAtualizacao: new Date().toLocaleDateString('pt-BR'),
          isAtualizado: true,
          isNovo: true
        });

        // Atualiza na lista de novos/modificados
        let idxNovo = listaNovos.findIndex(n => n.id === registroFinal.id);
        if (idxNovo === -1) {
          const mNovo = encontrarMilitarExistente(listaNovos, registroFinal);
          if (mNovo) idxNovo = mNovo.index;
        }

        if (idxNovo !== -1) {
          listaNovos[idxNovo] = registroFinal;
        } else {
          listaNovos.unshift(registroFinal);
        }
      } else {
        // Novo cadastro inédito
        registroFinal = Object.assign({}, dadosForm, {
          id: Date.now(),
          dataCadastro: new Date().toLocaleDateString('pt-BR'),
          email: '',
          cpf: '',
          isNovo: true
        });
        listaNovos.unshift(registroFinal);
      }

      localStorage.setItem('novos_veteranos_5be', JSON.stringify(listaNovos));

      // 2. Registra na sessão que este usuário completou a inscrição e sua companhia
      sessionStorage.setItem('veterano_inscrito_cia', registroFinal.cia);
      sessionStorage.setItem('veterano_inscrito_nome', registroFinal.nome);
      sessionStorage.setItem('veterano_inscrito_ano', registroFinal.ano);

      // Preenche imediatamente o campo de ano para puxar os militares da turma dele
      const inputAnoMural = document.getElementById('filtroMuralPubAno');
      if (inputAnoMural && registroFinal.ano) {
        inputAnoMural.value = registroFinal.ano;
      }

      // 3. Transmite via BroadcastChannel
      try {
        if (syncChannel) syncChannel.postMessage({ 
          tipo: isAtualizacao ? 'ATUALIZACAO_CADASTRO' : 'NOVO_CADASTRO', 
          registro: registroFinal 
        });
      } catch(e) {}

      // 4. Incorpora ao Efetivo Geral
      recarregarEfetivoComNovos(registroFinal);

      // 5. Configura mensagem para WhatsApp
      const tituloMsg = isAtualizacao 
        ? `*ATUALIZAÇÃO DE CADASTRO DE VETERANO - 5º BE CMB BLD*`
        : `*INSCRIÇÃO DE VETERANO - 5º BE CMB BLD*`;
      const confirmacaoMsg = isAtualizacao
        ? `\n_Confirmo a atualização das minhas informações na Comissão dos Veteranos do 5º BE!_`
        : `\n_Confirmo minha inscrição e liberação da lista da minha Companhia na Comissão dos Veteranos do 5º BE!_`;

      const textoWhatsApp = encodeURIComponent(
        `${tituloMsg}\n\n` +
        `👤 *Nome:* ${registroFinal.nome} (${registroFinal.guerra})\n` +
        `🎖️ *Graduação:* ${registroFinal.grad}\n` +
        `🏢 *Companhia:* ${registroFinal.cia}\n` +
        `📅 *Ano que Serviu:* ${registroFinal.ano}\n` +
        `📱 *WhatsApp:* ${registroFinal.tel}\n` +
        `📍 *Cidade:* ${registroFinal.cidade} - ${registroFinal.uf}\n` +
        (registroFinal.rua ? `🏠 *Endereço:* ${registroFinal.rua}, ${registroFinal.bairro}\n` : '') +
        confirmacaoMsg
      );
      document.getElementById('btnWhatsConfirmacaoPub').href = `https://api.whatsapp.com/send?phone=5542999033839&text=${textoWhatsApp}`;

      // 6. Atualiza textos e exibe confirmação
            if (isAtualizacao) {
        alert(`âš ï¸ AVISO: O cadastro de ${registroFinal.nome} JÃ EXISTE no sistema!\n\nAs suas informações foram atualizadas com sucesso no Efetivo Geral.`);
      }

      const boxSucesso = document.getElementById('boxSucessoInscricao');
      if (boxSucesso) {
        boxSucesso.className = isAtualizacao
          ? "mt-6 p-5 bg-gradient-to-b from-amber-950/90 to-[#121c13] border-2 border-amber-500 rounded-xl text-center space-y-3 shadow-xl"
          : "mt-6 p-5 bg-emerald-950/80 border border-emerald-500 rounded-xl text-center space-y-3";
      }

      const tituloSucesso = document.getElementById('tituloSucessoInscricaoPub');
      const descSucesso = document.getElementById('descSucessoInscricaoPub');
      if (tituloSucesso) {
        tituloSucesso.innerHTML = isAtualizacao
          ? `<span class="text-amber-400 block text-xs tracking-widest font-black mb-1">âš ï¸ AVISO: CADASTRO JÃ EXISTE NO SISTEMA</span>O CADASTRO JÃ EXISTE! INFORMAÃ‡Ã•ES ATUALIZADAS`
          : "Inscrição Confirmada com Sucesso!";
        tituloSucesso.className = isAtualizacao 
          ? "text-xl font-black text-amber-300 military-font uppercase"
          : "text-xl font-bold text-emerald-300 military-font uppercase";
      }
      if (descSucesso) {
        descSucesso.innerHTML = isAtualizacao
          ? `Identificamos que o militar <strong>${registroFinal.nome}</strong> (${registroFinal.guerra}) já constava cadastrado no 5º BE. <strong class="text-amber-300">Suas informações foram atualizadas com sucesso</strong> no cadastro existente! A lista dos soldados da sua Companhia foi desbloqueada logo abaixo.`
          : `Seu cadastro foi registrado no efetivo geral e a lista de soldados da sua Companhia foi <strong class="text-amber-400">desbloqueada logo abaixo</strong> para vocÃª conferir!`;
      }

      document.getElementById('boxSucessoInscricao').classList.remove('hidden');
      renderizarMuralPublico();

      // Rola suavemente até o mural desbloqueado
      setTimeout(() => {
        const muralEl = document.getElementById('areaListaCompanhiaPublica');
        if (muralEl) muralEl.scrollIntoView({ behavior: 'smooth' });
      }, 300);

      mostrarNotificacaoTatica(isAtualizacao 
        ? `🎉 Informações atualizadas! Lista da ${registroFinal.cia} liberada.`
        : `🎉 Inscrição confirmada! Lista da ${registroFinal.cia} liberada.`);
    }

        function aplicarEstadoPermanenteVeteranoPublico() {
      const cia = localStorage.getItem('veterano_inscrito_cia') || sessionStorage.getItem('veterano_inscrito_cia');
      const nome = localStorage.getItem('veterano_inscrito_nome') || sessionStorage.getItem('veterano_inscrito_nome') || '';
      const guerra = localStorage.getItem('veterano_inscrito_guerra') || (nome ? nome.split(' ')[0].toUpperCase() : '');
      const grad = localStorage.getItem('veterano_inscrito_grad') || 'Sd';
      const ano = localStorage.getItem('veterano_inscrito_ano') || sessionStorage.getItem('veterano_inscrito_ano') || '';
      const tel = localStorage.getItem('veterano_inscrito_tel') || '';
      const cidade = localStorage.getItem('veterano_inscrito_cidade') || '';
      const uf = localStorage.getItem('veterano_inscrito_uf') || 'Santa Catarina';
      const bairro = localStorage.getItem('veterano_inscrito_bairro') || '';
      const rua = localStorage.getItem('veterano_inscrito_rua') || '';

      const painel = document.getElementById('painelVeteranoCadastradoPub');
      const form = document.getElementById('formInscricaoPublica');
      const txtBoasVindas = document.getElementById('txtBoasVindasVeteranoPub');
      const txtCia = document.getElementById('txtCiaVeteranoCadastradoPub');
      const txtAno = document.getElementById('txtAnoVeteranoCadastradoPub');
      const txtBtnToggle = document.getElementById('txtBtnToggleFormPub');

      if (cia && nome) {
        if (painel) painel.classList.remove('hidden');
        if (txtBoasVindas) txtBoasVindas.innerText = Olá,  + grad +   + guerra +  ( + nome + )!;
        if (txtCia) txtCia.innerText = cia;
        if (txtAno) txtAno.innerText = ano ? `Ano ${ano}` : 'NÃ£o informado';

        const elNome = document.getElementById('pubNomeCompleto');
        if (elNome && !elNome.value) elNome.value = nome;
        const elGuerra = document.getElementById('pubNomeGuerra');
        if (elGuerra && !elGuerra.value) elGuerra.value = guerra;
        const elGrad = document.getElementById('pubGraduacao');
        if (elGrad && grad) elGrad.value = grad;
        const elCia = document.getElementById('pubCompanhia');
        if (elCia && cia) elCia.value = cia;
        const elAno = document.getElementById('pubAno');
        if (elAno && ano) elAno.value = ano;
        const elTel = document.getElementById('pubWhatsApp');
        if (elTel && tel) elTel.value = tel;
        const elCidade = document.getElementById('pubCidade');
        if (elCidade && cidade) elCidade.value = cidade;
        const elUf = document.getElementById('pubEstado');
        if (elUf && uf) elUf.value = uf;
        const elBairro = document.getElementById('pubBairro');
        if (elBairro && bairro) elBairro.value = bairro;
        const elRua = document.getElementById('pubRua');
        if (elRua && rua) elRua.value = rua;

        if (form) form.classList.add('hidden');
        if (txtBtnToggle) txtBtnToggle.innerText = 'Atualizar Meus Dados';

        if (!ciaAtivaMuralPub) {
          ciaAtivaMuralPub = cia;
        }

        const inputAno = document.getElementById('filtroMuralPubAno');
        if (inputAno && ano && !inputAno.dataset.iniciado) {
          inputAno.value = ano;
          inputAno.dataset.iniciado = "true";
        }
      } else {
        if (painel) painel.classList.add('hidden');
        if (form) form.classList.remove('hidden');
      }
    }

    function rolarParaListaCompanhiaPub() {
      const el = document.getElementById('areaListaCompanhiaPublica');
      if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function alternarFormularioAtualizacaoPub() {
      const form = document.getElementById('formInscricaoPublica');
      const txt = document.getElementById('txtBtnToggleFormPub');
      if (!form) return;
      const isHidden = form.classList.contains('hidden');
      if (isHidden) {
        form.classList.remove('hidden');
        if (txt) txt.innerText = 'Ocultar Formulário';
        form.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } else {
        form.classList.add('hidden');
        if (txt) txt.innerText = 'Atualizar Meus Dados';
      }
    }

    function desvincularCadastroDispositivoPub() {
      if (!confirm('Deseja desvincular seu cadastro deste aparelho?\n\nVocê poderá vincular novamente a qualquer momento digitando seu nome ou preenchendo o formulário.')) {
        return;
      }
      localStorage.removeItem('veterano_inscrito_cia');
      localStorage.removeItem('veterano_inscrito_nome');
      localStorage.removeItem('veterano_inscrito_guerra');
      localStorage.removeItem('veterano_inscrito_grad');
      localStorage.removeItem('veterano_inscrito_ano');
      localStorage.removeItem('veterano_inscrito_tel');
      localStorage.removeItem('veterano_inscrito_cidade');
      localStorage.removeItem('veterano_inscrito_uf');
      localStorage.removeItem('veterano_inscrito_rua');
      localStorage.removeItem('veterano_inscrito_bairro');
      sessionStorage.removeItem('veterano_inscrito_cia');
      sessionStorage.removeItem('veterano_inscrito_nome');
      sessionStorage.removeItem('veterano_inscrito_ano');

      aplicarEstadoPermanenteVeteranoPublico();
      renderizarMuralPublico();
      alert('Seu cadastro foi desvinculado deste dispositivo.');
    }

    function recuperarCadastroVeteranoPublico() {
      const input = document.getElementById('inputBuscarCadastroExistentePub');
      const busca = (input?.value || '').trim();
      const msgBox = document.getElementById('msgRecuperarStatusPub');
      if (!busca) {
        if (msgBox) {
          msgBox.className = 'mt-2 text-[11px] text-amber-400 font-bold';
          msgBox.innerHTML = '<i class="fa-solid fa-triangle-exclamation mr-1"></i> Digite seu Nome de Guerra ou Nome Completo.';
          msgBox.classList.remove('hidden');
        }
        return;
      }

      const limparTexto = (txt) => {
        if (!txt) return '';
        return txt.toString().toLowerCase()
          .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
          .replace(/[^a-z0-9]/g, '');
      };

      const termo = limparTexto(busca);
      const palavras = busca.toLowerCase()
        .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
        .split(/\s+/)
        .filter(p => p.length >= 2);
      const digitosBusca = busca.replace(/\D/g, '');

      const encontrados = integrantedAtuais.filter(i => {
        const nLimpo = limparTexto(i.nome);
        const gLimpo = limparTexto(i.guerra);
        const telLimpo = (i.tel || '').replace(/\D/g, '');
        const cpfLimpo = (i.cpf || '').replace(/\D/g, '');

        if (nLimpo.includes(termo) || gLimpo.includes(termo)) return true;
        if (digitosBusca.length >= 4 && (telLimpo.includes(digitosBusca) || cpfLimpo.includes(digitosBusca))) return true;
        if (palavras.length > 0 && palavras.every(p => nLimpo.includes(p) || gLimpo.includes(p))) return true;

        return false;
      });

      if (encontrados.length === 0) {
        if (msgBox) {
          msgBox.className = 'mt-2 text-[11px] text-red-400 font-semibold';
          msgBox.innerHTML = `<i class="fa-solid fa-circle-xmark mr-1"></i> Nenhum veterano encontrado com "${busca}". Por favor, preencha o formulÃ¡rio acima para registrar-se e liberar a lista da sua Companhia.`;
          msgBox.classList.remove('hidden');
        }
        return;
      }

      const militar = encontrados[0];

      localStorage.setItem('veterano_inscrito_cia', militar.cia);
      localStorage.setItem('veterano_inscrito_nome', militar.nome);
      localStorage.setItem('veterano_inscrito_guerra', militar.guerra || militar.nome.split(' ')[0].toUpperCase());
      localStorage.setItem('veterano_inscrito_grad', militar.grad || 'Sd');
      localStorage.setItem('veterano_inscrito_ano', militar.ano || '');
      localStorage.setItem('veterano_inscrito_tel', militar.tel || '');
      localStorage.setItem('veterano_inscrito_cidade', militar.cidade || '');
      localStorage.setItem('veterano_inscrito_uf', militar.uf || 'Santa Catarina');

      sessionStorage.setItem('veterano_inscrito_cia', militar.cia);
      sessionStorage.setItem('veterano_inscrito_nome', militar.nome);
      sessionStorage.setItem('veterano_inscrito_ano', militar.ano || '');

      ciaAtivaMuralPub = militar.cia;
      aplicarEstadoPermanenteVeteranoPublico();
      renderizarMuralPublico();

      alert(`ðŸŽ–ï¸ CADASTRO LOCALIZADO COM SUCESSO!\n\nBem-vindo, ${(militar.grad || 'Sd')} ${(militar.guerra || militar.nome)}!\n\nA lista dos soldados da ${militar.cia} foi liberada permanentemente neste aparelho.`);

      setTimeout(() => {
        const el = document.getElementById('areaListaCompanhiaPublica');
        if (el) el.scrollIntoView({ behavior: 'smooth' });
      }, 300);
    }

    function renderizarMuralPublico() {
      const bloqueadoCard = document.getElementById('muralBloqueadoCard');
      const liberadoCard = document.getElementById('muralLiberadoCard');
      const container = document.getElementById('gridSoldadosCiaLiberada');
      if (!bloqueadoCard || !liberadoCard || !container) return;

      const isAdmin = verificarAdminLogado();
      const inscricaoCia = localStorage.getItem('veterano_inscrito_cia') || sessionStorage.getItem('veterano_inscrito_cia');
      const inscricaoNome = localStorage.getItem('veterano_inscrito_nome') || sessionStorage.getItem('veterano_inscrito_nome') || '';

      // A lista só é liberada a partir do momento em que faz a inscrição ou se for o Admin
      const liberado = Boolean(inscricaoCia || isAdmin);

      if (!liberado) {
        bloqueadoCard.classList.remove('hidden');
        liberadoCard.classList.add('hidden');
        return;
      }

      bloqueadoCard.classList.add('hidden');
      liberadoCard.classList.remove('hidden');

      // Usa a companhia ativa do mural público ou a companhia cadastrada
      const ciaAlvo = ciaAtivaMuralPub || inscricaoCia || (ciaAtiva !== 'TODAS' && ciaAtiva !== 'NOVOS' ? ciaAtiva : '1º Cia Eng Cmb Bld');
      
      const tituloCia = document.getElementById('tituloCiaLiberada');
      if (tituloCia) {
        const masc = obterMascoteCia(ciaAlvo);
        if (masc && masc.svg) {
          tituloCia.innerHTML = `
            <img src="${masc.svg}" alt="${masc.nome}" class="w-8 h-8 sm:w-10 sm:h-10 inline-block mr-2.5 object-contain filter drop-shadow">
            <span>${ciaAlvo}</span>
            <span class="ml-2.5 text-xs sm:text-sm px-2.5 py-0.5 rounded font-black uppercase ${masc.bgTag}">Mascote: ${masc.badge}</span>
          `;
        } else {
          tituloCia.innerText = ciaAlvo;
        }
      }
      montarBotoesMuralPublico(ciaAlvo);

      // Filtra os integrantes daquela companhia
      let lista = integrantedAtuais.filter(i => normalizarCia(i.cia) === normalizarCia(ciaAlvo));

      const badgeContagem = document.getElementById('badgeContagemCiaLiberada');
      if (badgeContagem) badgeContagem.innerText = `${lista.length} Soldados`;

      // Se tiver ano do cadastro do veterano e o campo estiver vazio na primeira abertura, preenche
      const inputAno = document.getElementById('filtroMuralPubAno');
      const anoInscrito = sessionStorage.getItem('veterano_inscrito_ano');
      if (anoInscrito && inputAno && !inputAno.dataset.iniciado) {
        inputAno.value = anoInscrito;
        inputAno.dataset.iniciado = "true";
      }

      // Filtros de busca no mural público
      const busca = (document.getElementById('filtroMuralPubBusca')?.value || '').toLowerCase().trim();
      const anoFiltro = (inputAno?.value || '').trim();

      if (busca) {
        lista = lista.filter(i => 
          (i.nome && i.nome.toLowerCase().includes(busca)) ||
          (i.guerra && i.guerra.toLowerCase().includes(busca)) ||
          (i.cidade && i.cidade.toLowerCase().includes(busca))
        );
      }

      if (anoFiltro) {
        lista = lista.filter(i => i.ano && i.ano.toString() === anoFiltro);
      }

      // Atualiza faixa de status do ano puxado
      const txtStatus = document.getElementById('txtStatusAnoMural');
      const qtdStatus = document.getElementById('qtdAnoPuxadoMural');
      if (txtStatus && qtdStatus) {
        if (anoFiltro) {
          txtStatus.innerHTML = `<span class="text-amber-300 font-bold"><i class="fa-solid fa-calendar-check mr-1 text-emerald-400"></i> Turma de ${anoFiltro}:</span> Militares que serviram no ano de <strong class="text-white">${anoFiltro}</strong> na <strong>${ciaAlvo}</strong>`;
          qtdStatus.innerText = `${lista.length} integrante(s) do ano ${anoFiltro}`;
        } else {
          txtStatus.innerHTML = `<i class="fa-solid fa-users text-emerald-400 mr-1.5"></i> Exibindo todos os anos da <strong>${ciaAlvo}</strong>. Digite o ano que serviu para puxar sua turma.`;
          qtdStatus.innerText = `${lista.length} militares no total`;
        }
      }

      // Ordenação: veterano que acabou de se inscrever fica em destaque no topo; depois ano decrescente e nome
      lista.sort((a, b) => {
        if (a.nome === inscricaoNome) return -1;
        if (b.nome === inscricaoNome) return 1;
        const anoA = parseInt(a.ano) || 0;
        const anoB = parseInt(b.ano) || 0;
        if (anoA !== anoB) return anoB - anoA;
        return (a.nome || '').localeCompare(b.nome || '');
      });

      container.innerHTML = '';

      if (lista.length === 0) {
        container.innerHTML = `<div class="col-span-full py-8 text-center text-slate-400 text-xs font-mono">Nenhum soldado encontrado com os filtros informados.</div>`;
        return;
      }

      const telefonesLiberados = verificarTelefonesLiberadosPublico() || isAdmin;

      lista.forEach(item => {
        const card = document.createElement('div');
        const ehProprio = (item.nome === inscricaoNome || item.isNovo);

        card.className = `p-3.5 rounded-xl border transition-all ${
          ehProprio 
            ? 'bg-[#1b3820] border-amber-400 shadow-[0_0_15px_rgba(212,175,55,0.25)]' 
            : 'bg-[#0e1710] border-[#223d26] hover:border-emerald-600/70'
        }`;

        const telDial = item.telDial || (item.tel || '').replace(/\D/g, '');

        // Regra solicitada: Nome e Ano que serviu. Telefone só se o Admin liberar!
        card.innerHTML = `
          <div class="flex items-start justify-between gap-2 mb-1.5">
            <div class="flex items-center space-x-1.5">
              <span class="px-2 py-0.5 bg-[#172c1c] text-emerald-400 border border-emerald-600/30 rounded text-[11px] font-bold military-font uppercase">
                ${item.grad || 'Sd'}
              </span>
              <span class="text-sm font-bold text-amber-300 military-font tracking-wide">
                ${item.guerra || (item.nome ? item.nome.split(' ')[0].toUpperCase() : '')}
              </span>
              ${ehProprio ? '<span class="px-1.5 py-0.2 bg-amber-500 text-slate-950 font-bold rounded text-[9px] uppercase tracking-wider">VOCÊ</span>' : ''}
            </div>
            <span onclick="puxarAnoDireto('${item.ano}')" class="cursor-pointer hover:bg-emerald-950 text-xs font-mono font-bold px-2 py-0.5 bg-[#09110a] text-emerald-400 border border-[#1e3823] rounded transition-all" title="Clique para puxar todos deste ano">
              Ano: ${item.ano || '--'} <i class="fa-solid fa-filter text-[9px] ml-0.5 text-amber-400"></i>
            </span>
          </div>

          <div class="text-xs font-semibold text-slate-100 line-clamp-1" title="${item.nome}">
            ${item.nome}
          </div>
          ${(() => {
            const st = obterStatusAlmocoMilitar(item);
            if (st && st.vaiAlmoco && st.statusPagamento === "PAGO") {
              const q = st.qtdAlmocos || 1;
              return `
                <div class="mt-1.5 flex items-center flex-wrap gap-1">
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-black uppercase bg-emerald-950 text-emerald-300 border border-emerald-500 shadow">
                    <i class="fa-solid fa-circle-check text-emerald-400 mr-1 text-[9px]"></i> ALMOÇO PAGO (${q} REF.)
                  </span>
                  ${st.entradaRealizada ? `
                    <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-bold font-mono bg-blue-950 text-blue-300 border border-blue-500/60 shadow">
                      <i class="fa-solid fa-check-double text-blue-400 mr-1"></i> ENTRADA FINALIZADA (${st.horaEntrada || "OK"})
                    </span>
                  ` : `
                    <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-bold font-mono bg-amber-950/80 text-amber-300 border border-amber-600/50">
                      <i class="fa-solid fa-door-open text-amber-400 mr-1"></i> AGUARDANDO ENTRADA
                    </span>
                  `}
                </div>
              `;
            }
            return "";
          })()}
          <div class="text-[11px] text-slate-400 mt-1 flex items-center space-x-1">
            <i class="fa-solid fa-location-dot text-slate-500 text-[10px]"></i>
            <span>${item.cidade || 'Não informada'}${item.uf ? ' - ' + item.uf : ''}</span>
          </div>

          <div class="mt-2.5 pt-2 border-t border-[#18291b] flex items-center justify-between text-xs">
            ${telefonesLiberados && item.tel ? `
              <span class="font-mono text-emerald-400 font-bold">${item.tel}</span>
              <a href="https://api.whatsapp.com/send?phone=${telDial.length <= 11 ? '55' + telDial : telDial}&text=${encodeURIComponent('Prezado Veterano ' + (item.guerra || item.nome) + ', sou veterano do 5º BE!')}" target="_blank"
                 class="px-2 py-0.5 bg-green-600 hover:bg-green-500 text-slate-950 font-bold rounded text-[10px] flex items-center space-x-1">
                <i class="fa-brands fa-whatsapp"></i> <span>Contato</span>
              </a>
            ` : `
              <span class="text-slate-500 text-[11px] font-mono flex items-center">
                <i class="fa-solid fa-lock text-amber-500/80 mr-1.5 text-[10px]"></i> Telefone restrito ao Admin
              </span>
            `}
          </div>
        `;

        container.appendChild(card);
      });
    }

    function filtrarMuralPublico() {
      renderizarMuralPublico();
    }

    function limparFiltroAnoMural() {
      const inputAno = document.getElementById('filtroMuralPubAno');
      if (inputAno) {
        inputAno.value = '';
        inputAno.dataset.iniciado = "true";
      }
      const inputBusca = document.getElementById('filtroMuralPubBusca');
      if (inputBusca) inputBusca.value = '';
      renderizarMuralPublico();
    }

    function puxarAnoDireto(ano) {
      if (!ano || ano === '--') return;
      const inputAno = document.getElementById('filtroMuralPubAno');
      if (inputAno) {
        inputAno.value = ano;
        inputAno.dataset.iniciado = "true";
        renderizarMuralPublico();
        inputAno.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    }

    function montarBotoesMuralPublico(ciaAtual) {
      const container = document.getElementById('botoesCiasMuralPub');
      if (!container) return;
      container.innerHTML = '';

      const cias = [
        { id: "1º Cia Eng Cmb Bld", label: "1ª Cia", animal: "Leão", svg: "animal_leao.svg" },
        { id: "2º Cia Eng Cmb Bld", label: "2ª Cia", animal: "Onça", svg: "animal_onca.svg" },
        { id: "Cia Cmdo e Ap - (CCAp)", label: "CCAp", animal: "Pantera", svg: "animal_pantera.svg" },
        { id: "Cia Eng Pnt (CEP)", label: "CEP", animal: "Águia", svg: "animal_aguia.svg" },
        { id: "Estado Maior Geral e Especial", label: "Estado-Maior", icone: "fa-solid fa-star" },
        { id: "NPOR", label: "NPOR", icone: "fa-solid fa-graduation-cap" }
      ];

      const minhaCia = localStorage.getItem('veterano_inscrito_cia') || sessionStorage.getItem('veterano_inscrito_cia');

      cias.forEach(c => {
        const isActive = normalizarCia(c.id) === normalizarCia(ciaAtual);
        const count = integrantedAtuais.filter(i => normalizarCia(i.cia) === normalizarCia(c.id)).length;
        const ehMinhaCia = minhaCia && normalizarCia(minhaCia) === normalizarCia(c.id);

        const btn = document.createElement('button');
        btn.type = 'button';
        btn.onclick = () => {
          ciaAtivaMuralPub = c.id;
          renderizarMuralPublico();
        };

        btn.className = `group px-3 py-1.5 rounded-lg text-xs font-bold military-font uppercase flex items-center transition-all ${
          isActive 
            ? 'bg-amber-500 text-slate-950 font-extrabold shadow-md ring-2 ring-amber-300' 
            : 'bg-[#122115] text-slate-300 hover:bg-[#1a3320] border border-[#233f28]'
        }`;

        let imgHtml = '';
        if (c.svg) {
          imgHtml = `<img src="${c.svg}" alt="${c.animal}" class="w-5 h-5 mr-1.5 object-contain filter drop-shadow group-hover:scale-110 transition-transform">`;
        } else {
          imgHtml = `<i class="${c.icone} mr-1.5 text-xs ${isActive ? 'text-slate-950' : 'text-amber-400'}"></i>`;
        }

        btn.innerHTML = `
          ${imgHtml}
          <span>${c.label}</span>
          ${c.animal ? `<span class="ml-1 px-1.5 py-0.2 rounded text-[9px] font-black ${isActive ? 'bg-slate-950 text-amber-300' : 'bg-black/60 text-amber-400 border border-amber-500/30'}">${c.animal}</span>` : ''}
          ${ehMinhaCia ? `<span class="ml-1 px-1.5 py-0.2 rounded text-[9px] font-black ${isActive ? 'bg-black text-amber-300' : 'bg-amber-500 text-slate-950'}">SUA CIA</span>` : ''}
          <span class="ml-1.5 px-1.5 py-0.2 rounded-full text-[10px] font-mono ${isActive ? 'bg-amber-600/70 text-slate-950' : 'bg-emerald-950 text-emerald-400 border border-emerald-700/50'}">${count}</span>
        `;
        container.appendChild(btn);
      });
    }

    // Monta os botões das Companhias com contagem e desenhos dos animais mascotes
    function montarBotoesCompanhias() {
      const container = document.getElementById('botoesCompanhia');
      if (!container) return;
      container.innerHTML = '';

      let novos = [];
      try {
        const stored = localStorage.getItem('novos_veteranos_5be');
        if (stored) novos = JSON.parse(stored);
      } catch (e) {}

      CIAS_ORDEM.forEach(c => {
        let count = 0;
        if (c.id === 'TODAS') {
          count = integrantedAtuais.length;
        } else if (c.id === 'NOVOS') {
          count = novos.length;
        } else {
          count = integrantedAtuais.filter(item => normalizarCia(item.cia) === normalizarCia(c.id)).length;
        }

        const btn = document.createElement('button');
        btn.id = `btn-cia-${c.id}`;
        btn.onclick = () => selecionarCia(c.id);

        const isActive = (c.id === ciaAtiva);
        btn.className = `group px-3 py-1.5 rounded-lg text-xs font-bold military-font uppercase flex items-center transition-all shadow-sm ${
          isActive 
            ? 'bg-amber-500 text-slate-950 shadow-md font-extrabold ring-2 ring-amber-300' 
            : 'bg-[#142316] text-slate-300 hover:bg-[#1e3422] border border-[#233b26] hover:border-amber-400/50'
        }`;

        let iconOrSvg = '';
        let badgeMascote = '';

        if (c.svg) {
          iconOrSvg = `<img src="${c.svg}" alt="${c.animal}" class="w-5 h-5 mr-1.5 object-contain filter drop-shadow inline-block group-hover:scale-110 transition-transform">`;
          badgeMascote = `<span class="ml-1 px-1.5 py-0.2 rounded text-[9px] font-black tracking-wider ${
            isActive ? 'bg-slate-950 text-amber-300' : 'bg-black/60 text-amber-400 border border-amber-500/30'
          }">${c.animal}</span>`;
        } else {
          iconOrSvg = `<i class="${c.icone} mr-1.5 text-xs ${isActive ? 'text-slate-950' : 'text-amber-400'}"></i>`;
        }

        btn.innerHTML = `
          ${iconOrSvg}
          <span>${c.label}</span>
          ${badgeMascote}
          <span class="ml-1.5 px-1.5 py-0.2 rounded-full text-[10px] font-mono font-bold ${
            isActive ? 'bg-amber-600/70 text-slate-950' : 'bg-emerald-950 text-emerald-400 border border-emerald-700/50'
          }">${count}</span>
        `;
        container.appendChild(btn);
      });
    }

    function selecionarCia(ciaId) {
      ciaAtiva = ciaId;
      montarBotoesCompanhias();
      aplicarFiltros();
      atualizarInfoExportacao();
    }

    // Filtragem em Tempo Real
    function aplicarFiltros() {
      const busca = document.getElementById('campoBusca').value.toLowerCase().trim();
      const filtroGrad = document.getElementById('filtroGraduacao').value;
      const filtroUF = document.getElementById('filtroEstado').value;

      let novos = [];
      try {
        const stored = localStorage.getItem('novos_veteranos_5be');
        if (stored) novos = JSON.parse(stored);
      } catch (e) {}

      let lista = (ciaAtiva === 'NOVOS') ? [...novos] : [...integrantedAtuais];

      // Filtro por Cia
      if (ciaAtiva !== 'TODAS' && ciaAtiva !== 'NOVOS') {
        lista = lista.filter(item => normalizarCia(item.cia) === normalizarCia(ciaAtiva));
      }

      // Filtro por Graduação
      if (filtroGrad) {
        lista = lista.filter(item => item.grad === filtroGrad);
      }

      // Filtro por Estado
      if (filtroUF) {
        if (filtroUF === 'Outros') {
          const principais = ['Santa Catarina', 'Paraná', 'São Paulo', 'Distrito Federal', 'Rio de Janeiro', 'Rio Grande do Sul', 'Minas Gerais'];
          lista = lista.filter(item => !principais.includes(item.uf));
        } else {
          lista = lista.filter(item => item.uf === filtroUF);
        }
      }

      // Filtro por Texto Livre
      if (busca) {
        lista = lista.filter(item => {
          const texto = `${item.id} ${item.nome} ${item.guerra} ${item.tel} ${item.cidade} ${item.uf} ${item.cpf} ${item.email}`.toLowerCase();
          return texto.includes(busca);
        });
      }

      renderizarTabela(lista);
      document.getElementById('labelContagemFiltrada').innerText = `${lista.length} Integrantes`;
      
      if (!document.getElementById('aba-mensagens').classList.contains('hidden')) {
        atualizarFilaDisparo(lista);
      }
    }

    function limparFiltros() {
      document.getElementById('campoBusca').value = '';
      document.getElementById('filtroGraduacao').value = '';
      document.getElementById('filtroEstado').value = '';
      ciaAtiva = 'TODAS';
      montarBotoesCompanhias();
      aplicarFiltros();
    }

    // Renderiza a Tabela
    function renderizarTabela(lista) {
      const tbody = document.getElementById('tabelaIntegrantes');
      const semResultados = document.getElementById('semResultados');
      tbody.innerHTML = '';

      if (lista.length === 0) {
        semResultados.classList.remove('hidden');
        return;
      }
      semResultados.classList.add('hidden');

      lista.forEach(item => {
        const tr = document.createElement('tr');
        tr.className = "hover:bg-[#152518] transition-colors border-b border-[#18291a]";

        let badgeClasse = "badge-praca";
        if (['Gen', 'Cel', 'Ten Cel', 'Maj', 'Cap', 'Ten'].includes(item.grad)) {
          badgeClasse = "badge-oficial";
        } else if (['Sgt', 'Sub Ten'].includes(item.grad)) {
          badgeClasse = "badge-sgt";
        }

        const isChecked = selecionadosIDs.has(item.id) ? 'checked' : '';
        const dialNumber = item.telDial || (item.tel || '').replace(/\D/g, '');
        const msgWhats = encodeURIComponent(`Olá ${item.grad ? item.grad + ' ' : ''}${item.guerra || item.nome}, saudações da Comissão dos Veteranos do 5º BE!`);

        tr.innerHTML = `
          <td class="p-3 text-center">
            <input type="checkbox" value="${item.id}" ${isChecked} onchange="toggleSelecaoItem(this, ${item.id})"
                   class="w-4 h-4 rounded text-emerald-600 bg-slate-800 border-slate-600 focus:ring-0">
          </td>
          <td class="p-3 text-center font-mono font-bold text-slate-400">${item.id}</td>
          <td class="p-3">
            <span class="px-2 py-0.5 rounded text-[11px] font-bold military-font uppercase ${badgeClasse}">
              ${item.grad || 'Sd / Reserv.'}
            </span>
          </td>
          <td class="p-3 font-semibold text-slate-100">
            ${item.nome}
            ${item.isNovo ? '<span class="ml-1.5 px-1.5 py-0.5 bg-purple-900/80 text-purple-300 border border-purple-500/50 rounded text-[9px] font-bold tracking-wider">NOVO</span>' : ''}
            ${(() => {
              const st = obterStatusAlmocoMilitar(item);
              if (st && st.vaiAlmoco && st.statusPagamento === "PAGO") {
                const q = st.qtdAlmocos || 1;
                return `
                  <div class="mt-1 flex items-center flex-wrap gap-1">
                    <span class="px-2 py-0.5 bg-emerald-950 text-emerald-300 border border-emerald-500 rounded text-[10px] font-black uppercase inline-flex items-center shadow">
                      <i class="fa-solid fa-circle-check text-emerald-400 mr-1 text-[9px]"></i> ALMOÇO PAGO (${q} ref.)
                    </span>
                    ${st.entradaRealizada ? `
                      <span class="px-1.5 py-0.5 bg-blue-950 text-blue-300 border border-blue-500/60 rounded text-[9px] font-mono font-bold">
                        <i class="fa-solid fa-check-double text-blue-400 mr-0.5"></i> Entrou (${st.horaEntrada || "OK"})
                      </span>
                    ` : ""}
                  </div>
                `;
              }
              return "";
            })()}
          </td>
          <td class="p-3 font-bold text-amber-400 military-font uppercase">${item.guerra || '-'}</td>
          <td class="p-3 text-slate-300">
            ${(() => {
              const mascCia = obterMascoteCia(item.cia);
              return mascCia && mascCia.svg 
                ? `<div class="inline-flex items-center space-x-1.5"><img src="${mascCia.svg}" alt="${mascCia.nome}" class="w-4 h-4 object-contain filter drop-shadow"><span>${item.cia}</span><span class="text-[9px] px-1 py-0.2 rounded font-black ${mascCia.bgTag}">${mascCia.badge}</span></div>`
                : (item.cia || '-');
            })()}
          </td>
          <td class="p-3 text-center font-mono text-slate-400">${item.ano || '-'}</td>
          <td class="p-3 font-mono font-medium text-emerald-400 whitespace-nowrap">${item.tel || '-'}</td>
          <td class="p-3 text-slate-300 whitespace-nowrap">${item.cidade ? item.cidade + ' - ' + item.uf : '-'}</td>
          <td class="p-3 text-center whitespace-nowrap">
            <div class="flex items-center justify-center space-x-1.5">
              <a href="https://api.whatsapp.com/send?phone=${dialNumber}&text=${msgWhats}" target="_blank"
                 title="Enviar WhatsApp"
                 class="w-7 h-7 bg-green-600 hover:bg-green-500 text-slate-950 rounded flex items-center justify-center text-xs font-bold transition-transform hover:scale-110">
                <i class="fa-brands fa-whatsapp text-sm"></i>
              </a>
              <button onclick='abrirModalFicha(${JSON.stringify(item)})'
                      title="Ver Ficha Completa"
                      class="w-7 h-7 bg-[#1e3422] hover:bg-[#2c4d32] text-amber-400 rounded flex items-center justify-center text-xs font-bold transition-all">
                <i class="fa-solid fa-eye"></i>
              </button>
            </div>
          </td>
        `;
        tbody.appendChild(tr);
      });

      atualizarBadgeSelecionados();
    }

    // Seleção de Itens
    function toggleSelecaoItem(check, id) {
      if (check.checked) {
        selecionadosIDs.add(id);
      } else {
        selecionadosIDs.delete(id);
      }
      atualizarBadgeSelecionados();
      atualizarInfoExportacao();
    }

    function toggleSelecionarTodos(check) {
      const inputs = document.querySelectorAll('#tabelaIntegrantes input[type="checkbox"]');
      inputs.forEach(input => {
        input.checked = check.checked;
        const id = parseInt(input.value);
        if (check.checked) {
          selecionadosIDs.add(id);
        } else {
          selecionadosIDs.delete(id);
        }
      });
      atualizarBadgeSelecionados();
      atualizarInfoExportacao();
    }

    function atualizarBadgeSelecionados() {
      const label = document.getElementById('contagemSelecionados');
      if (selecionadosIDs.size > 0) {
        label.classList.remove('hidden');
        label.innerText = `(${selecionadosIDs.size} selecionados)`;
      } else {
        label.classList.add('hidden');
      }
    }

    function abrirMensagensComSelecionados() {
      trocarAbaPrincipal('mensagens');
    }

    // ==========================================
    // SISTEMA DE EXPORTAÇÃO POR COMPANHIA
    // ==========================================

    function sanitizarNomeArquivo(nome) {
      return nome
        .normalize('NFD').replace(/[\u0300-\u036f]/g, "") // remove acentos
        .replace(/º|ª|°/g, "")
        .replace(/[^a-zA-Z0-9_-]/g, "_")
        .replace(/_+/g, "_")
        .replace(/^_|_$/g, "");
    }

    function obterListaParaExportacao() {
      const escopo = document.getElementById('seletorCiaExportar').value;
      let lista = [];
      let nomeLabel = "";

      if (escopo === 'SELECIONADOS') {
        lista = integrantedAtuais.filter(i => selecionadosIDs.has(i.id));
        nomeLabel = "Selecionados";
      } else if (escopo === 'ATUAL') {
        if (ciaAtiva === 'NOVOS') {
          try { lista = JSON.parse(localStorage.getItem('novos_veteranos_5be') || '[]'); } catch(e){}
          nomeLabel = "Novos_Cadastros";
        } else if (ciaAtiva !== 'TODAS') {
          lista = integrantedAtuais.filter(i => i.cia === ciaAtiva);
          nomeLabel = ciaAtiva;
        } else {
          lista = [...integrantedAtuais];
          nomeLabel = "Todas_Companhias";
        }
      } else if (escopo === 'TODAS') {
        lista = [...integrantedAtuais];
        nomeLabel = "Todas_Companhias";
      } else {
        lista = integrantedAtuais.filter(i => i.cia === escopo);
        nomeLabel = escopo;
      }

      return { lista, nomeLabel };
    }

    function atualizarInfoExportacao() {
      const txtSpan = document.getElementById('txtCiaAtivaSpan');
      if (txtSpan) {
        txtSpan.innerText = ciaAtiva === 'TODAS' ? 'Todas as Cias' : ciaAtiva;
      }

      const { lista, nomeLabel } = obterListaParaExportacao();
      const label = document.getElementById('labelTotalExportar');
      if (label) {
        label.innerText = `${lista.length} Integrantes`;
      }

      // Atualiza badges da seção simplificada
      const badgeNomes = document.getElementById('badgeQtdNomes');
      const badgeTels = document.getElementById('badgeQtdTelefones');
      const badgeAmbos = document.getElementById('badgeQtdAmbos');
      if (badgeNomes) badgeNomes.innerText = `${lista.length} nomes`;
      if (badgeTels) badgeTels.innerText = `${lista.length} telefones`;
      if (badgeAmbos) badgeAmbos.innerText = `${lista.length} registros`;

      // Atualiza pré-visualização ao vivo
      atualizarPreviewSimples();
    }

    function triggerDownload(content, filename, mimeType) {
      const blob = new Blob([content], { type: mimeType });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }

    // Gerador de Planilha CSV Completa
    function gerarConteudoCSV(lista) {
      const header = "ID;Nome Completo;Nome de Guerra;Graduação;Companhia (5º BE);Ano Incorporação;Telefone;Telefone Internacional;E-mail;CPF;Data de Nascimento;Logradouro;Bairro;Cidade;UF;Endereço Completo";
      const rows = lista.map(c => [
        c.id || '',
        `"${(c.nome || '').replace(/"/g, '""')}"`,
        `"${(c.guerra || '').replace(/"/g, '""')}"`,
        `"${(c.grad || '').replace(/"/g, '""')}"`,
        `"${(c.cia || '').replace(/"/g, '""')}"`,
        c.ano || '',
        `"${c.tel || ''}"`,
        `"${c.telDial ? '+' + c.telDial : ''}"`,
        `"${(c.email || '').replace(/"/g, '""')}"`,
        `"${c.cpf || ''}"`,
        c.nasc || '',
        `"${(c.rua || '').replace(/"/g, '""')}"`,
        `"${(c.bairro || '').replace(/"/g, '""')}"`,
        `"${(c.cidade || '').replace(/"/g, '""')}"`,
        `"${(c.uf || '').replace(/"/g, '""')}"`,
        `"${(c.endereco || '').replace(/"/g, '""')}"`
      ].join(";"));
      
      return "\uFEFF" + [header, ...rows].join("\r\n");
    }

    // Gerador de VCF Celular
    function gerarConteudoVCF(lista) {
      let vcf = "";
      lista.forEach(c => {
        vcf += "BEGIN:VCARD\r\nVERSION:3.0\r\n";
        const displayName = c.grad ? `${c.grad} ${c.nome}` : c.nome;
        vcf += `FN:${displayName}\r\n`;
        
        const parts = (c.nome || '').split(' ').filter(p => p.trim());
        let firstName = parts[0] || '';
        let lastName = parts.length > 1 ? parts[parts.length - 1] : '';
        let middleNames = parts.length > 2 ? parts.slice(1, parts.length - 1).join(' ') : '';
        vcf += `N:${lastName};${firstName};${middleNames};${c.grad || ''};\r\n`;
        
        if (c.guerra) vcf += `NICKNAME:${c.guerra}\r\n`;
        
        const org = c.cia ? `5º BE - ${c.cia}` : '5º Batalhão de Engenharia (5º BE)';
        vcf += `ORG:${org}\r\n`;
        if (c.grad) vcf += `TITLE:${c.grad}\r\n`;
        
        const dial = c.telDial ? `+${c.telDial}` : (c.tel || '').replace(/\D/g, '');
        if (dial) vcf += `TEL;TYPE=CELL,VOICE:${dial}\r\n`;
        if (c.email) vcf += `EMAIL;TYPE=INTERNET,HOME:${c.email}\r\n`;
        
        if (c.rua || c.cidade || c.uf) {
          let street = c.rua || '';
          if (c.bairro) street = street ? `${street}, ${c.bairro}` : c.bairro;
          vcf += `ADR;TYPE=HOME:;;${street};${c.cidade || ''};${c.uf || ''};;Brasil\r\n`;
        }
        
        let notes = ["5º Batalhão de Engenharia de Combate Blindado (5º BE)"];
        if (c.id) notes.push(`ID: ${c.id}`);
        if (c.grad) notes.push(`Graduação: ${c.grad}`);
        if (c.guerra) notes.push(`Guerra: ${c.guerra}`);
        if (c.cia) notes.push(`Companhia: ${c.cia}`);
        if (c.ano) notes.push(`Ano Inc: ${c.ano}`);
        if (c.cpf) notes.push(`CPF: ${c.cpf}`);
        vcf += `NOTE:${notes.join(' \\n ')}\r\n`;
        
        vcf += "END:VCARD\r\n";
      });
      return vcf;
    }

    // Gerador de Google Contatos CSV
    function gerarConteudoGoogleCSV(lista) {
      const header = "Name,Given Name,Family Name,Additional Name,Nickname,Organization 1 - Name,Organization 1 - Title,E-mail 1 - Type,E-mail 1 - Value,Phone 1 - Type,Phone 1 - Value,Address 1 - Type,Address 1 - Formatted,Address 1 - Street,Address 1 - City,Address 1 - Region,Notes";
      const rows = lista.map(c => {
        const parts = (c.nome || '').split(' ').filter(p => p.trim());
        const first = parts[0] || '';
        const last = parts.length > 1 ? parts[parts.length - 1] : '';
        const middle = parts.length > 2 ? parts.slice(1, parts.length - 1).join(' ') : '';
        const displayName = c.grad ? `${c.grad} ${c.nome}` : c.nome;
        const org = c.cia ? `5º BE - ${c.cia}` : '5º BE';
        const notes = `ID: ${c.id}; Guerra: ${c.guerra}; Inc: ${c.ano}; Cia: ${c.cia}`;
        let street = c.rua || '';
        if (c.bairro) street = street ? `${street}, ${c.bairro}` : c.bairro;

        return [
          `"${displayName.replace(/"/g, '""')}"`,
          `"${first.replace(/"/g, '""')}"`,
          `"${last.replace(/"/g, '""')}"`,
          `"${middle.replace(/"/g, '""')}"`,
          `"${(c.guerra || '').replace(/"/g, '""')}"`,
          `"${org.replace(/"/g, '""')}"`,
          `"${(c.grad || '').replace(/"/g, '""')}"`,
          "Home",
          `"${(c.email || '').replace(/"/g, '""')}"`,
          "Mobile",
          `"${c.telDial ? '+' + c.telDial : c.tel}"`,
          "Home",
          `"${(c.endereco || '').replace(/"/g, '""')}"`,
          `"${street.replace(/"/g, '""')}"`,
          `"${(c.cidade || '').replace(/"/g, '""')}"`,
          `"${(c.uf || '').replace(/"/g, '""')}"`,
          `"${notes.replace(/"/g, '""')}"`
        ].join(",");
      });

      return "\uFEFF" + [header, ...rows].join("\r\n");
    }

    // ==========================================
    // EXPORTAÇÃO SIMPLIFICADA (APENAS NOMES OU TELEFONES)
    // ==========================================

    function obterFormatoTelefoneEscolhido() {
      const radios = document.getElementsByName('formatoTel');
      for (let r of radios) {
        if (r.checked) return r.value;
      }
      return 'formatado';
    }

    function formatarNomeSimples(c) {
      let n = c.grad ? `${c.grad} ${c.nome}` : c.nome;
      if (c.guerra) n += ` (${c.guerra})`;
      return n;
    }

    function formatarTelefoneSimples(c, formato) {
      if (formato === 'digitos') {
        return c.telDial || (c.tel || '').replace(/\D/g, '');
      }
      return c.tel || '';
    }

    function atualizarPreviewSimples() {
      const { lista } = obterListaParaExportacao();
      const formatoTel = obterFormatoTelefoneEscolhido();
      const previewEl = document.getElementById('caixaPreviewExportacao');
      if (!previewEl) return;

      if (!lista || lista.length === 0) {
        previewEl.innerText = "Nenhum integrante selecionado.";
        return;
      }

      const primeiras = lista.slice(0, 10);
      let linhas = primeiras.map((c, idx) => {
        const n = formatarNomeSimples(c);
        const t = formatarTelefoneSimples(c, formatoTel);
        return `${String(idx + 1).padStart(2, '0')}. ${n} -> ${t}`;
      });

      if (lista.length > 10) {
        linhas.push(`... e mais ${lista.length - 10} integrantes.`);
      }

      previewEl.innerText = linhas.join('\n');
    }

    function executarDownloadSimples(tipo, formatoArquivo) {
      const { lista, nomeLabel } = obterListaParaExportacao();
      if (!lista || lista.length === 0) {
        alert("Nenhum integrante selecionado para exportar.");
        return;
      }

      const slug = sanitizarNomeArquivo(nomeLabel);
      const formatoTel = obterFormatoTelefoneEscolhido();

      let conteudo = "";
      let extensao = formatoArquivo === 'CSV' ? 'csv' : 'txt';
      let mimeType = formatoArquivo === 'CSV' ? 'text/csv;charset=utf-8;' : 'text/plain;charset=utf-8;';
      let nomeFinal = "";

      if (tipo === 'NOMES') {
        nomeFinal = `apenas_nomes_${slug}.${extensao}`;
        if (formatoArquivo === 'CSV') {
          const header = "Nome Completo;Nome de Guerra;Graduação;Companhia";
          const rows = lista.map(c => `"${c.nome}";"${c.guerra || ''}";"${c.grad || ''}";"${c.cia || ''}"`);
          conteudo = "\uFEFF" + [header, ...rows].join("\r\n");
        } else {
          conteudo = "\uFEFF" + lista.map(c => formatarNomeSimples(c)).join("\r\n");
        }
      } else if (tipo === 'TELEFONES') {
        nomeFinal = `apenas_telefones_${slug}.${extensao}`;
        if (formatoArquivo === 'CSV') {
          const header = "Telefone;Nome Completo;Companhia";
          const rows = lista.map(c => `"${formatarTelefoneSimples(c, formatoTel)}";"${c.nome}";"${c.cia || ''}"`);
          conteudo = "\uFEFF" + [header, ...rows].join("\r\n");
        } else {
          conteudo = "\uFEFF" + lista.map(c => formatarTelefoneSimples(c, formatoTel)).filter(t => t).join("\r\n");
        }
      } else if (tipo === 'NOME_E_TEL') {
        nomeFinal = `nome_e_telefone_${slug}.${extensao}`;
        if (formatoArquivo === 'CSV') {
          const header = "Nome Completo;Telefone;Nome de Guerra;Companhia";
          const rows = lista.map(c => `"${c.nome}";"${formatarTelefoneSimples(c, formatoTel)}";"${c.guerra || ''}";"${c.cia || ''}"`);
          conteudo = "\uFEFF" + [header, ...rows].join("\r\n");
        } else {
          conteudo = "\uFEFF" + lista.map(c => `${formatarNomeSimples(c)} - ${formatarTelefoneSimples(c, formatoTel)}`).join("\r\n");
        }
      }

      triggerDownload(conteudo, nomeFinal, mimeType);
    }

    function executarCopiarSimples(tipo) {
      const { lista, nomeLabel } = obterListaParaExportacao();
      if (!lista || lista.length === 0) {
        alert("Nenhum integrante selecionado.");
        return;
      }

      const formatoTel = obterFormatoTelefoneEscolhido();
      let texto = "";

      if (tipo === 'NOMES') {
        texto = lista.map(c => formatarNomeSimples(c)).join("\n");
        navigator.clipboard.writeText(texto).then(() => {
          alert(`✅ ${lista.length} Nomes copiados com sucesso (${nomeLabel})!`);
        });
      } else if (tipo === 'TELEFONES') {
        texto = lista.map(c => formatarTelefoneSimples(c, formatoTel)).filter(t => t).join("\n");
        navigator.clipboard.writeText(texto).then(() => {
          alert(`✅ ${lista.length} Telefones copiados com sucesso (${nomeLabel})!`);
        });
      } else if (tipo === 'NOME_E_TEL') {
        texto = lista.map(c => `${formatarNomeSimples(c)} - ${formatarTelefoneSimples(c, formatoTel)}`).join("\n");
        navigator.clipboard.writeText(texto).then(() => {
          alert(`✅ ${lista.length} Contatos (Nome + Telefone) copiados com sucesso (${nomeLabel})!`);
        });
      }
    }

    // Exportação Rápida Direta da Tabela de Integrantes
    function obterListaVisivelTabela() {
      const busca = document.getElementById('campoBusca').value.toLowerCase().trim();
      const filtroGrad = document.getElementById('filtroGraduacao').value;
      const filtroUF = document.getElementById('filtroEstado').value;

      let lista = (ciaAtiva === 'NOVOS') ? JSON.parse(localStorage.getItem('novos_veteranos_5be') || '[]') : [...integrantedAtuais];
      if (ciaAtiva !== 'TODAS' && ciaAtiva !== 'NOVOS') {
        lista = lista.filter(item => item.cia === ciaAtiva);
      }
      if (filtroGrad) lista = lista.filter(item => item.grad === filtroGrad);
      if (filtroUF) {
        if (filtroUF === 'Outros') {
          const principais = ['Santa Catarina', 'Paraná', 'São Paulo', 'Distrito Federal', 'Rio de Janeiro', 'Rio Grande do Sul', 'Minas Gerais'];
          lista = lista.filter(item => !principais.includes(item.uf));
        } else {
          lista = lista.filter(item => item.uf === filtroUF);
        }
      }
      if (busca) {
        lista = lista.filter(item => `${item.id} ${item.nome} ${item.guerra} ${item.tel} ${item.cidade} ${item.uf}`.toLowerCase().includes(busca));
      }
      return lista;
    }

    function exportarCompanhiaAtualCSV() {
      const lista = obterListaVisivelTabela();
      if (lista.length === 0) return alert("Nenhum integrante filtrado para exportar.");
      const slug = sanitizarNomeArquivo(ciaAtiva === 'TODAS' ? 'Todas_Companhias' : ciaAtiva);
      const csv = gerarConteudoCSV(lista);
      triggerDownload(csv, `veteranos_${slug}.csv`, 'text/csv;charset=utf-8;');
    }


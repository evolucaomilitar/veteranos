            </div>
          </div>

          <div class="overflow-x-auto custom-scroll max-h-96 tactical-card rounded-lg border border-[#233b26]">
            <table class="w-full text-left text-xs border-collapse">
              <thead class="bg-[#142316] text-amber-400 uppercase military-font sticky top-0 z-10 border-b border-[#28442b]">

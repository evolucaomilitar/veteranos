    // Executa download na aba Exportar
    function executarDownloadCompanhia(tipo) {
      const { lista, nomeLabel } = obterListaParaExportacao();
      if (!lista || lista.length === 0) {
        alert("Nenhum integrante encontrado para exportar com os critérios selecionados.");
        return;
      }

      const slug = sanitizarNomeArquivo(nomeLabel);

      if (tipo === 'CSV') {
        const conteudo = gerarConteudoCSV(lista);
        triggerDownload(conteudo, `veteranos_${slug}.csv`, 'text/csv;charset=utf-8;');
      } else if (tipo === 'VCF') {
        const conteudo = gerarConteudoVCF(lista);
        triggerDownload(conteudo, `contatos_${slug}.vcf`, 'text/vcard;charset=utf-8;');
      } else if (tipo === 'GOOGLE') {
        const conteudo = gerarConteudoGoogleCSV(lista);
        triggerDownload(conteudo, `google_contacts_${slug}.csv`, 'text/csv;charset=utf-8;');
      }
    }


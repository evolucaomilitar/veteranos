<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title>Cadastro Oficial de Veteranos - 5º BE Cmb Bld</title>

  <!-- Configurações PWA: Aplicativo para Celular & Computador -->
  <link rel="manifest" href="manifest.json">
  <meta name="theme-color" content="#0a110b">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Veteranos 5º BE">
  <link rel="apple-touch-icon" href="icon-192.png">
  <link rel="icon" type="image/png" sizes="192x192" href="icon-192.png">
  <link rel="icon" type="image/png" sizes="512x512" href="icon-512.png">
  <link rel="icon" type="image/png" href="logo_veteranos.png">
  <script src="pwa.js" defer></script>

  <!-- Tailwind CSS & FontAwesome -->
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <!-- Base de Dados de Veteranos do 5º BE -->
  <script src="dados.js"></script>
  <style>
    body {
      font-family: 'Inter', sans-serif;
      background-color: #0b120c;
      background-image: 
        radial-gradient(circle at 50% 0%, rgba(34, 197, 94, 0.12) 0%, transparent 70%),
        linear-gradient(to bottom, #0d160f 0%, #060a07 100%);
      color: #e2e8f0;
      min-height: 100vh;
    }
    .military-font {
      font-family: 'Rajdhani', sans-serif;
      letter-spacing: 0.5px;
    }
    .tactical-border {
      border: 1px solid #28442c;
      box-shadow: 0 0 25px rgba(0, 0, 0, 0.6), inset 0 0 15px rgba(40, 68, 44, 0.2);
    }
    .gold-gradient-text {
      background: linear-gradient(135deg, #fff2a3 0%, #d4af37 50%, #997300 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .tactical-input {
      background-color: #121f14;
      border: 1px solid #2b472f;
      color: #f1f5f9;
      transition: all 0.2s;
    }
    .tactical-input:focus {
      outline: none;
      border-color: #d4af37;
      box-shadow: 0 0 10px rgba(212, 175, 55, 0.3);
      background-color: #162819;
    }
    .custom-scroll::-webkit-scrollbar {
      width: 6px;
    }
    .custom-scroll::-webkit-scrollbar-track {
      background: #0a110b;
    }
    .custom-scroll::-webkit-scrollbar-thumb {
      background: #233f27;
      border-radius: 3px;
    }
  </style>
</head>
<body class="py-6 px-4 sm:px-6">

  <div class="max-w-3xl mx-auto space-y-6">
    
    <!-- Cabeçalho com Brasão e Acesso Admin -->
    <div class="text-center relative">
      <div class="flex justify-between items-center mb-3 gap-2">
        <!-- Logo Loja Evolução Militar com Link Externo -->
        <a href="https://www.evolucaomilitar.com.br" target="_blank" rel="noopener noreferrer"
           title="Loja Oficial Evolução Militar • Acesse: www.evolucaomilitar.com.br"
           class="group inline-flex flex-col items-center justify-center bg-[#060c07] hover:bg-black border border-[#2b4c2f] hover:border-amber-400/80 rounded-lg px-1.5 py-0.5 sm:px-2 sm:py-1 transition-all shadow-sm text-center">
          <video src="logo_evolucao_militar.mp4" poster="logo_evolucao_militar.jpg" autoplay loop muted playsinline class="h-11 sm:h-14 w-auto object-contain transition-transform group-hover:scale-105 rounded pointer-events-none">
            <img src="logo_evolucao_militar.jpg" alt="Loja Evolução Militar" class="h-11 sm:h-14 w-auto object-contain">
          </video>
          <span class="text-[9px] sm:text-[10px] font-black uppercase military-font text-amber-400 group-hover:text-amber-300 tracking-wider leading-none mt-0.5 flex items-center">
            ACESSE A LOJA <i class="fa-solid fa-arrow-up-right-from-square ml-1 text-[7px] text-amber-500"></i>
          </span>
        </a>

        <!-- AÃ§Ãµes do CabeÃ§alho: Ãrea Admin & Instalar App -->
        <div class="flex items-center space-x-2">
          <button onclick="abrirModalAdmin()" 
                  title="Acesso Restrito do Administrador com Senha"
                  class="px-3.5 py-1.5 bg-amber-600/20 hover:bg-amber-600/40 text-amber-300 border border-amber-500/50 hover:border-amber-400 rounded-lg text-xs military-font font-bold uppercase transition-all shadow flex items-center">
            <i class="fa-solid fa-lock mr-1.5 text-amber-400"></i>
            <span>Ãrea Admin</span>
          </button>
          <button onclick="acionarInstalacaoApp()" 
                  title="Instalar Aplicativo no Celular ou Computador"
                  class="btn-instalar-app px-3.5 py-1.5 bg-gradient-to-r from-emerald-600 via-emerald-500 to-green-600 hover:from-emerald-500 hover:to-green-500 text-slate-950 font-extrabold rounded-lg text-xs military-font uppercase flex items-center shadow transition-all transform active:scale-95">
            <i class="fa-solid fa-mobile-screen-button mr-1 text-xs"></i>
            <span>Instalar App</span>
          </button>
        </div>
      </div>

      <div class="flex justify-center mb-4 drop-shadow-[0_4px_24px_rgba(212,175,55,0.4)]">
        <img src="logo_veteranos.png" alt="Veteranos 5º BE Cmb Bld" class="h-36 sm:h-48 w-auto object-contain filter drop-shadow hover:scale-105 transition-transform duration-300">
      </div>
      <div class="inline-block px-3 py-1 bg-amber-950/40 border border-amber-600/40 rounded-full text-xs font-semibold text-amber-400 military-font tracking-widest uppercase mb-2">
        <i class="fa-solid fa-id-card mr-1"></i> Inscrição Oficial & Mural da Companhia
      </div>
      <h1 class="military-font leading-tight">
        <span class="text-3xl sm:text-5xl font-black gold-gradient uppercase tracking-wider block">
          VETERANOS
        </span>
        <span class="text-sm sm:text-lg text-emerald-400 font-extrabold uppercase tracking-wide military-font block mt-1">
          DO 5º BATALHÃO DE ENGENHARIA DE COMBATE BLINDADO
        </span>
      </h1>
      <p class="text-xs sm:text-sm text-amber-300 font-bold uppercase tracking-wider military-font mt-1">
        Batalhão Juarez Távora • Porto União - SC
      </p>
    </div>

        <!-- BANNER DE DIRECIONAMENTO DE LINKS OFICIAIS -->
    <div id="bannerPortaisDedicados" class="p-4 bg-gradient-to-r from-[#122315] via-[#1a331f] to-[#122315] rounded-xl border border-amber-500/50 shadow-lg text-center space-y-2.5">
      <div class="inline-flex items-center space-x-1.5 text-amber-400 font-bold military-font uppercase text-xs tracking-wider">
        <i class="fa-solid fa-compass"></i>
        <span>Portais Específicos dos Veteranos do 5º BE</span>
      </div>
      <p class="text-xs text-slate-300">
        Para maior organização, utilize os novos portais dedicados da Comissão:
      </p>
      <!-- Banner de Controle do Administrador no Link de Cadastro -->
      <div id="adminBannerControleAlmocoCadastro" class="hidden mb-3 p-3 bg-[#0a150c] rounded-xl border border-amber-500/50 flex flex-col sm:flex-row items-center justify-between gap-2.5 shadow">
        <div class="flex items-center space-x-2.5">
          <i class="fa-solid fa-shield-halved text-amber-400 text-sm"></i>
          <div>
            <span class="text-[10px] text-slate-400 font-bold uppercase military-font block">Painel do Administrador</span>
            <span id="txtStatusAlmocoCadastro" class="text-xs font-bold military-font uppercase text-amber-300">
              Reservas de Almoço: Bloqueadas (Oculto na Página Inicial)
            </span>
          </div>
        </div>
        <button id="btnToggleAlmocoCadastro" onclick="alternarLiberacaoReservasAlmoco()"
                class="px-3 py-1.5 rounded-lg text-[11px] font-extrabold military-font uppercase transition-all shadow bg-emerald-700 hover:bg-emerald-600 text-white">
          <i class="fa-solid fa-unlock mr-1"></i> Liberar Reservas
        </button>
      </div>

      <div class="grid grid-cols-1 gap-2.5 pt-1" id="gridPortaisCadastro">
        <a href="reencontro.html" class="p-3 bg-[#0a140c] hover:bg-[#142617] border border-amber-500/60 rounded-lg text-left transition-all group">
          <div class="text-xs font-bold text-amber-300 military-font uppercase flex items-center justify-between">
            <span><i class="fa-solid fa-users mr-1.5 text-amber-400"></i> Portal do Reencontro</span>
            <i class="fa-solid fa-arrow-right text-[10px] text-amber-400 group-hover:translate-x-1 transition-transform"></i>
          </div>
          <p class="text-[11px] text-slate-400 mt-0.5">Veja soldados por Companhia, encontre sua turma e cadastro geral.</p>
        </a>
        <a href="eventos.html" id="cardLinkAlmocoCadastro" class="p-3 bg-[#0a140c] hover:bg-[#142617] border border-emerald-500/60 rounded-lg text-left transition-all group hidden">
          <div class="text-xs font-bold text-emerald-300 military-font uppercase flex items-center justify-between">
            <span><i class="fa-solid fa-utensils mr-1.5 text-emerald-400"></i> Almoço dos Veteranos (Feijoada)</span>
            <i class="fa-solid fa-arrow-right text-[10px] text-emerald-400 group-hover:translate-x-1 transition-transform"></i>
          </div>
          <p class="text-[11px] text-slate-400 mt-0.5">Reservar feijoada individual e familiar com pagamento antecipado via Chave PIX.</p>
        </a>
      </div>
    </div>

    <!-- Card do Formulário -->
    <div class="bg-[#121c13] rounded-xl p-6 sm:p-8 tactical-border relative overflow-hidden">
      <!-- Tarja decorativa superior -->
      <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-emerald-600 via-amber-400 to-emerald-600"></div>

      <div class="mb-6 pb-4 border-b border-[#243c27] flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
          <h2 class="text-xl font-bold military-font text-slate-100 flex items-center">
            <i class="fa-solid fa-user-plus text-amber-400 mr-2"></i>
            Inscrição & Atualização de Veterano
          </h2>
          <p class="text-xs text-slate-400 mt-1">
            Preencha seus dados abaixo. <strong class="text-amber-300">A partir do momento em que concluir o cadastro, a lista da sua Companhia será liberada</strong> com o nome e ano que serviram!
          </p>
          <p class="text-[11px] text-slate-500 mt-0.5">
            <i class="fa-solid fa-lock text-amber-500 mr-1"></i> Os telefones dos soldados são restritos e só o Administrador pode liberar.
          </p>
        </div>
      </div>

      <!-- PAINEL DE STATUS: VETERANO JÁ IDENTIFICADO / CADASTRADO -->
      <div id="painelVeteranoCadastradoLocal" class="hidden mb-6 p-4 sm:p-5 bg-gradient-to-r from-[#132717] via-[#1a3821] to-[#132717] rounded-xl border-2 border-emerald-500 shadow-xl">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div class="flex items-center space-x-3.5">
            <div class="w-12 h-12 rounded-full bg-emerald-500/20 border-2 border-emerald-400 text-emerald-300 flex items-center justify-center text-xl shrink-0 shadow-md">
              <i class="fa-solid fa-id-card-clip"></i>
            </div>
            <div>
              <div class="flex flex-wrap items-center gap-2">
                <span class="px-2 py-0.5 bg-amber-500 text-slate-950 font-black rounded text-[10px] uppercase military-font tracking-wider">CADASTRO ATIVO</span>
                <span class="px-2 py-0.5 bg-emerald-950 text-emerald-300 border border-emerald-600/50 rounded text-[10px] font-bold font-mono flex items-center">
                  <i class="fa-solid fa-lock-open text-amber-400 mr-1"></i> LISTA SEMPRE LIBERADA NESTE DISPOSITIVO
                </span>
              </div>
              <h3 id="txtBoasVindasVeteranoLocal" class="text-base sm:text-lg font-black text-white military-font mt-1">
                Olá, Veterano!
              </h3>
              <p id="txtSubBoasVindasLocal" class="text-xs text-slate-300 font-medium">
                Companhia: <strong class="text-amber-300" id="txtCiaVeteranoCadastradoLocal">--</strong> • Turma: <strong class="text-amber-300" id="txtAnoVeteranoCadastradoLocal">--</strong>
              </p>
            </div>
          </div>
          <div class="flex flex-wrap items-center gap-2">
            <button type="button" onclick="rolarParaListaCompanhiaLocal()" 
                    class="px-3.5 py-2 bg-gradient-to-r from-emerald-600 to-green-600 hover:from-emerald-500 hover:to-green-500 text-slate-950 font-black rounded-lg text-xs military-font uppercase flex items-center shadow-md">
              <i class="fa-solid fa-users mr-1.5"></i> Ver Caserna / Soldados
            </button>
            <button type="button" onclick="alternarFormularioAtualizacaoLocal()" 
                    class="px-3 py-2 bg-[#0c160e] hover:bg-[#152718] text-amber-300 border border-amber-500/40 font-bold rounded-lg text-xs military-font uppercase flex items-center transition-all">
              <i class="fa-solid fa-pen-to-square mr-1.5 text-amber-400"></i> <span id="txtBtnToggleFormLocal">Atualizar Meus Dados</span>
            </button>
          </div>
        </div>
        <div class="mt-3 pt-2.5 border-t border-emerald-900/60 flex flex-col sm:flex-row sm:items-center justify-between gap-1 text-[11px] text-slate-400">
          <span><i class="fa-solid fa-circle-check text-emerald-400 mr-1"></i> A lista da sua Companhia permanece desbloqueada permanentemente neste dispositivo.</span>
          <button type="button" onclick="desvincularCadastroDispositivoLocal()" class="text-slate-400 hover:text-red-400 underline text-left sm:text-right transition-colors" title="Limpar cadastro salvo apenas deste navegador">
            Trocar de Militar
          </button>
        </div>
      </div>

      <form id="formCadastro" onsubmit="salvarCadastro(event)" class="space-y-4">
        
        <!-- Alerta de Identificação Automática ao Digitar Nome -->
        <div id="avisoAutoPreenchimentoCad" class="hidden p-3 bg-emerald-950/80 border border-emerald-500/60 rounded-lg text-emerald-200 text-xs flex flex-col sm:flex-row sm:items-center justify-between gap-2 shadow">
          <div class="flex items-center space-x-2">
            <i class="fa-solid fa-circle-check text-amber-400 text-base shrink-0"></i>
            <span id="txtAvisoAutoPreenchimentoCad">
              <strong>Cadastro localizado no efetivo!</strong> Informações preenchidas automaticamente.
            </span>
          </div>
          <span class="text-[10px] font-mono px-2 py-0.5 bg-amber-500/20 text-amber-300 border border-amber-500/40 rounded font-bold uppercase shrink-0">DADOS CARREGADOS</span>
        </div>

        <!-- Nome Completo & Nome de Guerra -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="sm:col-span-2">
            <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">
              Nome Completo <span class="text-red-400">*</span>
            </label>
            <input type="text" id="nomeCompleto" required placeholder="Ex: João da Silva Silveira"
                   oninput="autoPreencherCadastro(this)"
                   class="w-full px-3 py-2.5 rounded-lg tactical-input text-sm">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">
              Nome de Guerra <span class="text-red-400">*</span>
            </label>
            <input type="text" id="nomeGuerra" required placeholder="Ex: SILVA"
                   oninput="autoPreencherCadastro(this)"
                   class="w-full px-3 py-2.5 rounded-lg tactical-input text-sm uppercase">
          </div>
        </div>

        <!-- Posto/Graduação, Companhia & Ano que Serviu -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">
              Graduação / Posto <span class="text-red-400">*</span>
            </label>
            <select id="graduacao" required class="w-full px-3 py-2.5 rounded-lg tactical-input text-sm">
              <option value="Sd" selected>Soldado (Sd)</option>
              <option value="Cb">Cabo (Cb)</option>
              <option value="3º Sgt">3º Sargento (3º Sgt)</option>
              <option value="2º Sgt">2º Sargento (2º Sgt)</option>
              <option value="1º Sgt">1º Sargento (1º Sgt)</option>
              <option value="Sgt">Sargento (Sgt)</option>
              <option value="Sub Ten">Subtenente (Sub Ten)</option>
              <option value="Asp">Aspirante (Asp)</option>
              <option value="Ten">Tenente (Ten)</option>
              <option value="Cap">Capitão (Cap)</option>
              <option value="Maj">Major (Maj)</option>
              <option value="Ten Cel">Tenente-Coronel (Ten Cel)</option>
              <option value="Cel">Coronel (Cel)</option>
              <option value="Gen">General (Gen)</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">
              Companhia em que Serviu <span class="text-red-400">*</span>
            </label>
            <select id="companhia" required class="w-full px-3 py-2.5 rounded-lg tactical-input text-sm font-bold text-amber-300">
              <option value="1º Cia Eng Cmb Bld">1ª Cia Eng Cmb Bld — 🦁 Leão</option>
              <option value="2º Cia Eng Cmb Bld">2ª Cia Eng Cmb Bld — 🐆 Onça</option>
              <option value="Cia Cmdo e Ap - (CCAp)">Cia Cmdo e Apoio (CCAp) — 🐾 Pantera</option>
              <option value="Cia Eng Pnt (CEP)">Cia Eng Pontes (CEP) — 🦅 Águia</option>
              <option value="Estado Maior Geral e Especial">Estado-Maior Geral e Especial</option>
              <option value="NPOR">NPOR</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">
              Ano que Serviu (Incorporação) <span class="text-red-400">*</span>
            </label>
            <input type="number" id="anoIncorporacao" min="1940" max="2030" placeholder="Ex: 1985" required
                   class="w-full px-3 py-2.5 rounded-lg tactical-input text-sm font-mono">
          </div>
        </div>

        <!-- WhatsApp, E-mail & CPF -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">
              WhatsApp / Celular <span class="text-red-400">*</span>
            </label>
            <input type="tel" id="whatsapp" required placeholder="(42) 99999-9999" oninput="mascaraTelefone(this)"
                   class="w-full px-3 py-2.5 rounded-lg tactical-input text-sm font-mono text-emerald-400">
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">
              E-mail (Opcional)
            </label>
            <input type="email" id="email" placeholder="seu@email.com"
                   class="w-full px-3 py-2.5 rounded-lg tactical-input text-sm">
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">
              CPF (Opcional)
            </label>
            <input type="text" id="cpf" placeholder="000.000.000-00" oninput="mascaraCPF(this)"
                   class="w-full px-3 py-2.5 rounded-lg tactical-input text-sm font-mono">
          </div>
        </div>

        <!-- Endereço: Cidade, UF, Bairro e Rua -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">
              Cidade <span class="text-red-400">*</span>
            </label>
            <input type="text" id="cidade" required placeholder="Ex: Porto União"
                   class="w-full px-3 py-2.5 rounded-lg tactical-input text-sm">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">
              Estado (UF) <span class="text-red-400">*</span>
            </label>
            <select id="estado" required class="w-full px-3 py-2.5 rounded-lg tactical-input text-sm">
              <option value="Santa Catarina" selected>Santa Catarina (SC)</option>
              <option value="Paraná">Paraná (PR)</option>
              <option value="Rio Grande do Sul">Rio Grande do Sul (RS)</option>
              <option value="São Paulo">São Paulo (SP)</option>
              <option value="Distrito Federal">Distrito Federal (DF)</option>
              <option value="Rio de Janeiro">Rio de Janeiro (RJ)</option>
              <option value="Minas Gerais">Minas Gerais (MG)</option>
              <option value="Mato Grosso do Sul">Mato Grosso do Sul (MS)</option>
              <option value="Mato Grosso">Mato Grosso (MT)</option>
              <option value="Outro">Outro Estado</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">
              Bairro (Opcional)
            </label>
            <input type="text" id="bairro" placeholder="Ex: Centro"
                   class="w-full px-3 py-2.5 rounded-lg tactical-input text-sm">
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">
            Rua e Número (Logradouro - Opcional)
          </label>
          <input type="text" id="logradouro" placeholder="Ex: Rua 7 de Setembro, 123"
                 class="w-full px-3 py-2.5 rounded-lg tactical-input text-sm">
        </div>

        <!-- Botão de Envio -->
        <div class="pt-2">
          <button type="submit" 
                  class="w-full py-4 px-4 bg-gradient-to-r from-emerald-600 via-emerald-500 to-green-600 hover:from-emerald-500 hover:to-green-500 text-slate-900 font-extrabold rounded-lg military-font tracking-wider text-base uppercase shadow-lg shadow-emerald-950/50 flex items-center justify-center transition-all transform active:scale-95">
            <i class="fa-solid fa-unlock-keyhole mr-2 text-lg"></i> Concluir Inscrição e Liberar Lista da Companhia
          </button>
        </div>

      </form>

      <!-- Mensagem de Sucesso -->
      <div id="sucessoBox" class="hidden mt-6 p-6 bg-emerald-950/80 border border-emerald-500 rounded-lg text-center space-y-4">
        <div class="w-14 h-14 bg-emerald-500/20 text-emerald-400 rounded-full flex items-center justify-center mx-auto text-3xl">
          <i class="fa-solid fa-circle-check"></i>
        </div>
        <h3 id="tituloSucessoCad" class="text-2xl font-bold text-emerald-300 military-font uppercase">Inscrição Confirmada com Sucesso!</h3>
        <p id="descSucessoCad" class="text-xs sm:text-sm text-slate-300 max-w-md mx-auto">
          : `Seus dados foram integrados ao efetivo geral da Comissão dos Veteranos do 5º BE. A lista dos soldados da sua Companhia foi liberada logo abaixo!`;
        </p>

        <div class="flex flex-col sm:flex-row gap-3 justify-center pt-2">
          <a id="btnEnviarWhatsApp" href="#" target="_blank"
             class="px-5 py-3 bg-green-500 hover:bg-green-400 text-slate-950 font-bold rounded-lg text-sm military-font uppercase flex items-center justify-center shadow-md">
            <i class="fa-brands fa-whatsapp text-lg mr-2"></i> Enviar Confirmação para Rodolfo (42 99903-3839)
          </a>
        </div>
      </div>

    </div>

    <!-- SEÇÃO DA LISTA DA COMPANHIA: BLOQUEADA ATÉ A INSCRIÇÃO OU LIBERADA -->
    <div id="areaMuralCadastro">
      
      <!-- ESTADO 1: BLOQUEADO (Antes da inscrição) -->
      <div id="cardCadBloqueado" class="bg-[#121c13] rounded-xl p-8 tactical-border text-center border-2 border-dashed border-[#243c27] space-y-3">
        <div class="w-14 h-14 bg-amber-500/10 text-amber-400 border border-amber-500/30 rounded-full flex items-center justify-center mx-auto text-2xl">
          <i class="fa-solid fa-lock"></i>
        </div>
        <h3 class="text-xl font-bold military-font text-white uppercase">
          Lista de Soldados da Companhia Protegida
        </h3>
        <p class="text-xs text-slate-400 max-w-md mx-auto">
          A relação de soldados com nome e ano em que serviram <strong class="text-amber-300">é liberada imediatamente a partir do momento em que você faz a inscrição acima</strong>.
        </p>
        <span class="text-[11px] text-slate-500 font-mono block">
          <i class="fa-solid fa-shield-halved text-emerald-400 mr-1"></i> Os telefones dos soldados são restritos e só o Administrador pode liberar.
        </span>

        <!-- Atalho RÃ¡pido para quem jÃ¡ se cadastrou antes -->
        <div class="mt-6 pt-5 border-t border-[#1e3422] max-w-md mx-auto text-left bg-[#08100a] p-4 rounded-xl border border-[#1e3823]">
          <div class="flex items-center space-x-2 text-xs font-bold text-amber-300 uppercase military-font mb-1.5">
            <i class="fa-solid fa-key text-amber-400"></i>
            <span>JÃ¡ se cadastrou antes? Libere sua Companhia aqui:</span>
          </div>
          <p class="text-[11px] text-slate-400 mb-2.5 leading-relaxed">
            Se vocÃª jÃ¡ realizou seu cadastro anteriormente, digite seu <strong class="text-slate-200">Nome</strong> ou <strong class="text-slate-200">Nome de Guerra</strong> para liberar a lista da sua Companhia imediatamente:
          </p>
          <div class="flex gap-2">
            <input type="text" id="inputBuscarCadastroExistenteLocal" placeholder="Ex: SILVA ou seu Nome..."
                   class="flex-1 px-3 py-2 rounded-lg bg-[#050b06] border border-[#264429] text-xs text-amber-300 font-bold focus:outline-none focus:border-amber-400"
                   onkeydown="if(event.key === 'Enter') recuperarCadastroVeteranoLocal()">
            <button type="button" onclick="recuperarCadastroVeteranoLocal()"
                    class="px-4 py-2 bg-gradient-to-r from-amber-500 to-yellow-500 hover:from-amber-400 hover:to-yellow-400 text-slate-950 font-black rounded-lg text-xs military-font uppercase flex items-center shadow-md">
              <i class="fa-solid fa-unlock mr-1.5"></i> Liberar
            </button>
          </div>
          <div id="msgRecuperarStatusLocal" class="mt-2 text-[11px] hidden"></div>
        </div>
      </div>

      <!-- ESTADO 2: LIBERADO (Apenas após inscrição ou para Admin) -->
      <div id="cardCadLiberado" class="hidden bg-[#121c13] rounded-xl p-5 sm:p-6 tactical-border space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-3 border-b border-[#243c27]">
          <div>
            <span class="text-xs font-bold text-amber-400 military-font uppercase tracking-wider block">
              <i class="fa-solid fa-lock-open mr-1 text-emerald-400"></i> Soldados da Sua Companhia (Liberado)
            </span>
            <h3 class="text-lg sm:text-xl font-bold military-font text-white" id="tituloCiaMural">
              1ª Cia Eng Cmb Bld
            </h3>
          </div>
          <div class="text-xs font-mono text-emerald-400 bg-[#09110a] px-3 py-1 rounded border border-[#1e3823] self-start sm:self-auto">
            <span id="qtdSoldadosCia">--</span> soldados listados
          </div>
        </div>

        <!-- Barra de Abas das Companhias com os Desenhos dos Animais Mascotes -->
        <div class="p-3 bg-[#0a120c] rounded-xl border border-[#1e3422] space-y-2">
          <div class="flex items-center justify-between text-[11px] text-slate-400 font-semibold uppercase military-font">
            <span class="flex items-center"><i class="fa-solid fa-paw text-amber-400 mr-1.5"></i> Ver Integrantes por Companhia:</span>
            <span class="text-amber-400 font-bold">Mascotes das Companhias</span>
          </div>
          <div class="flex flex-wrap gap-2" id="botoesCiasCadastro">
            <!-- Gerado via JavaScript com os 4 animais -->
          </div>
        </div>

        <!-- Bloco Tático: Puxar Integrantes pelo Ano em que Serviu -->
        <div class="p-3.5 bg-gradient-to-r from-[#122315] via-[#0b140d] to-[#122315] rounded-xl border border-emerald-600/70 shadow space-y-2.5">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1.5">
            <div class="flex items-center space-x-2">
              <i class="fa-solid fa-calendar-check text-amber-400 text-sm"></i>
              <h4 class="text-xs font-bold text-slate-100 military-font uppercase">
                Puxar Integrantes do Ano que Serviu (Turma de Caserna)
              </h4>
            </div>
            <button type="button" onclick="limparFiltroAnoCadastro()"
                    class="px-2.5 py-1 bg-[#182c1c] hover:bg-[#233f28] text-slate-200 border border-[#2d5632] rounded text-[11px] military-font font-bold uppercase transition-all flex items-center self-start sm:self-auto">
              <i class="fa-solid fa-users mr-1 text-amber-400"></i> Ver Todos os Anos
            </button>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-12 gap-2">
            <div class="sm:col-span-5 flex gap-1.5">
              <div class="relative flex-1">
                <i class="fa-solid fa-calendar-days absolute left-2.5 top-2 text-amber-400 text-xs"></i>
                <input type="number" id="anoSoldadosLocal" oninput="filtrarSoldadosLocal()"
                       placeholder="Ex: 1984" min="1940" max="2030"
                       class="w-full pl-8 pr-2 py-1.5 rounded bg-[#070e08] border border-emerald-500/80 text-amber-300 text-xs font-mono font-bold focus:outline-none focus:border-amber-400">
              </div>
              <button type="button" onclick="filtrarSoldadosLocal()"
                      class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-slate-950 font-bold rounded text-[11px] military-font uppercase">
                Puxar
              </button>
            </div>
            <div class="sm:col-span-7 relative">
              <i class="fa-solid fa-magnifying-glass absolute left-2.5 top-2 text-slate-500 text-xs"></i>
              <input type="text" id="buscaSoldadosLocal" oninput="filtrarSoldadosLocal()"
                     placeholder="Ou busque por nome..."
                     class="w-full pl-8 pr-2 py-1.5 rounded bg-[#070e08] border border-[#264429] text-xs text-slate-200 focus:outline-none focus:border-amber-400">
            </div>
          </div>

          <!-- Status do Ano Puxado -->
          <div id="statusAnoCadastro" class="text-[11px] text-slate-400 flex items-center justify-between px-2 py-1 bg-[#060c07] rounded border border-[#1b3420]">
            <span id="txtStatusAnoCad"><i class="fa-solid fa-circle-info text-amber-400 mr-1"></i> Digite o ano que serviu para puxar sua turma.</span>
            <span id="qtdStatusAnoCad" class="font-mono text-emerald-400 font-bold">--</span>
          </div>
        </div>

        <!-- Lista Rolável dos Integrantes -->
        <div id="listaSoldadosCia" class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 max-h-80 overflow-y-auto custom-scroll pr-1">
          <!-- Gerado via JavaScript -->
        </div>
      </div>

    </div>

    <!-- MODAL: LOGIN DO ADMINISTRADOR -->
    <div id="modalAdminCadastro" class="fixed inset-0 z-50 bg-black/85 backdrop-blur-md flex items-center justify-center p-4 hidden">
      <div class="bg-[#111e13] max-w-sm w-full rounded-2xl overflow-hidden border border-[#d4af37] shadow-[0_0_30px_rgba(212,175,55,0.3)] relative">
        <div class="bg-[#172b1a] p-4 border-b border-[#254228] flex items-center justify-between">
          <div class="flex items-center space-x-2.5">
            <div class="w-8 h-8 rounded-full bg-amber-950 border border-amber-500 flex items-center justify-center text-amber-400 text-sm font-bold">
              <i class="fa-solid fa-key"></i>
            </div>
            <h3 class="text-sm font-bold text-white military-font uppercase">Acesso Administrativo</h3>
          </div>
          <button onclick="fecharModalAdmin()" class="text-slate-400 hover:text-white p-1">
            <i class="fa-solid fa-xmark"></i>
          </button>
        </div>
        <form onsubmit="autenticarAdminCadastro(event)" class="p-5 space-y-4 text-xs">
          <p class="text-slate-300 text-[11px]">
            Digite a senha de administrador para liberar todos os dados.
          </p>
          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">Senha:</label>
            <input type="password" id="inputSenhaCadastro" required placeholder="Digite a senha..."
                   class="w-full px-3 py-2 bg-[#09100a] border border-[#2b4c2f] rounded-lg text-slate-100 font-mono tracking-widest text-center text-sm focus:outline-none focus:border-amber-400">
            <div id="erroSenhaCadastro" class="hidden text-red-400 font-bold text-[11px] mt-1.5 text-center">
              Senha incorreta!
            </div>
          </div>
          <button type="submit" class="w-full py-2.5 px-4 bg-amber-600 hover:bg-amber-500 text-slate-950 font-extrabold rounded-lg text-xs military-font uppercase">
            Autenticar
          </button>
        </form>
      </div>
    </div>

    <!-- Rodapé com Redes Sociais e Acesso Admin -->
    <footer class="text-center text-xs text-slate-500 py-6 border-t border-[#192b1b] space-y-4 mt-8">
      <div class="flex flex-wrap items-center justify-center gap-3">
        <!-- Instagram Oficial -->
        <a href="https://www.instagram.com/veteranos5be" target="_blank" rel="noopener noreferrer"
           title="Siga o Instagram Oficial: @veteranos5be"
           class="inline-flex items-center space-x-2 px-3.5 py-2 bg-gradient-to-r from-pink-950/70 via-purple-950/70 to-pink-950/70 hover:from-pink-900 hover:to-purple-900 border border-pink-500/50 hover:border-pink-400 text-pink-300 hover:text-white rounded-lg text-xs font-bold military-font uppercase transition-all shadow">
          <i class="fa-brands fa-instagram text-base text-pink-400"></i>
          <span>Instagram @veteranos5be</span>
        </a>

        <!-- Facebook Oficial -->
        <a href="https://www.facebook.com/veteranos5be" target="_blank" rel="noopener noreferrer"
           title="Siga o Facebook Oficial: @veteranos5be"
           class="inline-flex items-center space-x-2 px-3.5 py-2 bg-blue-950/70 hover:bg-blue-900 border border-blue-500/50 hover:border-blue-400 text-blue-300 hover:text-white rounded-lg text-xs font-bold military-font uppercase transition-all shadow">
          <i class="fa-brands fa-facebook text-base text-blue-400"></i>
          <span>Facebook @veteranos5be</span>
        </a>

        <!-- Área Admin com Senha -->
        <button id="btnAdminCadastro" onclick="abrirModalAdmin()" 
                title="Acesso Restrito do Administrador com Senha"
                class="inline-flex items-center space-x-2 px-3.5 py-2 bg-amber-600/20 hover:bg-amber-600/40 text-amber-300 border border-amber-500/50 hover:border-amber-400 rounded-lg text-xs military-font font-bold uppercase transition-all shadow">
          <i class="fa-solid fa-lock text-amber-400"></i>
          <span>Área Admin</span>
        </button>

        <!-- Badge Admin Autenticado -->
        <div id="badgeAdminCadastro" class="hidden flex items-center space-x-2">
          <span class="px-3 py-1.5 bg-emerald-950 text-emerald-300 border border-emerald-500 rounded-lg text-xs font-bold military-font uppercase flex items-center">
            <i class="fa-solid fa-shield-halved text-emerald-400 mr-1.5"></i> Admin Ativo
          </span>
          <button onclick="fazerLogoutAdmin()" class="px-2.5 py-1.5 bg-red-950 hover:bg-red-900 text-red-300 border border-red-700/50 rounded-lg text-xs font-bold military-font uppercase">
            Sair
          </button>
        </div>
      </div>

      <div class="pt-2 text-[11px] text-slate-500">
        <p class="font-bold text-slate-400">Veteranos do 5º Batalhão de Engenharia de Combate Blindado — Batalhão Juarez Távora</p>
        <p class="mt-0.5">Tradição, fraternidade e história • Brasil Acima de Tudo!</p>
      </div>
    </footer>

  </div>

  <script>
    const SENHA_ADMIN_OFICIAL = "104832";
    let efetivoTotal = [];
    let ciaAtivaMural = "1º Cia Eng Cmb Bld";

    let syncChannel = null;
    try {
      syncChannel = new BroadcastChannel('veteranos_5be_sync');
      syncChannel.onmessage = () => carregarEfetivoGeral();
      aplicarEstadoPermanenteVeteranoLocal();
    } catch(e) {}

    function verificarAdminLogado() {
      return sessionStorage.getItem('admin_5be_logado') === 'true';
    }

    function abrirModalAdmin() {
      document.getElementById('erroSenhaCadastro').classList.add('hidden');
      document.getElementById('inputSenhaCadastro').value = '';
      document.getElementById('modalAdminCadastro').classList.remove('hidden');
      setTimeout(() => document.getElementById('inputSenhaCadastro').focus(), 100);
    }

    function fecharModalAdmin() {
      document.getElementById('modalAdminCadastro').classList.add('hidden');
    }

    function autenticarAdminCadastro(event) {
      event.preventDefault();
      const senha = document.getElementById('inputSenhaCadastro').value.trim();
      if (senha === SENHA_ADMIN_OFICIAL) {
        sessionStorage.setItem('admin_5be_logado', 'true');
        fecharModalAdmin();
        atualizarHeaderAdmin();
        renderizarSoldadosCia();
      } else {
        document.getElementById('erroSenhaCadastro').classList.remove('hidden');
      }
    }

    function fazerLogoutAdmin() {
      sessionStorage.removeItem('admin_5be_logado');
      atualizarHeaderAdmin();
      atualizarVisibilidadeReservasAlmocoCadastro();
      renderizarSoldadosCia();
    }

    function atualizarHeaderAdmin() {
      const isAdmin = verificarAdminLogado();
      const btnAdmin = document.getElementById('btnAdminCadastro');
      const badgeAdmin = document.getElementById('badgeAdminCadastro');
      if (isAdmin) {
        btnAdmin.classList.add('hidden');
        badgeAdmin.classList.remove('hidden');
      } else {
        btnAdmin.classList.remove('hidden');
        badgeAdmin.classList.add('hidden');
      }
    }

    function aplicarEstadoPermanenteVeteranoLocal() {
      const cia = localStorage.getItem('veterano_inscrito_cia') || sessionStorage.getItem('veterano_inscrito_cia');
      const nome = localStorage.getItem('veterano_inscrito_nome') || sessionStorage.getItem('veterano_inscrito_nome') || '';
      const guerra = localStorage.getItem('veterano_inscrito_guerra') || (nome ? nome.split(' ')[0].toUpperCase() : '');
      const grad = localStorage.getItem('veterano_inscrito_grad') || 'Sd';
      const ano = localStorage.getItem('veterano_inscrito_ano') || sessionStorage.getItem('veterano_inscrito_ano') || '';
      const tel = localStorage.getItem('veterano_inscrito_tel') || '';
      const cidade = localStorage.getItem('veterano_inscrito_cidade') || '';
      const uf = localStorage.getItem('veterano_inscrito_uf') || 'Santa Catarina';
      const bairro = localStorage.getItem('veterano_inscrito_bairro') || '';
      const rua = localStorage.getItem('veterano_inscrito_rua') || '';

      const painel = document.getElementById('painelVeteranoCadastradoLocal');
      const form = document.getElementById('formCadastro');
      const txtBoasVindas = document.getElementById('txtBoasVindasVeteranoLocal');
      const txtCia = document.getElementById('txtCiaVeteranoCadastradoLocal');
      const txtAno = document.getElementById('txtAnoVeteranoCadastradoLocal');
      const txtBtnToggle = document.getElementById('txtBtnToggleFormLocal');

      if (cia && nome) {
        if (painel) painel.classList.remove('hidden');
      if (txtBoasVindas) txtBoasVindas.innerText = `Olá, ${grad} ${guerra} (${nome})!`;
        if (txtCia) txtCia.innerText = cia;
        if (txtAno) txtAno.innerText = ano ? `Ano ${ano}` : 'NÃ£o informado';

        const elNome = document.getElementById('nomeCompleto');
        if (elNome && !elNome.value) elNome.value = nome;
        const elGuerra = document.getElementById('nomeGuerra');
        if (elGuerra && !elGuerra.value) elGuerra.value = guerra;
        const elGrad = document.getElementById('graduacao');
        if (elGrad && grad) elGrad.value = grad;
        const elCia = document.getElementById('companhia');
        if (elCia && cia) elCia.value = cia;
        const elAno = document.getElementById('ano');
        if (elAno && ano) elAno.value = ano;
        const elTel = document.getElementById('whatsapp');
        if (elTel && tel) elTel.value = tel;
        const elCidade = document.getElementById('cidade');
        if (elCidade && cidade) elCidade.value = cidade;
        const elUf = document.getElementById('estado');
        if (elUf && uf) elUf.value = uf;
        const elBairro = document.getElementById('bairro');
        if (elBairro && bairro) elBairro.value = bairro;
        const elRua = document.getElementById('rua');
        if (elRua && rua) elRua.value = rua;

        if (form) form.classList.add('hidden');
        if (txtBtnToggle) txtBtnToggle.innerText = 'Atualizar Meus Dados';

        if (!ciaAtivaMural || ciaAtivaMural === "1º Cia Eng Cmb Bld") {
          ciaAtivaMural = cia;
        }

        const inputAno = document.getElementById('anoSoldadosLocal');
        if (inputAno && ano && !inputAno.dataset.iniciado) {
          inputAno.value = ano;
          inputAno.dataset.iniciado = "true";
        }
      } else {
        if (painel) painel.classList.add('hidden');
        if (form) form.classList.remove('hidden');
      }
    }

    function rolarParaListaCompanhiaLocal() {
      const el = document.getElementById('areaMuralCadastro');
      if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function alternarFormularioAtualizacaoLocal() {
      const form = document.getElementById('formCadastro');
      const txt = document.getElementById('txtBtnToggleFormLocal');
      if (!form) return;
      const isHidden = form.classList.contains('hidden');
      if (isHidden) {
        form.classList.remove('hidden');
        if (txt) txt.innerText = 'Ocultar Formulário';
        form.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } else {
        form.classList.add('hidden');
        if (txt) txt.innerText = 'Atualizar Meus Dados';
      }
    }

    function desvincularCadastroDispositivoLocal() {
      if (!confirm('Deseja desvincular seu cadastro deste aparelho?\n\nVocê poderá vincular novamente a qualquer momento digitando seu nome ou preenchendo o formulário.')) {
        return;
      }
      localStorage.removeItem('veterano_inscrito_cia');
      localStorage.removeItem('veterano_inscrito_nome');
      localStorage.removeItem('veterano_inscrito_guerra');
      localStorage.removeItem('veterano_inscrito_grad');
      localStorage.removeItem('veterano_inscrito_ano');
      localStorage.removeItem('veterano_inscrito_tel');
      localStorage.removeItem('veterano_inscrito_cidade');
      localStorage.removeItem('veterano_inscrito_uf');
      localStorage.removeItem('veterano_inscrito_rua');
      localStorage.removeItem('veterano_inscrito_bairro');
      sessionStorage.removeItem('veterano_inscrito_cia');
      sessionStorage.removeItem('veterano_inscrito_nome');
      sessionStorage.removeItem('veterano_inscrito_ano');

      aplicarEstadoPermanenteVeteranoLocal();
      renderizarSoldadosCia();
      alert('Seu cadastro foi desvinculado deste dispositivo.');
    }

    function recuperarCadastroVeteranoLocal() {
      const input = document.getElementById('inputBuscarCadastroExistenteLocal');
      const busca = (input?.value || '').trim();
      const msgBox = document.getElementById('msgRecuperarStatusLocal');
      if (!busca) {
        if (msgBox) {
          msgBox.className = 'mt-2 text-[11px] text-amber-400 font-bold';
          msgBox.innerHTML = '<i class="fa-solid fa-triangle-exclamation mr-1"></i> Digite seu Nome de Guerra ou Nome Completo.';
          msgBox.classList.remove('hidden');
        }
        return;
      }

      const limparTexto = (txt) => {
        if (!txt) return '';
        return txt.toString().toLowerCase()
          .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
          .replace(/[^a-z0-9]/g, '');
      };

      const termo = limparTexto(busca);
      const palavras = busca.toLowerCase()
        .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
        .split(/\s+/)
        .filter(p => p.length >= 2);
      const digitosBusca = busca.replace(/\D/g, '');

      const encontrados = efetivoTotal.filter(i => {
        const nLimpo = limparTexto(i.nome);
        const gLimpo = limparTexto(i.guerra);
        const telLimpo = (i.tel || '').replace(/\D/g, '');
        const cpfLimpo = (i.cpf || '').replace(/\D/g, '');

        if (nLimpo.includes(termo) || gLimpo.includes(termo)) return true;
        if (digitosBusca.length >= 4 && (telLimpo.includes(digitosBusca) || cpfLimpo.includes(digitosBusca))) return true;
        if (palavras.length > 0 && palavras.every(p => nLimpo.includes(p) || gLimpo.includes(p))) return true;

        return false;
      });

      if (encontrados.length === 0) {
        if (msgBox) {
          msgBox.className = 'mt-2 text-[11px] text-red-400 font-semibold';
          msgBox.innerHTML = `<i class="fa-solid fa-circle-xmark mr-1"></i> Nenhum veterano encontrado com "${busca}". Por favor, preencha o formulÃ¡rio acima para registrar-se e liberar a lista da sua Companhia.`;
          msgBox.classList.remove('hidden');
        }
        return;
      }

      const militar = encontrados[0];

      localStorage.setItem('veterano_inscrito_cia', militar.cia);
      localStorage.setItem('veterano_inscrito_nome', militar.nome);
      localStorage.setItem('veterano_inscrito_guerra', militar.guerra || militar.nome.split(' ')[0].toUpperCase());
      localStorage.setItem('veterano_inscrito_grad', militar.grad || 'Sd');
      localStorage.setItem('veterano_inscrito_ano', militar.ano || '');
      localStorage.setItem('veterano_inscrito_tel', militar.tel || '');
      localStorage.setItem('veterano_inscrito_cidade', militar.cidade || '');
      localStorage.setItem('veterano_inscrito_uf', militar.uf || 'Santa Catarina');

      sessionStorage.setItem('veterano_inscrito_cia', militar.cia);
      sessionStorage.setItem('veterano_inscrito_nome', militar.nome);
      sessionStorage.setItem('veterano_inscrito_ano', militar.ano || '');

      ciaAtivaMural = militar.cia;
      aplicarEstadoPermanenteVeteranoLocal();
      renderizarSoldadosCia();

      if (msgBox) {
        msgBox.className = 'mt-2 text-[11px] text-emerald-400 font-bold';
        msgBox.innerHTML = `<i class="fa-solid fa-circle-check mr-1"></i> Cadastro localizado: ${militar.nome} (${militar.cia}). Lista liberada!`;
        msgBox.classList.remove('hidden');
      }

      alert(`ðŸŽ–ï¸ CADASTRO LOCALIZADO COM SUCESSO!\n\nBem-vindo, ${(militar.grad || "Sd")} ${(militar.guerra || militar.nome)}!\n\nA lista dos soldados da ${militar.cia} foi liberada permanentemente neste aparelho.`);

      setTimeout(() => {
        const el = document.getElementById('areaMuralCadastro');
        if (el) el.scrollIntoView({ behavior: 'smooth' });
      }, 300);
    }

    window.addEventListener('DOMContentLoaded', () => {
      atualizarHeaderAdmin();
      atualizarVisibilidadeReservasAlmocoCadastro();
      aplicarEstadoPermanenteVeteranoLocal();
      carregarEfetivoGeral();
      aplicarEstadoPermanenteVeteranoLocal();
    });

    function encontrarMilitarExistente(lista, dados) {
      if (!lista || !Array.isArray(lista) || !dados) return null;

      const norm = (txt) => {
        if (!txt) return '';
        return txt.toString().toLowerCase()
          .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
          .replace(/[^a-z0-9]/g, '');
      };

      const digitos = (tel) => {
        if (!tel) return '';
        const d = tel.toString().replace(/\D/g, '');
        return d.length >= 8 ? d.slice(-8) : d;
      };

      const idNovo = dados.id;
      const nomeNovo = norm(dados.nome);
      const guerraNovo = norm(dados.guerra);
      const anoNovo = dados.ano ? String(dados.ano).trim() : '';
      const cpfNovo = dados.cpf ? String(dados.cpf).replace(/\D/g, '') : '';
      const telNovo = digitos(dados.tel || dados.telDial);

      for (let i = 0; i < lista.length; i++) {
        const item = lista[i];

        // 0. Match direto pelo mesmo ID numérico
        if (idNovo && item.id && String(idNovo) === String(item.id)) {
          return { militar: item, index: i, motivo: 'ID' };
        }

        // 1. Match por CPF (mínimo 9 dígitos)
        const cpfItem = item.cpf ? String(item.cpf).replace(/\D/g, '') : '';
        if (cpfNovo && cpfItem && cpfNovo.length >= 9 && cpfNovo === cpfItem) {
          return { militar: item, index: i, motivo: 'CPF' };
        }

        // 2. Match por Nome Completo normalizado idêntico
        const nomeItem = norm(item.nome);
        if (nomeNovo && nomeItem && nomeNovo === nomeItem) {
          return { militar: item, index: i, motivo: 'Nome Completo' };
        }

        // 3. Match por Telefone (últimos 8 dígitos) + Primeiro Nome ou Nome de Guerra
        const telItem = digitos(item.tel || item.telDial);
        if (telNovo && telItem && telNovo.length >= 8 && telNovo === telItem) {
          const guerraItem = norm(item.guerra);
          const primNovo = (dados.nome || '').trim().split(' ')[0].toLowerCase();
          const primItem = (item.nome || '').trim().split(' ')[0].toLowerCase();
          if ((guerraNovo && guerraItem && guerraNovo === guerraItem) || (primNovo && primItem && primNovo === primItem)) {
            return { militar: item, index: i, motivo: 'Telefone e Nome' };
          }
        }

        // 4. Match por Nome de Guerra + Ano de Incorporação (quando guerra tem pelo menos 4 letras)
        const guerraItem = norm(item.guerra);
        const anoItem = item.ano ? String(item.ano).trim() : '';
        if (guerraNovo && guerraItem && guerraNovo.length >= 4 && guerraNovo === guerraItem) {
          if (anoNovo && anoItem && anoNovo === anoItem) {
            return { militar: item, index: i, motivo: 'Guerra e Ano' };
          }
        }
      }

      return null;
    }

    
    // Auto-preenche o formulário ao digitar o nome ou nome de guerra se já constar no efetivo
    function autoPreencherCadastro(elDisparador) {
      const elNome = document.getElementById('nomeCompleto');
      const elGuerra = document.getElementById('nomeGuerra');
      const nomeDigitado = elNome ? elNome.value.trim() : '';
      const guerraDigitada = elGuerra ? elGuerra.value.trim() : '';

      const query = (elDisparador && elDisparador.id === 'nomeGuerra') ? guerraDigitada : (nomeDigitado || guerraDigitada);
      if (query.length < 3) return;

      const norm = (t) => t ? t.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').trim() : '';
      const qNorm = norm(query);

      let todos = (typeof efetivoTotal !== 'undefined' && Array.isArray(efetivoTotal)) ? efetivoTotal : [];
      if (todos.length === 0 && window.VETERANOS_DATA && Array.isArray(window.VETERANOS_DATA)) {
        todos = window.VETERANOS_DATA;
      }

      // Prioridade:
      // 1. Nome completo exato
      // 2. Início do nome (se query >= 4)
      // 3. Nome de guerra exato
      let achado = todos.find(v => norm(v.nome) === qNorm);
      if (!achado && qNorm.length >= 4) {
        achado = todos.find(v => norm(v.nome).startsWith(qNorm));
      }
      if (!achado) {
        achado = todos.find(v => v.guerra && norm(v.guerra) === qNorm);
      }

      if (achado) {
        if (elNome && (!elNome.value || qNorm.length >= 4)) elNome.value = achado.nome || elNome.value;
        if (elGuerra && achado.guerra) elGuerra.value = achado.guerra;
        if (achado.grad && document.getElementById('graduacao')) document.getElementById('graduacao').value = achado.grad;
        if (achado.cia && document.getElementById('companhia')) document.getElementById('companhia').value = achado.cia;
        if (achado.ano && document.getElementById('ano')) document.getElementById('ano').value = achado.ano;
        if (achado.tel && document.getElementById('whatsapp')) document.getElementById('whatsapp').value = achado.tel;
        if (achado.cidade && document.getElementById('cidade')) document.getElementById('cidade').value = achado.cidade;
        if (achado.uf && document.getElementById('uf')) document.getElementById('uf').value = achado.uf;
        if (achado.bairro && document.getElementById('bairro')) document.getElementById('bairro').value = achado.bairro;
        if (achado.rua && document.getElementById('rua')) document.getElementById('rua').value = achado.rua;

        const banner = document.getElementById('avisoAutoPreenchimentoCad');
        const txtBanner = document.getElementById('txtAvisoAutoPreenchimentoCad');
        if (banner && txtBanner) {
          txtBanner.innerHTML = `<strong>Cadastro localizado no efetivo!</strong> Dados de <strong>${achado.nome}</strong> (${achado.guerra || ''}) carregados automaticamente. Você pode atualizar qualquer dado antes de salvar.`;
          banner.classList.remove('hidden');
        }
      }
    }
    function carregarEfetivoGeral() {
      let base = [];
      if (window.VETERANOS_DATA && Array.isArray(window.VETERANOS_DATA)) {
        base = JSON.parse(JSON.stringify(window.VETERANOS_DATA));
      }
      let novos = [];
      try {
        const stored = localStorage.getItem('novos_veteranos_5be');
        if (stored) novos = JSON.parse(stored);
      } catch (e) { novos = []; }

      // Unifica atualizações e novos: se o veterano já existe, apenas atualiza as informações sem duplicar
      novos.forEach(n => {
        let indexBase = base.findIndex(b => b.id === n.id);
        if (indexBase === -1) {
          const m = encontrarMilitarExistente(base, n);
          if (m) indexBase = m.index;
        }

        if (indexBase !== -1) {
          Object.assign(base[indexBase], n, { isAtualizado: true, isNovo: true });
        } else {
          n.isNovo = true;
          base.unshift(n);
        }
      });
      efetivoTotal = base;
      renderizarSoldadosCia();
    }

    const MASCOTES_CIAS = {
      "1º Cia Eng Cmb Bld": {
        nome: "Leão",
        label: "1ª Cia Eng Cmb Bld",
        badge: "LEÃO",
        svg: "animal_leao.svg",
        emoji: "🦁",
        cor: "#f59e0b",
        bgTag: "bg-amber-950/90 text-amber-300 border border-amber-500/60"
      },
      "2º Cia Eng Cmb Bld": {
        nome: "Onça",
        label: "2ª Cia Eng Cmb Bld",
        badge: "ONÇA",
        svg: "animal_onca.svg",
        emoji: "🐆",
        cor: "#eab308",
        bgTag: "bg-yellow-950/90 text-yellow-300 border border-yellow-500/60"
      },
      "Cia Cmdo e Ap - (CCAp)": {
        nome: "Pantera",
        label: "Cia Cmdo e Ap (CCAp)",
        badge: "PANTERA",
        svg: "animal_pantera.svg",
        emoji: "🐾",
        cor: "#10b981",
        bgTag: "bg-emerald-950/90 text-emerald-300 border border-emerald-500/60"
      },
      "Cia Eng Pnt (CEP)": {
        nome: "Águia",
        label: "Cia Pontes (CEP)",
        badge: "ÁGUIA",
        svg: "animal_aguia.svg",
        emoji: "🦅",
        cor: "#38bdf8",
        bgTag: "bg-sky-950/90 text-sky-300 border border-sky-500/60"
      },
      "Estado Maior Geral e Especial": {
        nome: "Estado-Maior",
        label: "Estado-Maior",
        badge: "EM",
        icone: "fa-solid fa-star",
        emoji: "⭐",
        cor: "#c084fc",
        bgTag: "bg-purple-950/90 text-purple-300 border border-purple-500/60"
      },
      "NPOR": {
        nome: "NPOR",
        label: "NPOR",
        badge: "NPOR",
        icone: "fa-solid fa-graduation-cap",
        emoji: "🎓",
        cor: "#f472b6",
        bgTag: "bg-pink-950/90 text-pink-300 border border-pink-500/60"
      }
    };

    function normalizar(txt) {
      if (!txt) return '';
      return txt.replace(/º/g, 'ª').trim().toLowerCase();
    }

    function obterMascoteCia(cia) {
      if (!cia) return null;
      const n = normalizar(cia);
      for (const [key, val] of Object.entries(MASCOTES_CIAS)) {
        if (normalizar(key) === n) return val;
      }
      return null;
    }

    function montarBotoesCiasCadastro(ciaAtual) {
      const container = document.getElementById('botoesCiasCadastro');
      if (!container) return;
      container.innerHTML = '';

      const cias = [
        { id: "1º Cia Eng Cmb Bld", label: "1ª Cia", animal: "Leão", svg: "animal_leao.svg" },
        { id: "2º Cia Eng Cmb Bld", label: "2ª Cia", animal: "Onça", svg: "animal_onca.svg" },
        { id: "Cia Cmdo e Ap - (CCAp)", label: "CCAp", animal: "Pantera", svg: "animal_pantera.svg" },
        { id: "Cia Eng Pnt (CEP)", label: "CEP", animal: "Águia", svg: "animal_aguia.svg" },
        { id: "Estado Maior Geral e Especial", label: "Estado-Maior", icone: "fa-solid fa-star" },
        { id: "NPOR", label: "NPOR", icone: "fa-solid fa-graduation-cap" }
      ];

      cias.forEach(c => {
        const isActive = normalizar(c.id) === normalizar(ciaAtual);
        const count = efetivoTotal.filter(i => normalizar(i.cia) === normalizar(c.id)).length;

        const btn = document.createElement('button');
        btn.type = 'button';
        btn.onclick = () => {
          ciaAtivaMural = c.id;
          renderizarSoldadosCia();
        };

        btn.className = `group px-3 py-1.5 rounded-lg text-xs font-bold military-font uppercase flex items-center transition-all ${
          isActive 
            ? 'bg-amber-500 text-slate-950 font-extrabold shadow-md ring-2 ring-amber-300' 
            : 'bg-[#122115] text-slate-300 hover:bg-[#1a3320] border border-[#233f28]'
        }`;

        let imgHtml = '';
        if (c.svg) {
          imgHtml = `<img src="${c.svg}" alt="${c.animal}" class="w-5 h-5 mr-1.5 object-contain filter drop-shadow group-hover:scale-110 transition-transform">`;
        } else {
          imgHtml = `<i class="${c.icone} mr-1.5 text-xs ${isActive ? 'text-slate-950' : 'text-amber-400'}"></i>`;
        }

        btn.innerHTML = `
          ${imgHtml}
          <span>${c.label}</span>
          ${c.animal ? `<span class="ml-1 px-1.5 py-0.2 rounded text-[9px] font-black ${isActive ? 'bg-slate-950 text-amber-300' : 'bg-black/60 text-amber-400 border border-amber-500/30'}">${c.animal}</span>` : ''}
          ${ehMinhaCia ? `<span class="ml-1 px-1.5 py-0.2 rounded text-[9px] font-black ${isActive ? 'bg-black text-amber-300' : 'bg-amber-500 text-slate-950'}">SUA CIA</span>` : ''}
          <span class="ml-1.5 px-1.5 py-0.2 rounded-full text-[10px] font-mono ${isActive ? 'bg-amber-600/70 text-slate-950' : 'bg-emerald-950 text-emerald-400 border border-emerald-700/50'}">${count}</span>
        `;
        container.appendChild(btn);
      });
    }

    function renderizarSoldadosCia() {
      const bloqueado = document.getElementById('cardCadBloqueado');
      const liberado = document.getElementById('cardCadLiberado');
      const container = document.getElementById('listaSoldadosCia');
      if (!bloqueado || !liberado || !container) return;

      const isAdmin = verificarAdminLogado();
      const inscricaoCia = localStorage.getItem('veterano_inscrito_cia') || sessionStorage.getItem('veterano_inscrito_cia');
      const inscricaoNome = localStorage.getItem('veterano_inscrito_nome') || sessionStorage.getItem('veterano_inscrito_nome') || '';

      const isDesbloqueado = Boolean(inscricaoCia || isAdmin);

      if (!isDesbloqueado) {
        bloqueado.classList.remove('hidden');
        liberado.classList.add('hidden');
        return;
      }

      bloqueado.classList.add('hidden');
      liberado.classList.remove('hidden');

      const ciaAlvo = ciaAtivaMural || inscricaoCia || '1º Cia Eng Cmb Bld';
      
      const masc = obterMascoteCia(ciaAlvo);
      const tituloMural = document.getElementById('tituloCiaMural');
      if (tituloMural) {
        if (masc && masc.svg) {
          tituloMural.innerHTML = `
            <img src="${masc.svg}" alt="${masc.nome}" class="w-7 h-7 sm:w-8 sm:h-8 inline-block mr-2 object-contain filter drop-shadow">
            <span>${ciaAlvo}</span>
            <span class="ml-2 text-xs sm:text-sm px-2 py-0.5 rounded font-black uppercase ${masc.bgTag}">Mascote: ${masc.badge}</span>
          `;
        } else {
          tituloMural.innerText = ciaAlvo;
        }
      }
      montarBotoesCiasCadastro(ciaAlvo);

      let lista = efetivoTotal.filter(i => normalizar(i.cia) === normalizar(ciaAlvo));
      document.getElementById('qtdSoldadosCia').innerText = `${lista.length}`;

      // Se tiver ano do cadastro do veterano e o campo estiver vazio na primeira abertura, preenche
      const inputAno = document.getElementById('anoSoldadosLocal');
      const anoInscrito = localStorage.getItem('veterano_inscrito_ano') || sessionStorage.getItem('veterano_inscrito_ano');
      if (anoInscrito && inputAno && !inputAno.dataset.iniciado) {
        inputAno.value = anoInscrito;
        inputAno.dataset.iniciado = "true";
      }

      const busca = (document.getElementById('buscaSoldadosLocal')?.value || '').toLowerCase().trim();
      const anoFiltro = (inputAno?.value || '').trim();

      if (busca) {
        lista = lista.filter(i => 
          (i.nome && i.nome.toLowerCase().includes(busca)) ||
          (i.guerra && i.guerra.toLowerCase().includes(busca)) ||
          (i.cidade && i.cidade.toLowerCase().includes(busca))
        );
      }

      if (anoFiltro) {
        lista = lista.filter(i => i.ano && i.ano.toString() === anoFiltro);
      }

      // Atualiza faixa de status do ano puxado
      const txtStatus = document.getElementById('txtStatusAnoCad');
      const qtdStatus = document.getElementById('qtdStatusAnoCad');
      if (txtStatus && qtdStatus) {
        if (anoFiltro) {
          txtStatus.innerHTML = `<span class="text-amber-300 font-bold"><i class="fa-solid fa-calendar-check mr-1 text-emerald-400"></i> Turma de ${anoFiltro}:</span> Militares do ano <strong class="text-white">${anoFiltro}</strong> na <strong>${ciaAlvo}</strong>`;
          qtdStatus.innerText = `${lista.length} militar(es)`;
        } else {
          txtStatus.innerHTML = `<i class="fa-solid fa-users text-emerald-400 mr-1.5"></i> Exibindo todos os anos da <strong>${ciaAlvo}</strong>. Digite o ano para puxar sua turma.`;
          qtdStatus.innerText = `${lista.length} militares no total`;
        }
      }

      lista.sort((a, b) => {
        if (a.nome === inscricaoNome) return -1;
        if (b.nome === inscricaoNome) return 1;
        const anoA = parseInt(a.ano) || 0;
        const anoB = parseInt(b.ano) || 0;
        if (anoA !== anoB) return anoB - anoA;
        return (a.nome || '').localeCompare(b.nome || '');
      });

      container.innerHTML = '';

      if (lista.length === 0) {
        container.innerHTML = `<div class="col-span-full p-4 text-center text-slate-500 text-xs">Nenhum militar encontrado nesta subunidade.</div>`;
        return;
      }

      const telefonesLiberados = (localStorage.getItem('liberar_telefones_veteranos') === 'true') || isAdmin;

      lista.forEach(item => {
        const row = document.createElement('div');
        row.className = "p-2.5 bg-[#0e1710] rounded-lg border border-[#223925] flex items-center justify-between text-xs";
        
        row.innerHTML = `
          <div class="truncate mr-2">
            <div class="font-bold text-slate-200 truncate flex items-center space-x-1.5">
              <span class="text-[10px] px-1.5 py-0.2 bg-[#1a2e1d] text-emerald-400 rounded font-mono">${item.grad || 'Sd'}</span>
              <span class="truncate">${item.nome}</span>
            </div>
            <div class="text-[11px] text-amber-400 font-bold military-font uppercase">
              ${item.guerra || ""} • <span class="text-slate-400 font-normal font-sans">${item.cidade || ""}</span>
            </div>
            ${(() => {
              const st = (typeof obterStatusAlmocoMilitar === "function") ? obterStatusAlmocoMilitar(item) : null;
              if (st && st.vaiAlmoco && st.statusPagamento === "PAGO") {
                const q = st.qtdAlmocos || 1;
                return `
                  <div class="mt-1 flex items-center space-x-1">
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[9px] font-black uppercase bg-emerald-950 text-emerald-300 border border-emerald-500 shadow">
                      <i class="fa-solid fa-circle-check text-emerald-400 mr-1 text-[8px]"></i> ALMOÇO PAGO (${q} REF.)
                    </span>
                    ${st.entradaRealizada ? `
                      <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-mono font-bold bg-blue-950 text-blue-300 border border-blue-500/60 shadow">
                        <i class="fa-solid fa-check-double text-blue-400 mr-0.5"></i> ENTRADA OK
                      </span>
                    ` : ""}
                  </div>
                `;
              }
              return "";
            })()}
          </div>
          <div class="text-right flex-shrink-0">
            <span onclick="puxarAnoDiretoCad('${item.ano}')" class="cursor-pointer hover:bg-emerald-950 text-xs font-mono font-bold px-2 py-0.5 bg-[#060c07] text-emerald-400 border border-[#1e3823] rounded transition-all block" title="Clique para puxar todos deste ano">
              Ano: ${item.ano || '--'} <i class="fa-solid fa-filter text-[9px] ml-0.5 text-amber-400"></i>
            </span>
            ${telefonesLiberados && item.tel ? `
              <span class="text-[10px] text-slate-300 font-mono block mt-0.5">${item.tel}</span>
            ` : ''}
          </div>
        `;
        container.appendChild(row);
      });
    }

    function filtrarSoldadosLocal() {
      renderizarSoldadosCia();
    }

    function limparFiltroAnoCadastro() {
      const inputAno = document.getElementById('anoSoldadosLocal');
      if (inputAno) {
        inputAno.value = '';
        inputAno.dataset.iniciado = "true";
      }
      const inputBusca = document.getElementById('buscaSoldadosLocal');
      if (inputBusca) inputBusca.value = '';
      renderizarSoldadosCia();
    }

    function puxarAnoDiretoCad(ano) {
      if (!ano || ano === '--') return;
      const inputAno = document.getElementById('anoSoldadosLocal');
      if (inputAno) {
        inputAno.value = ano;
        inputAno.dataset.iniciado = "true";
        renderizarSoldadosCia();
        inputAno.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    }

    function mascaraTelefone(input) {
      let v = input.value.replace(/\D/g, '');
      if (v.length > 11) v = v.substring(0, 11);
      if (v.length > 6) {
        input.value = `(${v.substring(0, 2)}) ${v.substring(2, 7)}-${v.substring(7)}`;
      } else if (v.length > 2) {
        input.value = `(${v.substring(0, 2)}) ${v.substring(2)}`;
      } else {
        input.value = v;
      }
    }

    function mascaraCPF(input) {
      let v = input.value.replace(/\D/g, '');
      if (v.length > 11) v = v.substring(0, 11);
      if (v.length > 9) {
        input.value = `${v.substring(0, 3)}.${v.substring(3, 6)}.${v.substring(6, 9)}-${v.substring(9)}`;
      } else if (v.length > 6) {
        input.value = `${v.substring(0, 3)}.${v.substring(3, 6)}.${v.substring(6)}`;
      } else if (v.length > 3) {
        input.value = `${v.substring(0, 3)}.${v.substring(3)}`;
      } else {
        input.value = v;
      }
    }

    function salvarCadastro(event) {
      event.preventDefault();
      
      const dadosForm = {
        nome: document.getElementById('nomeCompleto').value.trim(),
        guerra: document.getElementById('nomeGuerra').value.trim().toUpperCase(),
        grad: document.getElementById('graduacao').value,
        cia: document.getElementById('companhia').value,
        ano: document.getElementById('anoIncorporacao').value.trim(),
        tel: document.getElementById('whatsapp').value.trim(),
        telDial: '55' + document.getElementById('whatsapp').value.replace(/\D/g, ''),
        email: document.getElementById('email').value.trim(),
        cpf: document.getElementById('cpf').value.trim(),
        cidade: document.getElementById('cidade').value.trim(),
        uf: document.getElementById('estado').value,
        bairro: document.getElementById('bairro').value.trim(),
        rua: document.getElementById('logradouro').value.trim()
      };

      let listaNovos = [];
      try {
        const stored = localStorage.getItem('novos_veteranos_5be');
        if (stored) listaNovos = JSON.parse(stored);
      } catch (e) { listaNovos = []; }

      // Verifica se o militar já existe no cadastro geral ou na lista de modificados
      const match = encontrarMilitarExistente(efetivoTotal, dadosForm);
      const isAtualizacao = Boolean(match);
      let registroFinal;

      if (isAtualizacao) {
        // Apenas atualiza as informações do militar existente mantendo seu ID original
        registroFinal = Object.assign({}, match.militar, dadosForm, {
          id: match.militar.id,
          dataAtualizacao: new Date().toLocaleDateString('pt-BR'),
          isAtualizado: true,
          isNovo: true
        });

        // Atualiza na lista de novos/modificados
        let idxNovo = listaNovos.findIndex(n => n.id === registroFinal.id);
        if (idxNovo === -1) {
          const mNovo = encontrarMilitarExistente(listaNovos, registroFinal);
          if (mNovo) idxNovo = mNovo.index;
        }

        if (idxNovo !== -1) {
          listaNovos[idxNovo] = registroFinal;
        } else {
          listaNovos.unshift(registroFinal);
        }
      } else {
        // Novo cadastro inédito
        registroFinal = Object.assign({}, dadosForm, {
          id: Date.now(),
          dataCadastro: new Date().toLocaleDateString('pt-BR'),
          isNovo: true
        });
        listaNovos.unshift(registroFinal);
      }

      localStorage.setItem('novos_veteranos_5be', JSON.stringify(listaNovos));

      // Grava PERMANENTEMENTE no localStorage para a lista ficar SEMPRE liberada
      localStorage.setItem('veterano_inscrito_cia', registroFinal.cia);
      localStorage.setItem('veterano_inscrito_nome', registroFinal.nome);
      localStorage.setItem('veterano_inscrito_guerra', registroFinal.guerra || '');
      localStorage.setItem('veterano_inscrito_grad', registroFinal.grad || 'Sd');
      localStorage.setItem('veterano_inscrito_ano', registroFinal.ano || '');
      localStorage.setItem('veterano_inscrito_tel', registroFinal.tel || '');
      localStorage.setItem('veterano_inscrito_cidade', registroFinal.cidade || '');
      localStorage.setItem('veterano_inscrito_uf', registroFinal.uf || 'Santa Catarina');
      localStorage.setItem('veterano_inscrito_rua', registroFinal.rua || '');
      localStorage.setItem('veterano_inscrito_bairro', registroFinal.bairro || '');
      localStorage.setItem('veterano_inscrito_data', new Date().toISOString());

      sessionStorage.setItem('veterano_inscrito_cia', registroFinal.cia);
      sessionStorage.setItem('veterano_inscrito_nome', registroFinal.nome);
      sessionStorage.setItem('veterano_inscrito_ano', registroFinal.ano);

      const inputAnoMural = document.getElementById('anoSoldadosLocal');
      if (inputAnoMural && registroFinal.ano) {
        inputAnoMural.value = registroFinal.ano;
      }
      ciaAtivaMural = registroFinal.cia;

      try {
        if (syncChannel) {
          syncChannel.postMessage({ 
            tipo: isAtualizacao ? 'ATUALIZACAO_CADASTRO' : 'NOVO_CADASTRO', 
            registro: registroFinal 
          });
        }
      } catch (e) {}

      carregarEfetivoGeral();
      aplicarEstadoPermanenteVeteranoLocal();

      const tituloMsg = isAtualizacao 
        ? `*ATUALIZAÇÃO DE CADASTRO DE VETERANO - 5º BE CMB BLD*`
        : `*INSCRIÇÃO OFICIAL DE VETERANO - 5º BE CMB BLD*`;
      const confirmacaoMsg = isAtualizacao
        ? `\n_Confirmo a atualização das minhas informações na Comissão dos Veteranos do 5º BE!_`
        : `\n_Confirmo minha inscrição na Comissão dos Veteranos do 5º BE!_`;

      const textoWhatsApp = encodeURIComponent(
        `${tituloMsg}\n\n` +
        `👤 *Nome:* ${registroFinal.nome} (${registroFinal.guerra})\n` +
        `🎖️ *Graduação:* ${registroFinal.grad}\n` +
        `🏢 *Companhia:* ${registroFinal.cia}\n` +
        `📅 *Ano que Serviu:* ${registroFinal.ano}\n` +
        `📱 *WhatsApp:* ${registroFinal.tel}\n` +
        `📍 *Cidade:* ${registroFinal.cidade} - ${registroFinal.uf}\n` +
        (registroFinal.rua ? `🏠 *Endereço:* ${registroFinal.rua}, ${registroFinal.bairro}\n` : '') +
        (registroFinal.email ? `✉️ *E-mail:* ${registroFinal.email}\n` : '') +
        confirmacaoMsg
      );

      const btnWhats = document.getElementById('btnEnviarWhatsApp');
      btnWhats.href = `https://api.whatsapp.com/send?phone=5542999033839&text=${textoWhatsApp}`;

            if (isAtualizacao) {
      alert(`⚠️ AVISO: O cadastro de ${registroFinal.nome} JÁ EXISTE no sistema!\n\nAs suas informações foram atualizadas com sucesso no Efetivo Geral.`);
      }

      const boxSucesso = document.getElementById('sucessoBox');
      if (boxSucesso) {
        boxSucesso.className = isAtualizacao
          ? "mt-6 p-6 bg-gradient-to-b from-amber-950/90 to-[#121c13] border-2 border-amber-500 rounded-xl text-center space-y-4 shadow-xl"
          : "mt-6 p-6 bg-emerald-950/80 border border-emerald-500 rounded-lg text-center space-y-4";
      }

      const tituloSucesso = document.getElementById('tituloSucessoCad');
      const descSucesso = document.getElementById('descSucessoCad');
      if (tituloSucesso) {
        tituloSucesso.innerHTML = isAtualizacao
          ? `<span class="text-amber-400 block text-xs tracking-widest font-black mb-1">⚠️ AVISO: CADASTRO JÁ EXISTE NO SISTEMA</span>O CADASTRO JÁ EXISTE! INFORMAÇÕES ATUALIZADAS`
          : "Inscrição Confirmada com Sucesso!";
        tituloSucesso.className = isAtualizacao 
          ? "text-2xl font-black text-amber-300 military-font uppercase"
          : "text-2xl font-bold text-emerald-300 military-font uppercase";
      }
      if (descSucesso) {
        descSucesso.innerHTML = isAtualizacao
          ? `Identificamos que o militar <strong>${registroFinal.nome}</strong> (${registroFinal.guerra}) já constava cadastrado na base do 5º BE. <strong class="text-amber-300">Suas informações foram atualizadas com sucesso</strong>! A lista dos soldados da sua Companhia foi liberada logo abaixo.`
          : `Seus dados foram integrados ao efetivo geral da Comissão dos Veteranos do 5º BE. A lista dos soldados da sua Companhia foi liberada logo abaixo!`;
      }

      document.getElementById('formCadastro').classList.add('hidden');
      document.getElementById('sucessoBox').classList.remove('hidden');

      setTimeout(() => {
        const el = document.getElementById('areaMuralCadastro');
        if (el) el.scrollIntoView({ behavior: 'smooth' });
      }, 300);
    }
    // ==========================================
    // CONTROLE DE LIBERAÇÃO DE RESERVAS DE ALMOÇO
    // ==========================================
    function obterStatusAlmocoMilitar(militar) {
      if (!militar) return null;
      let reservas = [];
      try {
        const s = localStorage.getItem('reservas_eventos_5be');
        if (s) reservas = JSON.parse(s);
      } catch(e) { reservas = []; }

      if (!reservas.length) return null;

      const telMilitar = (militar.tel || '').replace(/\D/g, '');
      if (telMilitar && telMilitar.length >= 8) {
        const porTel = reservas.find(r => {
          const t = (r.tel || '').replace(/\D/g, '');
          return t && (t === telMilitar || t.endsWith(telMilitar) || telMilitar.endsWith(t));
        });
        if (porTel) return porTel;
      }

      const norm = (s) => (s || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').trim();
      const nomeMilitar = norm(militar.nome);
      if (nomeMilitar.length >= 4) {
        const porNome = reservas.find(r => norm(r.nome) === nomeMilitar);
        if (porNome) return porNome;
      }

      const guerraMilitar = norm(militar.guerra);
      if (guerraMilitar.length >= 3 && militar.ano) {
        const porGuerra = reservas.find(r => 
          norm(r.guerra) === guerraMilitar && 
          r.ano && r.ano.toString() === militar.ano.toString()
        );
        if (porGuerra) return porGuerra;
      }

      return null;
    }

    function isReservasAlmocoLiberadas() {
      return localStorage.getItem('reservas_almoco_liberadas') === 'true';
    }

    function alternarLiberacaoReservasAlmoco() {
      const atual = isReservasAlmocoLiberadas();
      const novo = !atual;
      localStorage.setItem('reservas_almoco_liberadas', novo ? 'true' : 'false');

      try {
        const canal = new BroadcastChannel('veteranos_5be_sync');
        canal.postMessage({ tipo: 'STATUS_RESERVAS_ALMOCO_ALTERADO', liberado: novo });
      } catch(e) {}

      atualizarVisibilidadeReservasAlmocoCadastro();

      alert(novo 
        ? "🔓 Reservas do Almoço LIBERADAS com sucesso!\n\nO link para a Feijoada agora aparece na página inicial e no cadastro."
        : "🔒 Reservas do Almoço BLOQUEADAS!\n\nO link para a Feijoada foi ocultado da página inicial e do cadastro."
      );
    }

    function atualizarVisibilidadeReservasAlmocoCadastro() {
      const liberado = isReservasAlmocoLiberadas();
      const isAdmin = verificarAdminLogado();

      const cardAlmoco = document.getElementById('cardLinkAlmocoCadastro');
      const gridPortais = document.getElementById('gridPortaisCadastro');

      if (cardAlmoco) {
        if (liberado) {
          cardAlmoco.classList.remove('hidden');
          if (gridPortais) gridPortais.className = "grid grid-cols-1 sm:grid-cols-2 gap-2.5 pt-1";
        } else {
          cardAlmoco.classList.add('hidden');
          if (gridPortais) gridPortais.className = "grid grid-cols-1 gap-2.5 pt-1";
        }
      }

      const adminBanner = document.getElementById('adminBannerControleAlmocoCadastro');
      const txtStatus = document.getElementById('txtStatusAlmocoCadastro');
      const btnToggle = document.getElementById('btnToggleAlmocoCadastro');

      if (adminBanner) {
        if (isAdmin) {
          adminBanner.classList.remove('hidden');
          adminBanner.classList.add('flex');
          if (txtStatus && btnToggle) {
            if (liberado) {
              txtStatus.className = "text-xs font-bold military-font uppercase text-emerald-400";
              txtStatus.innerHTML = "🔓 Reservas de Almoço: <strong class='text-emerald-300'>LIBERADAS (Visível na Página Inicial)</strong>";
              btnToggle.className = "px-3 py-1.5 rounded-lg text-[11px] font-extrabold military-font uppercase transition-all shadow bg-red-950 hover:bg-red-900 text-red-300 border border-red-700/60";
              btnToggle.innerHTML = '<i class="fa-solid fa-lock mr-1"></i> Bloquear Reservas';
            } else {
              txtStatus.className = "text-xs font-bold military-font uppercase text-amber-400";
              txtStatus.innerHTML = "🔒 Reservas de Almoço: <strong class='text-amber-300'>BLOQUEADAS (Oculto na Página Inicial)</strong>";
              btnToggle.className = "px-3 py-1.5 rounded-lg text-[11px] font-extrabold military-font uppercase transition-all shadow bg-emerald-700 hover:bg-emerald-600 text-white";
              btnToggle.innerHTML = '<i class="fa-solid fa-unlock mr-1"></i> Liberar Reservas';
            }
          }
        } else {
          adminBanner.classList.add('hidden');
          adminBanner.classList.remove('flex');
        }
      }
    }

    // Inicialização e ouvintes
    window.addEventListener('DOMContentLoaded', () => {
      atualizarVisibilidadeReservasAlmocoCadastro();
    });

    try {
      const canalAlmocoCad = new BroadcastChannel('veteranos_5be_sync');
      canalAlmocoCad.addEventListener('message', (ev) => {
        if (ev.data && ev.data.tipo === 'STATUS_RESERVAS_ALMOCO_ALTERADO') {
          atualizarVisibilidadeReservasAlmocoCadastro();
          if (typeof renderizarSoldadosCia === "function") renderizarSoldadosCia();
        }
        if (ev.data && (ev.data.tipo === "STATUS_PAGAMENTO_ALTERADO" || ev.data.tipo === "ENTRADA_EVENTO_ATUALIZADA")) {
          if (typeof renderizarSoldadosCia === "function") renderizarSoldadosCia();
          atualizarVisibilidadeReservasAlmocoCadastro();
        }
      });
    } catch(e) {}

    window.addEventListener('storage', (e) => {
      if (e.key === 'reservas_almoco_liberadas') {
        atualizarVisibilidadeReservasAlmocoCadastro();
      }
    });
  </script>
</body>
</html>
